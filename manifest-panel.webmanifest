{
  "id": "/panel",
  "name": "STOCKA WMS",
  "short_name": "STOCKA WMS",
  "description": "Portal de gestión de inventario, pedidos, ingresos de stock y facturación en tiempo real de STOCKA Fulfillment.",
  "start_url": "/panel?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "es-CL",
  "dir": "ltr",
  "background_color": "#0b0f19",
  "theme_color": "#1800AD",
  "categories": ["business", "logistics", "productivity"],
  "icons": [
    {
      "src": "/img/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Pedidos",
      "short_name": "Pedidos",
      "description": "Revisar pedidos y despachos activos",
      "url": "/panel/pedidos",
      "icons": [{ "src": "/img/pwa/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Facturación",
      "short_name": "Facturación",
      "description": "Ver facturas y estados de pago",
      "url": "/panel/facturacion",
      "icons": [{ "src": "/img/pwa/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Tickets de Soporte",
      "short_name": "Tickets",
      "description": "Consultar y responder tickets",
      "url": "/panel/tickets",
      "icons": [{ "src": "/img/pwa/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Ingresos de Stock",
      "short_name": "Ingresos",
      "description": "Seguimiento de ingresos a bodega",
      "url": "/panel/ingresos",
      "icons": [{ "src": "/img/pwa/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
