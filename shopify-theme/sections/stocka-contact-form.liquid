<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = "{{ section.id }}";
    const form = document.getElementById('stocka-lead-form-' + sectionId);
    if (!form) return;

    // 1. Selector de Servicios (Multi-select)
    const servicesGroup = document.getElementById('stocka-services-group-' + sectionId);
    if (servicesGroup) {
      const pills = servicesGroup.querySelectorAll('.stocka-service-pill');
      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          pill.classList.toggle('active');
        });
      });
    }

    // 2. Selector de Volumen Mensual (Single-select)
    const volumeGroup = document.getElementById('stocka-volume-group-' + sectionId);
    if (volumeGroup) {
      const volumeBtns = volumeGroup.querySelectorAll('.stocka-pill-btn');
      volumeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          volumeBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
    }

    // 3. Selector de Almacenamiento m3 (Single-select)
    const storageGroup = document.getElementById('stocka-storage-group-' + sectionId);
    if (storageGroup) {
      const storageBtns = storageGroup.querySelectorAll('.stocka-pill-btn');
      storageBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          storageBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
    }

    // 4. Form Submission Handler
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const errorDiv = document.getElementById('stocka-form-error-' + sectionId);
      const submitBtn = document.getElementById('stocka-submit-btn-' + sectionId);
      const btnText = document.getElementById('stocka-btn-text-' + sectionId);
      const btnSpinner = document.getElementById('stocka-btn-spinner-' + sectionId);

      errorDiv.style.display = 'none';

      // Extraer datos
      const name = document.getElementById('lead-name-' + sectionId).value.trim();
      const email = document.getElementById('lead-email-' + sectionId).value.trim();
      const phone = document.getElementById('lead-phone-' + sectionId).value.trim();
      const companyName = document.getElementById('lead-company-' + sectionId).value.trim();
      const website = document.getElementById('lead-web-' + sectionId).value.trim();
      const notes = document.getElementById('lead-notes-' + sectionId).value.trim();

      // Servicios seleccionados
      const activeServices = Array.from(servicesGroup.querySelectorAll('.stocka-service-pill.active')).map(p => p.getAttribute('data-value'));
      if (activeServices.length === 0) {
        activeServices.push('Fulfillment 360');
      }

      // Volumen y Almacenamiento seleccionados
      const activeVolume = volumeGroup.querySelector('.stocka-pill-btn.active')?.getAttribute('data-value') || '0 - 100 pedidos';
      const activeStorage = storageGroup.querySelector('.stocka-pill-btn.active')?.getAttribute('data-value') || 'No lo sé aún';

      // Validaciones básicas
      if (!name || !email || !phone || !companyName) {
        errorDiv.textContent = 'Por favor completa todos los campos obligatorios (*) para continuar.';
        errorDiv.style.display = 'block';
        return;
      }

      // UI Loading state
      submitBtn.disabled = true;
      btnText.textContent = 'Enviando y preparando tu presentación...';
      btnSpinner.style.display = 'inline-block';

      try {
        const endpointUrl = 'https://ejtjfaucnxbikrwjwwdu.supabase.co/functions/v1/submit-lead';
        
        const response = await fetch(endpointUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            contactName: name,
            email: email,
            phone: phone,
            companyName: companyName,
            website: website,
            services: activeServices,
            monthlyVolume: activeVolume,
            storageSpace: activeStorage,
            notes: notes
          })
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.error || 'Ocurrió un error al enviar tu solicitud. Intenta nuevamente.');
        }

        // Éxito: ocultar form y mostrar pantalla de agradecimiento
        form.style.display = 'none';
        
        document.getElementById('success-lead-name-' + sectionId).textContent = name;
        document.getElementById('success-company-name-' + sectionId).textContent = companyName;
        document.getElementById('success-lead-email-' + sectionId).textContent = email;
        
        const successScreen = document.getElementById('stocka-lead-success-' + sectionId);
        successScreen.style.display = 'block';
        successScreen.scrollIntoView({ behavior: 'smooth', block: 'center' });

      } catch (err) {
        console.error('Error enviando formulario:', err);
        errorDiv.textContent = err.message || 'No se pudo enviar el formulario. Por favor contáctanos directamente a contacto@stocka.cl';
        errorDiv.style.display = 'block';
        submitBtn.disabled = false;
        btnText.textContent = 'Solicitar Propuesta y Recibir Presentación ';
        btnSpinner.style.display = 'none';
      }
    });
  });
</script>

