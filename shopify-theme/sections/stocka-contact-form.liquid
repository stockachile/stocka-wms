{%- comment -%}
  Stocka Lead Engine & Contact Form Section (Native OS 2.0)
  High-conversion, modern lead capture form with instant Brevo email presentation auto-responder.
{%- endcomment -%}

{%- assign settings = section.settings -%}
{% assign bg_color = section.settings.background_color %}
{% assign has_bg = false %}

{% unless bg_color == "rgba(0,0,0,0)" or bg_color == blank %}
    {% assign has_bg = true %}
{% endunless %}

{% capture container %}
    {{ section.settings.container }}
    {% if has_bg == false %} section-my {% else %} section-py {% endif %}
{% endcapture %}

<style>
  .stocka-lead-section {
    position: relative;
    overflow: hidden;
  }
  .stocka-lead-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.07), 0 0 0 1px rgba(0, 0, 0, 0.02);
    padding: 2.5rem;
    position: relative;
  }
  @media (max-width: 767px) {
    .stocka-lead-card {
      padding: 1.5rem 1.25rem;
      border-radius: 18px;
    }
  }
  .stocka-input {
    width: 100%;
    padding: 0.85rem 1.1rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    outline: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 0.95rem;
    color: #0f172a;
    background-color: #f8fafc;
    font-family: inherit;
  }
  .stocka-input:focus {
    background-color: #ffffff;
    border-color: #5c24ff;
    box-shadow: 0 0 0 4px rgba(92, 36, 255, 0.12);
  }
  .stocka-label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e293b;
  }
  .stocka-service-pill {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1rem;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    font-size: 0.88rem;
    font-weight: 600;
    color: #334155;
  }
  .stocka-service-pill:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
  }
  .stocka-service-pill.active {
    background: #f5f3ff;
    border-color: #5c24ff;
    color: #5c24ff;
    box-shadow: 0 2px 8px rgba(92, 36, 255, 0.1);
  }
  .stocka-pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.1rem;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: #475569;
    transition: all 0.2s ease;
    user-select: none;
  }
  .stocka-pill-btn:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
  }
  .stocka-pill-btn.active {
    background: #5c24ff;
    border-color: #5c24ff;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(92, 36, 255, 0.25);
  }
  .btn-submit-stocka {
    background: linear-gradient(135deg, #5c24ff 0%, #4314c7 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 1.05rem;
    padding: 1.1rem 2.5rem;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    transition: all 0.25s ease;
    box-shadow: 0 10px 25px -5px rgba(92, 36, 255, 0.4);
    width: 100%;
  }
  .btn-submit-stocka:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px rgba(92, 36, 255, 0.5);
    background: linear-gradient(135deg, #6d3bff 0%, #4d18e0 100%);
  }
  .btn-submit-stocka:active {
    transform: translateY(0);
  }
  .btn-submit-stocka:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }
  @keyframes spin-stocka {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .stocka-spinner {
    width: 20px;
    height: 20px;
    border: 2.5px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin-stocka 0.8s linear infinite;
  }

  /* ========================================================
     PREMIUM SAAS FORM INPUT STYLES
     ======================================================== */
  .stocka-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .stocka-input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: #94a3b8;
    pointer-events: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .stocka-input-icon svg {
    width: 18px;
    height: 18px;
  }
  .stocka-input-wrapper:focus-within .stocka-input-icon {
    color: #5c24ff;
  }
  .stocka-input.with-icon {
    padding-left: 42px;
  }
  .stocka-textarea-wrapper {
    position: relative;
    width: 100%;
  }
  .stocka-textarea-icon {
    position: absolute;
    left: 14px;
    top: 14px;
    width: 18px;
    height: 18px;
    color: #94a3b8;
    pointer-events: none;
    transition: color 0.2s ease;
  }
  .stocka-textarea-wrapper:focus-within .stocka-textarea-icon {
    color: #5c24ff;
  }
  .stocka-textarea.with-icon {
    padding-left: 42px;
    padding-top: 12px;
  }
  .stocka-step-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.98rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.85rem;
    font-family: inherit;
  }
  .stocka-step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: linear-gradient(135deg, #5c24ff 0%, #4338ca 100%);
    color: #ffffff;
    border-radius: 7px;
    font-size: 0.78rem;
    font-weight: 800;
  }
  .stocka-input {
    width: 100%;
    padding: 0.85rem 1.1rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    outline: none;
    transition: all 0.2s ease;
    font-size: 0.95rem;
    color: #0f172a;
    background-color: #f8fafc;
    font-family: inherit;
    box-sizing: border-box;
  }
  .stocka-input:hover {
    border-color: #cbd5e1;
    background-color: #ffffff;
  }
  .stocka-input:focus {
    background-color: #ffffff;
    border-color: #5c24ff;
    box-shadow: 0 0 0 4px rgba(92, 36, 255, 0.12);
  }

</style>

<section
  id="stocka-contact-form"
  class="stocka-lead-section relative {{ section.settings.custom_class }}"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="{{ container }} mx-auto px-4 py-8 md:py-16">
    <div class="max-w-4xl mx-auto">
      
      <!-- Section Header -->
      <div class="text-center mb-8 md:mb-12">
        {% if settings.subheading != blank %}
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(92, 36, 255, 0.08); color: #5c24ff; padding: 4px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.75rem;">
            <span>✨</span> {{ settings.subheading }}
          </div>
        {% endif %}
        
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 mb-3" style="font-family: inherit;">
          {{ settings.heading | default: "Te contactamos y enviamos nuestra propuesta" }}
        </h2>
        
        <p class="text-slate-600 text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
          {{ settings.description | default: "Ingresa tus datos y te enviaremos nuestra presentación oficial con tarifarios a tu correo. Nuestro equipo comercial se comunicará contigo a la brevedad." }}
        </p>
      </div>

      <!-- Main Interactive Lead Card -->
      <div class="stocka-lead-card">
        
        <!-- Form Container -->
        <form id="stocka-lead-form-{{ section.id }}" novalidate>
          
          <!-- SECCIÓN 1: Servicios de Interés -->
          <div class="mb-8">
            <label class="stocka-label" style="font-size: 0.92rem;">
              1. ¿Qué servicios te interesan para tu negocio? <span style="color: #ef4444;">*</span>
            </label>
            <p style="font-size: 0.78rem; color: #64748b; margin-top: -0.2rem; margin-bottom: 0.75rem;">
              El servicio Fulfillment 360 es la base para escalar tu ecommerce de forma 100% automatizada.
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3" id="stocka-services-group-{{ section.id }}">
              <div class="stocka-service-pill active" data-value="Fulfillment 360">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px; flex-shrink: 0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                <span>Fulfillment 360</span>
              </div>
              <div class="stocka-service-pill" data-value="Punto de Retiro">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px; flex-shrink: 0;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                <span>Punto de Retiro</span>
              </div>
              <div class="stocka-service-pill" data-value="Despachos Same Day RM">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px; flex-shrink: 0;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                <span>Same Day en RM</span>
              </div>
              <div class="stocka-service-pill" data-value="Envíos a todo Chile">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px; flex-shrink: 0;"><rect x="1" y="3" width="15" height="13" rx="2"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                <span>Envíos Todo Chile</span>
              </div>
              <div class="stocka-service-pill" data-value="Logística Inversa">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px; flex-shrink: 0;"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
                <span>Logística Inversa</span>
              </div>
              <div class="stocka-service-pill" data-value="Vitrinas en Sucursal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px; flex-shrink: 0;"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                <span>Vitrinas en Sucursal</span>
              </div>
            </div>
          </div>

          <!-- SECCIÓN 2: Estimación Operativa -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 p-5 rounded-2xl" style="background: #f8fafc; border: 1px solid #e2e8f0;">
            <!-- Volumen de Ventas -->
            <div>
              <label class="stocka-label">2. Cantidad de ventas mensuales (pedidos) <span style="color: #ef4444;">*</span></label>
              <div class="flex flex-wrap gap-2 mt-2" id="stocka-volume-group-{{ section.id }}">
                <div class="stocka-pill-btn active" data-value="0 - 100 pedidos">0 - 100</div>
                <div class="stocka-pill-btn" data-value="100 - 500 pedidos">100 - 500</div>
                <div class="stocka-pill-btn" data-value="500 - 1.000 pedidos">500 - 1.000</div>
                <div class="stocka-pill-btn" data-value="Más de 1.000 pedidos">1.000+</div>
              </div>
            </div>

            <!-- Espacio de Almacenamiento -->
            <div>
              <label class="stocka-label">3. Espacio estimado de almacenamiento</label>
              <div class="flex flex-wrap gap-2 mt-2" id="stocka-storage-group-{{ section.id }}">
                <div class="stocka-pill-btn active" data-value="No lo sé aún">No lo sé aún</div>
                <div class="stocka-pill-btn" data-value="Menos de 1 m3">&lt; 1 m³</div>
                <div class="stocka-pill-btn" data-value="1 - 4 m3">1 - 4 m³</div>
                <div class="stocka-pill-btn" data-value="5 - 10 m3">5 - 10 m³</div>
                <div class="stocka-pill-btn" data-value="Más de 10 m3">10+ m³</div>
              </div>
            </div>
          </div>

          <!-- SECCIÓN 3: Datos de Contacto -->
          <div class="mb-6" style="margin-top: 1.75rem;">
            <div class="stocka-step-badge">
              <span class="stocka-step-num">4</span>
              <span>Tus datos de contacto y de tu tienda</span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
              <!-- Nombre -->
              <div>
                <label for="lead-name-{{ section.id }}" class="stocka-label">Tu Nombre <span style="color: #ef4444;">*</span></label>
                <div class="stocka-input-wrapper">
                  <div class="stocka-input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                  </div>
                  <input 
                    type="text" 
                    id="lead-name-{{ section.id }}" 
                    class="stocka-input with-icon" 
                    placeholder="Ej: Felipe Trujillo" 
                    required
                  >
                </div>
              </div>

              <!-- Correo -->
              <div>
                <label for="lead-email-{{ section.id }}" class="stocka-label">Correo Electrónico <span style="color: #ef4444;">*</span></label>
                <div class="stocka-input-wrapper">
                  <div class="stocka-input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                  </div>
                  <input 
                    type="email" 
                    id="lead-email-{{ section.id }}" 
                    class="stocka-input with-icon" 
                    placeholder="felipe@mitienda.cl" 
                    required
                  >
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
              <!-- Teléfono -->
              <div>
                <label for="lead-phone-{{ section.id }}" class="stocka-label">Teléfono / WhatsApp <span style="color: #ef4444;">*</span></label>
                <div class="stocka-input-wrapper">
                  <div class="stocka-input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                  </div>
                  <input 
                    type="tel" 
                    id="lead-phone-{{ section.id }}" 
                    class="stocka-input with-icon" 
                    placeholder="+56 9 8765 4321" 
                    required
                  >
                </div>
              </div>

              <!-- Nombre del Comercio -->
              <div>
                <label for="lead-company-{{ section.id }}" class="stocka-label">Nombre de tu Tienda <span style="color: #ef4444;">*</span></label>
                <div class="stocka-input-wrapper">
                  <div class="stocka-input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                  </div>
                  <input 
                    type="text" 
                    id="lead-company-{{ section.id }}" 
                    class="stocka-input with-icon" 
                    placeholder="Ej: Stocka Store" 
                    required
                  >
                </div>
              </div>

              <!-- Web / Instagram -->
              <div>
                <label for="lead-web-{{ section.id }}" class="stocka-label">Sitio Web o Instagram</label>
                <div class="stocka-input-wrapper">
                  <div class="stocka-input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                  </div>
                  <input 
                    type="text" 
                    id="lead-web-{{ section.id }}" 
                    class="stocka-input with-icon" 
                    placeholder="www.mitienda.cl o @mitienda"
                  >
                </div>
              </div>
            </div>

            <!-- Comentarios Adicionales -->
            <div class="mb-4" style="margin-top: 1rem;">
              <label for="lead-notes-{{ section.id }}" class="stocka-label">Cuéntanos un poco más de tu comercio</label>
              <div class="stocka-textarea-wrapper">
                <div class="stocka-textarea-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                </div>
                <textarea 
                  id="lead-notes-{{ section.id }}" 
                  class="stocka-input stocka-textarea with-icon" 
                  rows="3" 
                  placeholder="Háblanos de tus productos, integraciones necesarias o requerimientos especiales de almacenamiento..."
                ></textarea>
              </div>
            </div>
          </div>

          <!-- Mensaje de Error (Oculto por defecto) -->
          <div id="stocka-form-error-{{ section.id }}" style="display: none; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 0.85rem 1rem; border-radius: 10px; font-size: 0.85rem; margin-bottom: 1rem; font-weight: 600;"></div>

          <!-- Submit Button -->
          <div class="text-center pt-2">
            <button type="submit" id="stocka-submit-btn-{{ section.id }}" class="btn-submit-stocka">
              <span id="stocka-btn-text-{{ section.id }}">Solicitar Propuesta y Recibir Presentación </span>
              <div id="stocka-btn-spinner-{{ section.id }}" class="stocka-spinner" style="display: none;"></div>
            </button>
            
            <p style="font-size: 0.76rem; color: #64748b; margin-top: 0.85rem;">
              🔒 Tus datos están 100% seguros. Te enviaremos la presentación y tarifario oficial en PDF al instante.
            </p>
          </div>

        </form>

        <!-- Success Message Screen (Oculto por defecto) -->
        <div id="stocka-lead-success-{{ section.id }}" style="display: none; text-align: center; padding: 2.5rem 1rem;">
          <div style="width: 72px; height: 72px; background: #ecfdf5; border: 2px solid #10b981; border-radius: 50%; color: #10b981; display: inline-flex; align-items: center; justify-content: center; font-size: 2.2rem; margin-bottom: 1.25rem;">
            ✓
          </div>
          
          <h3 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">
            ¡Solicitud Recibida con Éxito! 
          </h3>
          
          <p style="font-size: 0.95rem; color: #475569; max-width: 520px; margin: 0 auto 1.5rem auto; line-height: 1.6;">
            Muchas gracias <strong id="success-lead-name-{{ section.id }}" style="color: #5c24ff;"></strong>. Hemos recibido los datos de <strong id="success-company-name-{{ section.id }}"></strong> y te hemos enviado la <strong>Presentación Oficial de Fulfillment 360 y Tarifarios</strong> en PDF a tu correo.
          </p>

          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.5rem; max-width: 520px; margin: 0 auto 2rem auto; text-align: left;">
            <div style="font-size: 0.85rem; font-weight: 700; color: #1e293b; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
              <span>📬</span> Revisa tu bandeja de entrada
            </div>
            <p style="font-size: 0.8rem; color: #64748b; margin: 0; line-height: 1.5;">
              Enviamos el correo a <strong id="success-lead-email-{{ section.id }}" style="color: #0f172a;"></strong> con todos los documentos adjuntos y el enlace para agendar una reunión 1 a 1 vía Google Meet con Felipe Trujillo.
            </p>
          </div>

          <div style="display: flex; flex-direction: column; sm:flex-row; gap: 0.75rem; justify-content: center; max-width: 480px; margin: 0 auto;">
            <a 
              href="https://wa.me/56939247487?text=Hola!%20Acabo%20de%20solicitar%20informaci%C3%B3n%20en%20Stocka.cl%20y%20me%20gustar%C3%ADa%20conversar%20sobre%20fulfillment" 
              target="_blank" 
              style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; background: #25d366; color: #ffffff; padding: 0.9rem 1.5rem; border-radius: 12px; font-weight: 700; font-size: 0.95rem; text-decoration: none; box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);"
            >
