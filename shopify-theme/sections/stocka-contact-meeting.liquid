{%- comment -%}
  Stocka Contact Meeting & Location Section
  Combines the HubSpot Meeting Scheduler with Headquarters Info and Google Maps Embed.
{%- endcomment -%}

{%- assign settings = section.settings -%}

<style>
  .stocka-cml-section-{{ section.id }} {
    background-color: {{ settings.bg_color | default: "#f8fafc" }};
    padding: 4rem 1rem;
  }
  @media (min-width: 1024px) {
    .stocka-cml-section-{{ section.id }} {
      padding: 6rem 2rem;
    }
  }

  .stocka-cml-container-{{ section.id }} {
    max-width: 1240px;
    margin: 0 auto;
  }

  .stocka-cml-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: flex-start;
  }
  @media (min-width: 1024px) {
    .stocka-cml-grid-{{ section.id }} {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3.5rem;
    }
  }

  .stocka-cml-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
    height: 100%;
  }
  @media (max-width: 767px) {
    .stocka-cml-card {
      padding: 1.5rem 1.25rem;
      border-radius: 18px;
    }
  }

  .stocka-cml-card-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .stocka-cml-card-subtitle {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .stocka-cml-iframe-wrap {
    min-height: 620px;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #ffffff;
  }
  .stocka-cml-bf-notice {
    background: linear-gradient(135deg, #0f172a 0%, #1c1545 60%, #0f172a 100%);
    color: #f8fafc;
    border: 1px solid rgba(139, 92, 246, 0.35);
    border-radius: 16px;
    padding: 1.15rem 1.25rem;
    margin-bottom: 1.25rem;
    position: relative;
    overflow: hidden;
  }
  .stocka-cml-bf-notice::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #5c24ff 0%, #3b82f6 55%, #06d6a0 100%);
  }
  .stocka-cml-bf-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.22rem 0.65rem;
    border-radius: 9999px;
    background: rgba(92, 36, 255, 0.28);
    border: 1px solid rgba(167, 139, 250, 0.45);
    color: #ede9fe;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.55rem;
  }
  .stocka-cml-bf-title {
    font-size: 0.98rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.35rem 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .stocka-cml-bf-text {
    font-size: 0.83rem;
    color: #cbd5e1;
    line-height: 1.55;
    margin: 0 0 0.85rem 0;
  }
  .stocka-cml-bf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .stocka-cml-bf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none !important;
    transition: all 0.2s ease;
  }
  .stocka-cml-bf-btn-primary {
    background: #5c24ff;
    color: #ffffff !important;
  }
  .stocka-cml-bf-btn-primary:hover {
    background: #6d3aff;
    transform: translateY(-1px);
  }
  .stocka-cml-bf-btn-ghost {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #f8fafc !important;
  }
  .stocka-cml-bf-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  /* Location Details */
  .stocka-cml-loc-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 16px;
    margin-bottom: 1.5rem;
  }

  .stocka-cml-info-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .stocka-cml-info-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #f1f5f9;
    color: #5c24ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .stocka-cml-info-content strong {
    display: block;
    font-size: 0.95rem;
    color: #0f172a;
    margin-bottom: 0.2rem;
  }
  .stocka-cml-info-content p {
    margin: 0;
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.5;
  }

  .stocka-cml-map-container {
    margin-top: 1.5rem;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    height: 240px;
  }
  .stocka-cml-map-container iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>

<section id="stocka-meeting-section" class="stocka-cml-section-{{ section.id }} {{ settings.custom_class }}">
  <div class="stocka-cml-container-{{ section.id }}">
    
    <div class="stocka-cml-grid-{{ section.id }}">
      
      <!-- Left Column: HubSpot Meeting Scheduler -->
      <div class="stocka-cml-card">
        <div class="stocka-cml-card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 22px; height: 22px; color: #5c24ff; flex-shrink: 0;"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
          <span>Agenda una reunión Virtual</span>
        </div>
        <p class="stocka-cml-card-subtitle">
          Elige directamente en nuestro calendario un horario disponible para una videollamada 1 a 1 de 20 a 30 minutos vía Google Meet.
        </p>

        {%- if settings.show_agenda_notice != false -%}
          <div class="stocka-cml-bf-notice" role="status">
            <div class="stocka-cml-bf-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="width: 12px; height: 12px; color: #06d6a0;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <span>{{ settings.agenda_notice_badge | default: "BLACK FRIDAY · AGENDA PAUSADA" }}</span>
            </div>
            <h4 class="stocka-cml-bf-title">
              {{ settings.agenda_notice_title | default: "Agenda para información de servicio cerrada hasta el 9/12" }}
            </h4>
            <p class="stocka-cml-bf-text">
              {{ settings.agenda_notice_text | default: "Estamos 100% enfocados en la operación de Black Friday para nuestros clientes. Puedes revisar horarios disponibles a partir del 9 de diciembre, simular tus costos ahora mismo en el Cotizador Online o escribirnos por WhatsApp." }}
            </p>
            <div class="stocka-cml-bf-actions">
              <a href="/pages/cotizador" class="stocka-cml-bf-btn stocka-cml-bf-btn-primary">
                <span>Simular en Cotizador Online</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="width: 14px; height: 14px;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
              <a href="https://wa.me/56939247487?text=Hola!%20Quisiera%20recibir%20informaci%C3%B3n%20de%20servicio%20de%20fulfillment%20en%20Stocka.cl" target="_blank" rel="noopener" class="stocka-cml-bf-btn stocka-cml-bf-btn-ghost">
                <span>Escribir por WhatsApp</span>
              </a>
            </div>
          </div>
        {%- endif -%}

        <div class="stocka-cml-iframe-wrap">
          <!-- HubSpot Meetings Embed -->
          <div class="meetings-iframe-container" data-src="https://meetings.hubspot.com/stocka?embed=true"></div>
          <script type="text/javascript" src="https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js"></script>
        </div>
      </div>

      <!-- Right Column: Location & Google Maps -->
      <div class="stocka-cml-card" id="stocka-location-map">
        
        <img 
          src="{{ 'stocka-bot-dispatch.jpg' | asset_url }}" 
          alt="Stocka Centro Logístico Ñuñoa" 
          class="stocka-cml-loc-img"
          loading="lazy"
        >

        <div class="stocka-cml-card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 22px; height: 22px; color: #5c24ff; flex-shrink: 0;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Nuestra Casa Matriz & Bodega</span>
        </div>
        <p class="stocka-cml-card-subtitle">
          Contamos con ubicación física estratégica en el corazón de Santiago para retiro presencial y distribución veloz.
        </p>

        <!-- Dirección -->
        <div class="stocka-cml-info-row">
          <div class="stocka-cml-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px;"><path d="M3 21h18M3 7v14M21 7v14M6 3h12a1 1 0 0 1 1 1v3H5V4a1 1 0 0 1 1-1zM9 10h1m4 0h1m-6 4h1m4 0h1m-6 4h1m4 0h1"></path></svg></div>
          <div class="stocka-cml-info-content">
            <strong>Dirección Central</strong>
            <p>Avenida Campos de Deportes 405, Ñuñoa, Región Metropolitana, Chile.</p>
          </div>
        </div>

        <!-- Conectividad -->
        <div class="stocka-cml-info-row">
          <div class="stocka-cml-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px;"><rect x="4" y="3" width="16" height="16" rx="2"></rect><path d="M4 11h16M12 3v8M8 15h.01M16 15h.01M8 19l-2 3M16 19l2 3"></path></svg></div>
          <div class="stocka-cml-info-content">
            <strong>Conectividad y Metro</strong>
            <p>A pasos de estaciones de Metro Estadio Nacional (L6) y Monseñor Eyzaguirre / Ñuñoa (L3).</p>
          </div>
        </div>

        <!-- Horarios -->
        <div class="stocka-cml-info-row">
          <div class="stocka-cml-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
          <div class="stocka-cml-info-content">
            <strong>Horario de Operaciones</strong>
            <p>Lunes a Viernes: 10:30 a 14:00 hrs y 15:00 a 17:00 hrs • Sábados: 10:30 a 14:00 hrs.</p>
          </div>
        </div>

        <!-- Interactive Google Map -->
        <div class="stocka-cml-map-container">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1025.0461639403695!2d-70.61047503034712!3d-33.45734999833666!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662cf8d88374f2d%3A0xcda8463b1a73438b!2sAv.%20Campos%20de%20Deportes%20405%2C%207750207%20%C3%91u%C3%B1oa%2C%20Regi%C3%B3n%20Metropolitana!5e1!3m2!1ses!2scl!4v1724464891182!5m2!1ses!2scl" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación Stocka Chile"
          ></iframe>
        </div>

      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Stocka Meeting & Location",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de Fondo",
      "default": "#f8fafc"
    },
    {
      "type": "checkbox",
      "id": "show_agenda_notice",
      "label": "Mostrar aviso de agenda cerrada (Black Friday)",
      "default": true
    },
    {
      "type": "text",
      "id": "agenda_notice_badge",
      "label": "Etiqueta del aviso",
      "default": "BLACK FRIDAY · AGENDA PAUSADA"
    },
    {
      "type": "text",
      "id": "agenda_notice_title",
      "label": "Título del aviso",
      "default": "Agenda para información de servicio cerrada hasta el 9/12"
    },
    {
      "type": "textarea",
      "id": "agenda_notice_text",
      "label": "Texto del aviso",
      "default": "Estamos 100% enfocados en la operación de Black Friday para nuestros clientes. Puedes revisar horarios disponibles a partir del 9 de diciembre, simular tus costos ahora mismo en el Cotizador Online o escribirnos por WhatsApp."
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Clase CSS personalizada"
    }
  ],
  "presets": [
    {
      "name": "Stocka Meeting & Location"
    }
  ]
}
{% endschema %}
