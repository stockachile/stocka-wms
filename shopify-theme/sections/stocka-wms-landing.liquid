<script>
  (function() {
    function initWmsPage() {
      // 0. Hero Live Order Switcher Logic
      const orderPills = document.querySelectorAll('.stocka-wms-order-pill-btn');
      const orderData = {
        '8644': {
          platformLogo: "{{ 'stocka-int-shopify.png' | asset_url }}",
          platform: 'Shopify Store',
          id: '#8644',
          total: '$72.990 CLP',
          status: 'En Preparación',
          shipping: 'Chilexpress Prioritario',
          units: '1 Bulto • 1 Artículo',
          sla: 'Hoy antes 18:00',
          courierTag: 'Chilexpress Express',
          itemsCount: '1 SKU VALIDADO',
          items: [
            { name: '✓ Máscara Total Restore (pomo) - 200 ml', qty: '1 un.' }
          ]
        },
        '8640': {
          platformLogo: "{{ 'stocka-int-mercadolibre.png' | asset_url }}",
          platform: 'Mercado Libre Flex',
          id: '#8640',
          total: '$31.560 CLP',
          status: 'En Preparación',
          shipping: 'Blue Express Prioritario',
          units: '1 Bulto • 4 Artículos',
          sla: 'Mismo Día (Flex)',
          courierTag: 'Blue Express Flex',
          itemsCount: '2 SKUs VALIDADOS (4 UN.)',
          items: [
            { name: '✓ Serum Hidratante Reparador 50ml', qty: '2 un.' },
            { name: '✓ Shampoo Detox Purificante 250ml', qty: '2 un.' }
          ]
        },
        '8642': {
          platformLogo: "{{ 'stocka-int-shopify.png' | asset_url }}",
          platform: 'Shopify / Web Directa',
          id: '#8642',
          total: '$16.990 CLP',
          status: 'En Preparación',
          shipping: 'Starken Envío a Domicilio',
          units: '1 Bulto • 1 Artículo',
          sla: 'En Tránsito 24h',
          courierTag: 'Starken Domicilio',
          itemsCount: '1 SKU VALIDADO',
          items: [
            { name: '✓ Acondicionador Reparador Profundo', qty: '1 un.' }
          ]
        }
      };

      orderPills.forEach(pill => {
        pill.addEventListener('click', () => {
          const orderId = pill.getAttribute('data-order');
          const data = orderData[orderId];
          if (!data) return;

          orderPills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');

          const detailBox = document.getElementById('wms-order-detail-box');
          if (detailBox) {
            detailBox.style.opacity = '0.35';
            detailBox.style.transform = 'translateY(3px)';
          }

          setTimeout(() => {
            const logoEl = document.getElementById('wms-platform-logo');
            if (logoEl) logoEl.src = data.platformLogo;
            const platName = document.getElementById('wms-platform-name');
            if (platName) platName.textContent = data.platform;
            const orderIdEl = document.getElementById('wms-order-id-label');
            if (orderIdEl) orderIdEl.textContent = data.id;
            const totalVal = document.getElementById('wms-order-total-val');
            if (totalVal) totalVal.textContent = data.total;
            const statusVal = document.getElementById('wms-order-status-val');
            if (statusVal) statusVal.textContent = data.status;
            const shipVal = document.getElementById('wms-order-shipping-val');
            if (shipVal) shipVal.textContent = data.shipping;
            const unitsVal = document.getElementById('wms-order-units-val');
            if (unitsVal) unitsVal.textContent = data.units;
            const slaVal = document.getElementById('wms-order-sla-val');
            if (slaVal) slaVal.textContent = data.sla;
            const courierTag = document.getElementById('wms-stage-courier-tag');
            if (courierTag) courierTag.textContent = data.courierTag;
            const countBadge = document.getElementById('wms-items-count-badge');
            if (countBadge) countBadge.textContent = data.itemsCount;

            const listContainer = document.getElementById('wms-items-list-container');
            if (listContainer) {
              listContainer.innerHTML = data.items.map(it => `
                <li class="item-entry">
                  <span class="item-entry-name">${it.name}</span>
                  <span class="item-entry-qty">${it.qty}</span>
                </li>
              `).join('');
            }

            if (detailBox) {
              detailBox.style.opacity = '1';
              detailBox.style.transform = 'translateY(0)';
            }
          }, 140);
        });
      });

      // 1. Modules Tabs Logic
      const tabs = document.querySelectorAll('#stocka-wms-tabs-nav .stocka-wms-tab-btn');
      const panels = document.querySelectorAll('.stocka-wms-panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const targetId = tab.dataset.target;
          tabs.forEach(t => t.classList.remove('active'));
          panels.forEach(p => p.classList.remove('active'));

          tab.classList.add('active');
          const activePanel = document.getElementById(targetId);
          if (activePanel) activePanel.classList.add('active');
        });
      });

      // 2. FAQ Accordion Logic
      const faqItems = document.querySelectorAll('#stocka-wms-faq .stocka-wms-faq-item');
      faqItems.forEach(item => {
        const qBtn = item.querySelector('.stocka-wms-faq-q');
        if (qBtn) {
          qBtn.addEventListener('click', () => {
            const wasActive = item.classList.contains('active');
            item.classList.toggle('active', !wasActive);
          });
        }
      });

      // 3. Lead Form Submission
      const leadForm = document.getElementById('stocka-wms-lead-form');
      const msgDiv = document.getElementById('wms-form-msg');
      const submitBtn = document.getElementById('wms-form-submit-btn');

      if (leadForm) {
        leadForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>Enviando solicitud... ⏳</span>';

          const need = document.getElementById('wms-form-need')?.value || '';
          const name = document.getElementById('wms-form-name')?.value || '';
          const phone = document.getElementById('wms-form-phone')?.value || '';
          const email = document.getElementById('wms-form-email')?.value || '';
          const company = document.getElementById('wms-form-company')?.value || '';
          const volume = document.getElementById('wms-form-volume')?.value || '';
          const notes = document.getElementById('wms-form-notes')?.value || '';

          const payload = {
            contactName: name,
            email: email,
            phone: phone,
            companyName: company,
            services: ['WMS Software', need],
            monthlyVolume: volume,
            notes: `Tipo de Solicitud: ${need} | Detalle: ${notes || 'Sin comentarios'}`
          };

          try {
            const res = await fetch('https://ejtjfaucnxbikrwjwwdu.supabase.co/functions/v1/submit-lead', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            if (!res.ok) throw new Error('Error al enviar');

            msgDiv.style.background = '#ecfdf5';
            msgDiv.style.color = '#059669';
            msgDiv.style.border = '1.5px solid #a7f3d0';
            msgDiv.innerHTML = '🎉 ¡Solicitud recibida con éxito! Un asesor técnico se contactará contigo a la brevedad.';
            msgDiv.style.display = 'block';
            leadForm.reset();
            submitBtn.innerHTML = '<span>Solicitud Enviada ✓</span>';

          } catch (err) {
            // Fallback to WhatsApp direct link if API fails
            msgDiv.style.background = '#fef2f2';
            msgDiv.style.color = '#991b1b';
            msgDiv.style.border = '1.5px solid #fecaca';
            msgDiv.innerHTML = 'Nota enviada. Puedes hablarnos directamente por <a href="https://wa.me/56939247487?text=' + encodeURIComponent('Hola! Quiero una demo de Stocka WMS para ' + company) + '" target="_blank" style="color: #5c24ff; text-decoration: underline;">WhatsApp aquí</a>.';
            msgDiv.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Reintentar Enviar</span>';
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWmsPage);
    } else {
      initWmsPage();
    }
  })();
</script>

