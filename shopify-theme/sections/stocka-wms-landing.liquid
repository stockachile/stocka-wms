{%- comment -%}
  Stocka WMS & Logistics SaaS Dedicated Landing Page
  Showcases proprietary cloud technology, 5 core modules with real screenshot showcases,
  dual business model (Fulfillment 360 included vs Standalone SaaS for own warehouses),
  integrations ecosystem and interactive demo request.
{%- endcomment -%}

<style>
  :root {
    --wms-primary: #5c24ff;
    --wms-primary-light: #7c4dff;
    --wms-primary-dark: #4314c7;
    --wms-accent: #06d6a0;
    --wms-bg-dark: #0a0e1a;
    --wms-card-dark: #121829;
    --wms-border-dark: #1e293b;
    --wms-text-main: #f8fafc;
    --wms-text-muted: #94a3b8;
  }

  .stocka-wms-wrapper {
    font-family: inherit;
    color: #0f172a;
    background: #ffffff;
    overflow-x: hidden;
  }

  .stocka-wms-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
    box-sizing: border-box;
  }
  @media (min-width: 1024px) {
    .stocka-wms-container {
      padding: 0 2rem;
    }
  }

  /* ========================================================
     1. HERO SECTION (Dark SaaS Glow)
     ======================================================== */
  .stocka-wms-hero {
    background: radial-gradient(circle at 50% -20%, rgba(92, 36, 255, 0.35) 0%, rgba(10, 14, 26, 0.98) 70%, #0a0e1a 100%);
    color: #ffffff;
    padding: 5rem 0 4.5rem 0;
    position: relative;
    border-bottom: 1px solid #1e293b;
  }
  .stocka-wms-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(92, 36, 255, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .stocka-wms-hero-badge svg {
    color: #06d6a0;
    filter: drop-shadow(0 0 6px rgba(6, 214, 160, 0.7));
  }
  .stocka-wms-hero-title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    max-width: 900px;
    margin: 0 auto 1.25rem auto;
    text-align: center;
  }
  @media (min-width: 768px) {
    .stocka-wms-hero-title {
      font-size: 3.25rem;
    }
  }
  .stocka-wms-hero-title span {
    background: linear-gradient(135deg, #a78bfa 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .stocka-wms-hero-desc {
    font-size: 1.05rem;
    color: #94a3b8;
    max-width: 740px;
    margin: 0 auto 2.25rem auto;
    text-align: center;
    line-height: 1.6;
  }
  @media (min-width: 768px) {
    .stocka-wms-hero-desc {
      font-size: 1.18rem;
    }
  }

  .stocka-wms-hero-ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .stocka-wms-btn-primary {
    background: linear-gradient(135deg, #5c24ff 0%, #4314c7 100%);
    color: #ffffff !important;
    padding: 1rem 2rem;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 10px 25px -5px rgba(92, 36, 255, 0.5);
    transition: all 0.25s ease;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .stocka-wms-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 35px -5px rgba(92, 36, 255, 0.65);
    background: linear-gradient(135deg, #6d38ff 0%, #4f1ce0 100%);
  }
  .stocka-wms-btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #f8fafc !important;
    padding: 1rem 1.75rem;
    border-radius: 14px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    transition: all 0.2s ease;
  }
  .stocka-wms-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .stocka-wms-hero-badges-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .stocka-wms-hero-badge-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* ========================================================
     Hero Showcase Visual Composition (WMS Table + Live Dron Card)
     ======================================================== */
  .stocka-wms-hero-visual {
    margin-top: 3.5rem;
    position: relative;
    max-width: 1240px;
    margin-left: auto;
    margin-right: auto;
  }
  .stocka-wms-visual-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: start;
  }
  @media (min-width: 992px) {
    .stocka-wms-visual-grid {
      grid-template-columns: 1.14fr 0.86fr;
      gap: 1.5rem;
    }
  }
  @media (min-width: 1200px) {
    .stocka-wms-visual-grid {
      grid-template-columns: 1.18fr 0.82fr;
      gap: 2rem;
    }
  }

  /* Left Column: WMS Dashboard Console Window */
  .stocka-wms-preview-card {
    position: relative;
    border-radius: 24px;
    background: #101628;
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.85), 0 0 40px rgba(92, 36, 255, 0.22);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .stocka-wms-preview-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: rgba(15, 23, 42, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .stocka-wms-preview-dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .stocka-wms-preview-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .stocka-wms-preview-dots .dot-red { background: #ef4444; }
  .stocka-wms-preview-dots .dot-yellow { background: #f59e0b; }
  .stocka-wms-preview-dots .dot-green { background: #10b981; }

  .stocka-wms-preview-title-bar {
    font-size: 0.8rem;
    color: #94a3b8;
    font-family: monospace;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .stocka-wms-preview-live-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #06d6a0;
    background: rgba(6, 214, 160, 0.12);
    border: 1px solid rgba(6, 214, 160, 0.35);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stocka-wms-live-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #06d6a0;
    box-shadow: 0 0 8px #06d6a0;
    animation: wmsDotPulse 1.8s infinite ease-in-out;
  }
  .stocka-wms-preview-img-wrap {
    padding: 8px;
    background: #0d1222;
  }
  .stocka-wms-preview-img-wrap img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }
  .stocka-wms-preview-statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    background: rgba(15, 23, 42, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.78rem;
    color: #94a3b8;
  }
  .statusbar-metric {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .statusbar-metric strong {
    color: #f8fafc;
  }

  /* Right Column: Live Interactive Order Station Card */
  .stocka-wms-order-live-card {
    background: radial-gradient(circle at 30% 20%, rgba(92, 36, 255, 0.18) 0%, rgba(18, 24, 41, 0.92) 60%, #0d1222 100%);
    border-radius: 26px;
    padding: 1.5rem;
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.85), 0 0 40px rgba(92, 36, 255, 0.25);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }
  @media (max-width: 640px) {
    .stocka-wms-order-live-card {
      padding: 1.15rem;
      border-radius: 20px;
    }
  }
  .stocka-wms-order-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.85rem;
  }
  .stocka-wms-order-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .stocka-wms-order-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #06d6a0;
    box-shadow: 0 0 10px #06d6a0;
    animation: wmsDotPulse 1.8s infinite ease-in-out;
  }
  @keyframes wmsDotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.85); }
  }
  .stocka-wms-order-badge {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: rgba(92, 36, 255, 0.22);
    color: #c4b5fd;
    border: 1px solid rgba(167, 139, 250, 0.35);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Interactive Order Selector Tabs */
  .stocka-wms-order-pills-row {
    display: flex;
    gap: 0.45rem;
    background: rgba(15, 23, 42, 0.65);
    padding: 4px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .stocka-wms-order-pill-btn {
    flex: 1;
    background: transparent;
    border: 1px solid transparent;
    color: #94a3b8;
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    outline: none;
  }
  .stocka-wms-order-pill-btn:hover {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.06);
  }
  .stocka-wms-order-pill-btn.active {
    background: rgba(92, 36, 255, 0.4);
    color: #ffffff;
    box-shadow: 0 2px 10px rgba(92, 36, 255, 0.35);
    border-color: rgba(167, 139, 250, 0.4);
  }

  /* Stage (Viewfinder / Packaging & Dispatch Box) */
  .stocka-wms-pack-stage,
  .stocka-wms-dron-stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 1.25rem 1rem 1rem 1rem;
    background: radial-gradient(circle at center, rgba(92, 36, 255, 0.22) 0%, rgba(15, 23, 42, 0.75) 100%);
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    min-height: 175px;
  }
  .stocka-wms-box-gif,
  .stocka-wms-dron-gif {
    max-width: 100%;
    width: 250px;
    height: auto;
    display: block;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.55));
  }
  .stocka-wms-pack-stage .reticle-tl,
  .stocka-wms-pack-stage .reticle-tr,
  .stocka-wms-pack-stage .reticle-bl,
  .stocka-wms-pack-stage .reticle-br,
  .stocka-wms-dron-stage .reticle-tl,
  .stocka-wms-dron-stage .reticle-tr,
  .stocka-wms-dron-stage .reticle-bl,
  .stocka-wms-dron-stage .reticle-br {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(167, 139, 250, 0.7);
    pointer-events: none;
  }
  .stocka-wms-pack-stage .reticle-tl, .stocka-wms-dron-stage .reticle-tl { top: 10px; left: 10px; border-top: 2px solid; border-left: 2px solid; }
  .stocka-wms-pack-stage .reticle-tr, .stocka-wms-dron-stage .reticle-tr { top: 10px; right: 10px; border-top: 2px solid; border-right: 2px solid; }
  .stocka-wms-pack-stage .reticle-bl, .stocka-wms-dron-stage .reticle-bl { bottom: 10px; left: 10px; border-bottom: 2px solid; border-left: 2px solid; }
  .stocka-wms-pack-stage .reticle-br, .stocka-wms-dron-stage .reticle-br { bottom: 10px; right: 10px; border-bottom: 2px solid; border-right: 2px solid; }

  .stocka-wms-stage-overlay {
    position: absolute;
    bottom: 10px;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(10, 14, 26, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.72rem;
    color: #c4b5fd;
    font-weight: 700;
    letter-spacing: 0.04em;
    backdrop-filter: blur(8px);
  }

  /* Order Detail Box */
  .stocka-wms-order-detail-box {
    background: rgba(15, 23, 42, 0.88);
    border-radius: 16px;
    border: 1.5px solid rgba(6, 214, 160, 0.35);
    padding: 1rem 1.15rem;
    box-shadow: 0 4px 15px rgba(6, 214, 160, 0.1);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: all 0.25s ease;
  }
  .stocka-wms-order-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .stocka-wms-platform-pill {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #f8fafc;
  }
  .stocka-wms-platform-logo-img {
    height: 18px;
    width: auto;
    object-fit: contain;
    display: inline-block;
  }
  .stocka-wms-order-id-tag {
    font-family: monospace;
    font-size: 0.82rem;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.35);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }
  .stocka-wms-order-amount {
    font-size: 0.95rem;
    font-weight: 800;
    color: #10b981;
    font-feature-settings: "tnum";
  }

  /* Grid of Order Attributes */
  .stocka-wms-order-meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }
  .stocka-wms-meta-col {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .stocka-wms-meta-col .meta-title {
    font-size: 0.68rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }
  .stocka-wms-meta-col .meta-value {
    font-size: 0.82rem;
    font-weight: 700;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Order Items Row */
  .stocka-wms-order-items-box {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .items-box-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 700;
    text-transform: uppercase;
  }
  .items-box-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .item-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    gap: 0.5rem;
  }
  .item-entry-name {
    color: #f1f5f9;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .item-entry-qty {
    color: #06d6a0;
    font-weight: 800;
    font-family: monospace;
    white-space: nowrap;
  }

  /* Bottom Metrics Ribbon */
  .stocka-wms-chips-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
  }
  .stocka-wms-chip-item {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0.65rem 0.5rem;
    text-align: center;
  }
  .stocka-wms-chip-item .chip-val {
    display: block;
    font-size: 0.88rem;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 0.15rem;
  }
  .stocka-wms-chip-item .chip-lbl {
    display: block;
    font-size: 0.68rem;
    color: #94a3b8;
    line-height: 1.2;
  }

  /* ========================================================
     2. DUAL BUSINESS MODEL (Fulfillment vs Bodega Propia)
     ======================================================== */
  .stocka-wms-dual-sec {
    padding: 5.5rem 0;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }
  .stocka-wms-sec-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem auto;
  }
  .stocka-wms-sec-tag {
    display: inline-block;
    padding: 0.4rem 1.1rem;
    border-radius: 9999px;
    background: #ede9fe;
    border: 1px solid #c4b5fd;
    color: #4314c7;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.85rem;
  }
  .stocka-wms-sec-title {
    font-size: 2rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
    margin: 0 0 1rem 0;
    letter-spacing: -0.01em;
  }
  @media (min-width: 768px) {
    .stocka-wms-sec-title {
      font-size: 2.6rem;
    }
  }
  .stocka-wms-sec-desc {
    font-size: 1rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  .stocka-wms-dual-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 840px) {
    .stocka-wms-dual-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .stocka-wms-dual-card {
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 24px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.04);
    position: relative;
    overflow: hidden;
  }
  .stocka-wms-dual-card:hover {
    transform: translateY(-5px);
    border-color: #5c24ff;
    box-shadow: 0 20px 45px -12px rgba(92, 36, 255, 0.15);
  }
  .stocka-wms-dual-card.featured {
    border-color: #5c24ff;
    background: linear-gradient(180deg, #ffffff 0%, #faf8ff 100%);
  }
  .stocka-wms-dual-badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 8px;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .badge-included { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
  .badge-standalone { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }

  .stocka-wms-dual-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
  }
  .stocka-wms-dual-subtitle {
    font-size: 0.92rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 1.75rem 0;
  }
  .stocka-wms-feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
