<script>
  (function() {
    function initSearchPortal() {
      const searchInput = document.getElementById('stocka-sr-input');
      const searchForm = document.getElementById('stocka-sr-form');
      const cards = document.querySelectorAll('#stocka-sr-grid .stocka-sr-card');
      const resultsTitle = document.getElementById('stocka-sr-results-title');

      function filterCards(query) {
        const cleanQuery = (query || '').toLowerCase().trim();
        let matchCount = 0;

        if (!cleanQuery) {
          if (resultsTitle) resultsTitle.textContent = 'Servicios Principales y Soluciones Rápidas';
          cards.forEach(card => card.style.display = 'flex');
          return;
        }

        if (resultsTitle) resultsTitle.textContent = 'Resultados sugeridos para "' + cleanQuery + '"';

        cards.forEach(card => {
          const text = card.textContent.toLowerCase();
          const keywords = (card.dataset.keywords || '').toLowerCase();
          if (text.includes(cleanQuery) || keywords.includes(cleanQuery)) {
            card.style.display = 'flex';
            matchCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // If no direct card match, show all cards so the user is never stranded
        if (matchCount === 0) {
          if (resultsTitle) resultsTitle.textContent = 'No encontramos coincidencia exacta para "' + cleanQuery + '". Revisa nuestras opciones principales:';
          cards.forEach(card => card.style.display = 'flex');
        }
      }

      if (searchInput) {
        // Initial filter if URL already has query
        if (searchInput.value.trim()) {
          filterCards(searchInput.value);
        }

        searchInput.addEventListener('input', (e) => {
          filterCards(e.target.value);
        });
      }

      if (searchForm) {
        searchForm.addEventListener('submit', (e) => {
          e.preventDefault();
          if (searchInput) filterCards(searchInput.value);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearchPortal);
    } else {
      initSearchPortal();
    }
  })();
</script>

