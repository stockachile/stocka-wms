<style>
  .stocka-sr-page {
    font-family: inherit;
    color: #0f172a;
    background: #f8fafc;
    min-height: 80vh;
    padding-bottom: 5rem;
  }
  .stocka-sr-container {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  @media (min-width: 1024px) {
    .stocka-sr-container {
      padding: 0 2rem;
    }
  }

  /* Hero Section */
  .stocka-sr-hero {
    padding: 4.5rem 0 3.5rem 0;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, rgba(92, 36, 255, 0.08) 0%, rgba(248, 250, 252, 0) 75%);
    border-bottom: 1px solid #f1f5f9;
  }
  .stocka-sr-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.1rem;
    border-radius: 9999px;
    background: #f1f0fe;
    border: 1.5px solid #e0dcfe;
    color: #5c24ff;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.2rem;
  }
  .stocka-sr-title {
    font-size: 2.25rem;
    font-weight: 900;
    color: #0f172a;
    line-height: 1.2;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }
  @media (min-width: 768px) {
    .stocka-sr-title {
      font-size: 3rem;
    }
  }
  .stocka-sr-subtitle {
    font-size: 1.05rem;
    color: #64748b;
    max-width: 680px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  /* Search Input Form */
  .stocka-sr-form-wrap {
    max-width: 640px;
    margin: 0 auto;
    position: relative;
  }
  .stocka-sr-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .stocka-sr-search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: #94a3b8;
    pointer-events: none;
    z-index: 2;
  }
  .stocka-sr-input {
    width: 100% !important;
    padding: 1.05rem 1.25rem 1.05rem 52px !important;
    border: 2px solid #e2e8f0 !important;
    border-radius: 16px !important;
    outline: none !important;
    font-size: 1rem !important;
    color: #0f172a !important;
    background: #ffffff !important;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.06) !important;
    transition: all 0.25s ease !important;
    box-sizing: border-box !important;
    font-family: inherit !important;
    position: relative !important;
    z-index: 1 !important;
  }
  .stocka-sr-input:focus {
    border-color: #5c24ff !important;
    box-shadow: 0 12px 30px -5px rgba(92, 36, 255, 0.2) !important;
  }

  /* Quick Search Suggested Chips */
  .stocka-sr-chips-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .stocka-sr-chip-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #64748b;
  }
  .stocka-sr-chip {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #334155;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .stocka-sr-chip:hover {
    border-color: #5c24ff;
    color: #5c24ff;
    background: #f5f3ff;
  }

  /* Dynamic Results Container */
  .stocka-sr-results-sec {
    margin-top: 3rem;
  }
  .stocka-sr-sec-heading {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 1.5rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Solution Cards Grid */
  .stocka-sr-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .stocka-sr-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .stocka-sr-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 20px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
  }
  .stocka-sr-card:hover {
    border-color: #5c24ff;
    transform: translateY(-4px);
    box-shadow: 0 15px 35px -8px rgba(92, 36, 255, 0.12);
  }
  .stocka-sr-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.15rem;
    font-size: 1.4rem;
