              <input type="text" id="picker-form-company" class="stocka-picker-form-control" placeholder="Nombre de tu tienda o negocio" required>
            </div>
          </div>

          <div class="stocka-picker-form-group">
            <label for="picker-form-volume">Volumen estimado de pedidos diarios</label>
            <select id="picker-form-volume" class="stocka-picker-form-control stocka-picker-form-select">
              <option value="1 a 30 pedidos/dia">1 a 30 pedidos/día</option>
              <option value="31 a 100 pedidos/dia">31 a 100 pedidos/día</option>
              <option value="101 a 300 pedidos/dia">101 a 300 pedidos/día</option>
