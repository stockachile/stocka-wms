  <!-- ========================================================
       8. TECHNICAL FAQ ACCORDION
       ======================================================== -->
  <section class="stocka-picker-faq-sec">
    <div class="stocka-picker-container">
      
      <div class="stocka-picker-sec-header">
        <span class="stocka-picker-sec-tag">PREGUNTAS FRECUENTES</span>
        <h2 class="stocka-picker-sec-title">Dudas comunes sobre el Sistema Picker</h2>
        <p class="stocka-picker-sec-desc">
          Todo lo que necesitas saber sobre hardware, sincronización y puesta en marcha.
        </p>
      </div>

      <div class="stocka-picker-faq-accordion" id="stocka-picker-faq">
        
        <div class="stocka-picker-faq-item active">
          <button type="button" class="stocka-picker-faq-q">
            <span>¿Puedo usar smartphones comunes o necesito comprar terminales industriales caros?</span>
            <div class="stocka-picker-faq-icon">+</div>
          </button>
          <div class="stocka-picker-faq-a">
            Puedes utilizar <strong>cualquier smartphone o tablet estándar</strong> (Android o iPhone/iPad). La app de Stocka Picker es una Progressive Web App (PWA) ultra ligera. Si deseas mayor velocidad, puedes emparejar un lector de código de barras Bluetooth de bajo costo o conectar pistolas USB en computadores de mesón.
          </div>
        </div>

        <div class="stocka-picker-faq-item">
          <button type="button" class="stocka-picker-faq-q">
            <span>¿Qué ocurre si un operario escanea un producto con código incorrecto?</span>
            <div class="stocka-picker-faq-icon">+</div>
          </button>
          <div class="stocka-picker-faq-a">
            La app opera bajo el modo <strong>Strict Match</strong>. Si el SKU o código de barras no coincide al 100% con la variante exacta pedida por el cliente (talla, color o modelo), la aplicación bloquea el registro, emite un aviso sonoro de error y no permite dar por finalizado el pedido. Esto garantiza un 99.98% de precisión en los despachos.
          </div>
        </div>

        <div class="stocka-picker-faq-item">
          <button type="button" class="stocka-picker-faq-q">
            <span>¿Cómo detecta la app si un cliente modificó su compra en Shopify o Mercado Libre?</span>
            <div class="stocka-picker-faq-icon">+</div>
          </button>
          <div class="stocka-picker-faq-a">
            El sistema se encuentra <strong>conectado en tiempo real bidireccional con el WMS</strong>. Cuando entra una actualización desde el ecommerce mientras el pedido está en preparación, la app del operario despliega un banner rojo de advertencia preventiva: <em>⚠️ [MODIFICADO] Pedido editado en WMS</em>, requiriendo verificar los ítems antes de sellar el paquete.
          </div>
        </div>

        <div class="stocka-picker-faq-item">
          <button type="button" class="stocka-picker-faq-q">
            <span>¿Se puede usar Stocka Picker con múltiples bodegas o sucursales a la vez?</span>
            <div class="stocka-picker-faq-icon">+</div>
          </button>
          <div class="stocka-picker-faq-a">
            Sí. La consola de estación y la app móvil permiten <strong>filtrar por sucursal física</strong> (por ejemplo: Casa Matriz Ñuñoa, Bodega Recoleta, Sucursal La Reina o tus propias dependencias), asegurando que cada operario visualice únicamente los pedidos asignados a su ubicación.
          </div>
        </div>

        <div class="stocka-picker-faq-item">
          <button type="button" class="stocka-picker-faq-q">
            <span>¿Cuánto tiempo toma poner en marcha el sistema con mis operarios?</span>
            <div class="stocka-picker-faq-icon">+</div>
          </button>
          <div class="stocka-picker-faq-a">
            La inducción es inmediata: gracias a la confirmación fotográfica y los indicadores de colores (rojo/verde), un operario nuevo aprende a utilizar la app en <strong>menos de 15 minutos</strong> sin necesidad de capacitaciones complejas ni manuales extensos.
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================
       9. WORKER FAST ACCESS BOTTOM BANNER
       ======================================================== -->
  <div class="stocka-picker-worker-bar">
    <div class="stocka-picker-container">
      ¿Eres operario o cliente de Stocka? Ingresa directamente a la aplicación web en:
      <a href="https://picker-stocka.netlify.app/" target="_blank" rel="noopener">picker-stocka.netlify.app ➔</a>
    </div>
  </div>

</div>

<script>
  (function() {
    function initPickerPage() {
      // 1. Modules Tabs Logic
      const tabs = document.querySelectorAll('#stocka-picker-tabs-nav .stocka-picker-tab-btn');
      const panels = document.querySelectorAll('.stocka-picker-panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const targetId = tab.dataset.target;
          tabs.forEach(t => t.classList.remove('active'));
          panels.forEach(p => p.classList.remove('active'));

          tab.classList.add('active');
          const activePanel = document.getElementById(targetId);
          if (activePanel) activePanel.classList.add('active');
        });
      });

      // 2. FAQ Accordion Logic
      const faqItems = document.querySelectorAll('#stocka-picker-faq .stocka-picker-faq-item');
      faqItems.forEach(item => {
        const qBtn = item.querySelector('.stocka-picker-faq-q');
        if (qBtn) {
          qBtn.addEventListener('click', () => {
            const wasActive = item.classList.contains('active');
            item.classList.toggle('active', !wasActive);
          });
        }
      });

      // 3. Lead Form Submission
      const leadForm = document.getElementById('stocka-picker-lead-form');
      const msgDiv = document.getElementById('picker-form-msg');
      const submitBtn = document.getElementById('picker-form-submit-btn');

      if (leadForm) {
        leadForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>Enviando solicitud... ⏳</span>';

          const need = document.getElementById('picker-form-need')?.value || '';
          const name = document.getElementById('picker-form-name')?.value || '';
          const phone = document.getElementById('picker-form-phone')?.value || '';
          const email = document.getElementById('picker-form-email')?.value || '';
          const company = document.getElementById('picker-form-company')?.value || '';
          const volume = document.getElementById('picker-form-volume')?.value || '';
          const notes = document.getElementById('picker-form-notes')?.value || '';

          const payload = {
            contactName: name,
            email: email,
            phone: phone,
            companyName: company,
            services: ['Stocka Picker App', need],
            monthlyVolume: volume,
            notes: "Tipo de Solicitud: " + need + " | Volumen: " + volume + " | Detalle: " + (notes || 'Sin comentarios')
          };

          try {
            const res = await fetch('https://ejtjfaucnxbikrwjwwdu.supabase.co/functions/v1/submit-lead', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            if (!res.ok) throw new Error('Error al enviar');

            msgDiv.style.background = '#ecfdf5';
            msgDiv.style.color = '#059669';
            msgDiv.style.border = '1.5px solid #a7f3d0';
            msgDiv.innerHTML = '🎉 ¡Solicitud recibida con éxito! Un especialista del equipo de Stocka se contactará contigo a la brevedad.';
            msgDiv.style.display = 'block';
            leadForm.reset();
            submitBtn.innerHTML = '<span>Solicitud Enviada ✓</span>';

          } catch (err) {
            msgDiv.style.background = '#fef2f2';
            msgDiv.style.color = '#991b1b';
            msgDiv.style.border = '1.5px solid #fecaca';
            msgDiv.innerHTML = 'Solicitud registrada. Si prefieres respuesta inmediata, puedes escribirnos por <a href="https://wa.me/56939247487?text=' + encodeURIComponent('Hola! Quiero una demo de Stocka Picker para ' + company) + '" target="_blank" style="color: #5c24ff; text-decoration: underline;">WhatsApp aquí</a>.';
            msgDiv.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Reintentar Enviar</span>';
          }
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPickerPage);
    } else {
      initPickerPage();
    }
  })();
</script>

