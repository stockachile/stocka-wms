{%- comment -%}
  Stocka Picker App & Hardware Dedicated Landing Page
  Showcases smart warehouse picking app, strict SKU barcode verification,
  real-time modified order alerts, workstation console, hardware compatibility,
  comparison vs paper picking, and interactive demo request.
{%- endcomment -%}

<style>
  :root {
    --picker-primary: #5c24ff;
    --picker-primary-light: #7c4dff;
    --picker-primary-dark: #4314c7;
    --picker-accent: #06d6a0;
    --picker-accent-hover: #05b888;
    --picker-warning: #f59e0b;
    --picker-danger: #ef4444;
    --picker-bg-dark: #0a0e1a;
    --picker-card-dark: #121829;
    --picker-border-dark: #1e293b;
    --picker-text-main: #f8fafc;
    --picker-text-muted: #94a3b8;
  }

  .stocka-picker-wrapper {
    font-family: inherit;
    color: #0f172a;
    background: #ffffff;
    overflow-x: hidden;
  }

  .stocka-picker-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
    box-sizing: border-box;
  }
  @media (min-width: 1024px) {
    .stocka-picker-container {
      padding: 0 2rem;
    }
  }

  /* ========================================================
     1. HERO SECTION (Dark Tech SaaS Glow)
     ======================================================== */
  .stocka-picker-hero {
    background: radial-gradient(circle at 50% -20%, rgba(92, 36, 255, 0.4) 0%, rgba(10, 14, 26, 0.98) 70%, #0a0e1a 100%);
    color: #ffffff;
    padding: 5rem 0 4.5rem 0;
    position: relative;
    border-bottom: 1px solid #1e293b;
  }
  .stocka-picker-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(92, 36, 255, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .stocka-picker-hero-badge svg {
    color: #06d6a0;
    filter: drop-shadow(0 0 6px rgba(6, 214, 160, 0.7));
  }
  .stocka-picker-hero-title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.02em;
    color: #ffffff;
    max-width: 950px;
    margin: 0 auto 1.25rem auto;
    text-align: center;
  }
  @media (min-width: 768px) {
    .stocka-picker-hero-title {
      font-size: 3.25rem;
    }
  }
  .stocka-picker-hero-title span {
    background: linear-gradient(135deg, #a78bfa 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .stocka-picker-hero-desc {
    font-size: 1.05rem;
    color: #cbd5e1;
    max-width: 780px;
    margin: 0 auto 2.25rem auto;
    text-align: center;
    line-height: 1.65;
  }
  @media (min-width: 768px) {
    .stocka-picker-hero-desc {
      font-size: 1.18rem;
    }
  }

  .stocka-picker-hero-ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .stocka-picker-btn-primary {
    background: linear-gradient(135deg, #5c24ff 0%, #4314c7 100%);
    color: #ffffff !important;
    padding: 1rem 2rem;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 10px 25px -5px rgba(92, 36, 255, 0.5);
    transition: all 0.25s ease;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .stocka-picker-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 35px -5px rgba(92, 36, 255, 0.65);
    background: linear-gradient(135deg, #6d38ff 0%, #4f1ce0 100%);
  }
  .stocka-picker-btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #f8fafc !important;
    padding: 1rem 1.75rem;
    border-radius: 14px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1.5px solid rgba(255, 255, 255, 0.18);
    transition: all 0.2s ease;
    backdrop-filter: blur(8px);
  }
  .stocka-picker-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateY(-2px);
  }

  .stocka-picker-hero-badges-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .stocka-picker-hero-badge-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .stocka-picker-hero-badge-item svg {
    color: #06d6a0;
  }

  /* Hero Showcase Visual Composition */
  .stocka-picker-hero-visual {
    margin-top: 3.5rem;
    position: relative;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }
  .stocka-picker-visual-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .stocka-picker-visual-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .stocka-picker-scanner-card {
    background: radial-gradient(circle at 30% 20%, rgba(92, 36, 255, 0.18) 0%, rgba(18, 24, 41, 0.88) 60%, #0d1222 100%);
    border-radius: 26px;
    padding: 1.75rem;
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 40px rgba(92, 36, 255, 0.25);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  @media (max-width: 640px) {
    .stocka-picker-scanner-card {
      padding: 1.25rem;
      border-radius: 20px;
    }
  }
  .stocka-picker-scanner-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.85rem;
  }
  .stocka-picker-scanner-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .stocka-picker-scanner-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #06d6a0;
    box-shadow: 0 0 10px #06d6a0;
    animation: pickerDotPulse 1.8s infinite ease-in-out;
  }
  @keyframes pickerDotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.85); }
  }
  .stocka-picker-scanner-badge {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: rgba(92, 36, 255, 0.22);
    color: #c4b5fd;
    border: 1px solid rgba(167, 139, 250, 0.35);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Scanner Stage (Viewfinder / Reticle) */
  .stocka-picker-scanner-stage {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem 1rem;
    background: radial-gradient(circle at center, rgba(92, 36, 255, 0.15) 0%, rgba(15, 23, 42, 0.65) 100%);
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    position: relative;
    min-height: 190px;
  }
  .stocka-picker-scanner-gif {
    max-width: 100%;
    width: 290px;
    height: auto;
    display: block;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.5));
  }
  .reticle-tl, .reticle-tr, .reticle-bl, .reticle-br {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(167, 139, 250, 0.7);
    pointer-events: none;
  }
  .reticle-tl { top: 10px; left: 10px; border-top: 2px solid; border-left: 2px solid; }
  .reticle-tr { top: 10px; right: 10px; border-top: 2px solid; border-right: 2px solid; }
  .reticle-bl { bottom: 10px; left: 10px; border-bottom: 2px solid; border-left: 2px solid; }
  .reticle-br { bottom: 10px; right: 10px; border-bottom: 2px solid; border-right: 2px solid; }

  /* Feedback box */
  .stocka-picker-scanner-feedback {
    background: rgba(15, 23, 42, 0.88);
    border-radius: 14px;
    border: 1.5px solid rgba(6, 214, 160, 0.35);
    padding: 0.85rem 1.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    box-shadow: 0 4px 15px rgba(6, 214, 160, 0.1);
  }
  .stocka-picker-feedback-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
  }
  .stocka-picker-feedback-check {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(6, 214, 160, 0.15);
    color: #06d6a0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 900;
    border: 1px solid rgba(6, 214, 160, 0.4);
    flex-shrink: 0;
  }
  .stocka-picker-feedback-text {
    overflow: hidden;
  }
  .stocka-picker-feedback-sku {
    font-size: 0.75rem;
    color: #94a3b8;
    line-height: 1.2;
    font-family: monospace;
    font-weight: 600;
  }
  .stocka-picker-feedback-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .stocka-picker-feedback-match {
    font-size: 0.72rem;
    font-weight: 800;
    color: #06d6a0;
    background: rgba(6, 214, 160, 0.12);
    border: 1px solid rgba(6, 214, 160, 0.4);
    padding: 0.3rem 0.65rem;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  /* Scanner Chips / Metrics */
  .stocka-picker-scanner-chips {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
  }
  .stocka-picker-chip-item {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0.65rem 0.5rem;
    text-align: center;
  }
  .chip-val {
    display: block;
    font-size: 0.88rem;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 0.15rem;
  }
  .chip-lbl {
    display: block;
    font-size: 0.68rem;
    color: #94a3b8;
    line-height: 1.2;
  }

  .stocka-picker-card-mobile-wrap {
    display: flex;
    justify-content: center;
    position: relative;
  }
  .stocka-picker-card-mobile {
    max-width: 320px;
    width: 100%;
    background: #0f172a;
    border-radius: 36px;
    padding: 10px;
    border: 3px solid #334155;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.9), 0 0 35px rgba(6, 214, 160, 0.25);
    position: relative;
  }
  .stocka-picker-card-mobile img {
    width: 100%;
    height: auto;
    border-radius: 28px;
    display: block;
  }
  .stocka-picker-floating-pill {
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.92);
    border: 1.5px solid #06d6a0;
    color: #ffffff;
    padding: 6px 16px;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
  }
  .stocka-picker-floating-pill span.dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #06d6a0;
    display: inline-block;
    box-shadow: 0 0 8px #06d6a0;
  }

  /* ========================================================
     2. OPERATIONAL KPIS RIBBON
     ======================================================== */
  .stocka-picker-kpis-sec {
    background: #0f172a;
    border-bottom: 1px solid #1e293b;
    padding: 3rem 0;
  }
  .stocka-picker-kpis-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .stocka-picker-kpis-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stocka-picker-kpi-item {
    text-align: center;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .stocka-picker-kpi-item:hover {
    transform: translateY(-3px);
    border-color: rgba(92, 36, 255, 0.4);
    background: rgba(255, 255, 255, 0.05);
  }
  .stocka-picker-kpi-val {
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1.1;
    background: linear-gradient(135deg, #a78bfa 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.35rem;
  }
  .stocka-picker-kpi-label {
    font-size: 0.92rem;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 0.25rem;
  }
  .stocka-picker-kpi-sub {
    font-size: 0.76rem;
    color: #94a3b8;
    line-height: 1.35;
  }
  .stocka-picker-kpis-disclaimer {
    margin-top: 1.75rem;
    display: flex;
    justify-content: center;
  }
  .stocka-picker-disclaimer-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 1.35rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    max-width: 950px;
    box-sizing: border-box;
    backdrop-filter: blur(8px);
  }
  @media (max-width: 640px) {
    .stocka-picker-disclaimer-inner {
      border-radius: 14px;
      padding: 0.75rem 1rem;
      align-items: flex-start;
    }
  }
  .stocka-picker-disclaimer-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a78bfa;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .stocka-picker-disclaimer-text {
    margin: 0;
    font-size: 0.76rem;
    color: #94a3b8;
    line-height: 1.45;
    text-align: center;
  }
  @media (max-width: 640px) {
    .stocka-picker-disclaimer-text {
      text-align: left;
    }
  }
  .stocka-picker-disclaimer-text span.prefix {
    color: #c4b5fd;
    font-weight: 700;
  }
  .stocka-picker-disclaimer-text strong {
    color: #f8fafc;
    font-weight: 700;
  }

  /* ========================================================
     3. 5 CORE MODULES SHOWCASE (INTERACTIVE TABS)
     ======================================================== */
  .stocka-picker-modules-sec {
    padding: 5.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
  }
  .stocka-picker-sec-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }
  .stocka-picker-sec-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #5c24ff;
    text-transform: uppercase;
    background: #f3f0ff;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 0.85rem;
    border: 1px solid #e9d5ff;
  }
  .stocka-picker-sec-title {
    font-size: 2rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .stocka-picker-sec-title {
      font-size: 2.75rem;
    }
  }
  .stocka-picker-sec-desc {
    font-size: 1.05rem;
    color: #475569;
    line-height: 1.6;
  }

  /* Tabs Navigation Strip */
  .stocka-picker-tabs-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.5rem;
    background: #f1f5f9;
    border-radius: 16px;
    margin-bottom: 2.5rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .stocka-picker-tabs-nav::-webkit-scrollbar {
    display: none;
  }
  .stocka-picker-tab-btn {
    flex: 1 0 auto;
    text-align: center;
    padding: 0.85rem 1.25rem;
    border-radius: 12px;
    font-size: 0.88rem;
    font-weight: 700;
    color: #475569;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .stocka-picker-tab-btn:hover {
    color: #0f172a;
    background: rgba(255, 255, 255, 0.6);
  }
  .stocka-picker-tab-btn.active {
    background: #ffffff;
    color: #5c24ff;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
  }
  .stocka-picker-tab-btn.active .tab-num {
    background: #5c24ff;
    color: #ffffff;
  }
  .tab-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: #e2e8f0;
    color: #475569;
    font-size: 0.72rem;
    font-weight: 800;
  }

  /* Tab Panels */
  .stocka-picker-panel {
    display: none;
    animation: pickerFadeIn 0.3s ease;
  }
  .stocka-picker-panel.active {
    display: block;
  }
  @keyframes pickerFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .stocka-picker-panel-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 15px 35px -10px rgba(15, 23, 42, 0.06);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 992px) {
    .stocka-picker-panel-card {
      grid-template-columns: 1fr 1fr;
      padding: 3rem;
    }
  }

  .stocka-picker-panel-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .stocka-picker-panel-badge {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    text-transform: uppercase;
  }
  .badge-strict {
    background: #ecfdf5;
    color: #059669;
    border: 1px solid #a7f3d0;
  }
  .badge-alert {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
  }
  .badge-station {
    background: #f5f3ff;
    color: #5c24ff;
    border: 1px solid #ddd6fe;
  }
  .badge-courier {
    background: #eff6ff;
    color: #2563eb;
    border: 1px solid #bfdbfe;
  }
  .badge-sla {
    background: #fffbeb;
    color: #d97706;
    border: 1px solid #fde68a;
  }

  .stocka-picker-panel-title {
    font-size: 1.65rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
    margin: 0;
  }
  @media (min-width: 768px) {
    .stocka-picker-panel-title {
      font-size: 2rem;
    }
  }
  .stocka-picker-panel-desc {
    font-size: 0.98rem;
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  .stocka-picker-panel-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .stocka-picker-panel-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.92rem;
    color: #1e293b;
    line-height: 1.45;
  }
  .stocka-picker-feat-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #f0fdf4;
    color: #16a34a;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
    border: 1px solid #bbf7d0;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .stocka-picker-panel-media {
    border-radius: 16px;
    overflow: hidden;
    background: #0f172a;
