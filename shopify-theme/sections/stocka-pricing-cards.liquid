{%- comment -%}
  Stocka Custom Pricing Cards Section
  Supports custom grids, highlighted cards, checklist parsing, and custom styles.
{%- endcomment -%}

{%- assign settings = section.settings -%}
{% assign bg_color = section.settings.background_color %}
{% assign has_bg = false %}

{% unless bg_color == "rgba(0,0,0,0)" or bg_color == blank %}
    {% assign has_bg = true %}
{% endunless %}

{% capture container %}
    {{ section.settings.container }}
    {% if has_bg == false %} section-my {% else %} section-py {% endif %}
{% endcapture %}

<style>
  .stocka-pricing-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .stocka-pricing-card:hover {
    transform: translateY(-5px);
  }
  .stocka-pricing-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
  }
</style>

<section
  id="stocka-pricing-{{ section.id }}"
  class="relative {{ section.settings.custom_class }}"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="{{ container }} mx-auto px-4">
    
    {% if settings.heading != blank or settings.subheading != blank or settings.description != blank %}
      <div class="text-center max-w-2xl mx-auto mb-10 md:mb-16">
        {% if settings.subheading != blank %}
          <p class="text-sm font-semibold tracking-wider text-blue-600 uppercase mb-2">{{ settings.subheading }}</p>
        {% endif %}
        {% if settings.heading != blank %}
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-4">{{ settings.heading }}</h2>
        {% endif %}
        {% if settings.description != blank %}
          <div class="text-slate-600 text-base md:text-lg">{{ settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ settings.columns_count }} gap-8 items-stretch">
      {% for block in section.blocks %}
        {%- assign card = block.settings -%}
        
        <div 
          class="stocka-pricing-card relative flex flex-col justify-between p-6 md:p-8 rounded-2xl border-2 {% if card.is_featured %} border-blue-600 shadow-xl bg-white scale-100 lg:scale-105 z-10 {% else %} border-slate-100 shadow-sm bg-slate-50/50 {% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if card.is_featured and card.featured_badge != blank %}
            <span class="stocka-pricing-badge bg-blue-600 text-white text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wider">
              {{ card.featured_badge }}
            </span>
          {% endif %}

          <div>
            <!-- Card Header -->
            <div class="mb-6">
              <h3 class="text-xl md:text-2xl font-bold {% if card.is_featured %}text-slate-900{% else %}text-slate-800{% endif %}">
                {{ card.title }}
              </h3>
              {% if card.subtitle != blank %}
                <p class="text-sm text-slate-500 mt-1">{{ card.subtitle }}</p>
              {% endif %}
            </div>

            <!-- Pricing Area -->
            <div class="flex items-baseline mb-6 {% if card.is_featured %}text-slate-900{% else %}text-slate-800{% endif %}">
              <span class="text-3xl md:text-4xl font-extrabold tracking-tight">{{ card.price }}</span>
              {% if card.unit != blank %}
                <span class="text-lg font-medium text-slate-500 ml-1">{{ card.unit }}</span>
              {% endif %}
            </div>

            <!-- Dividers -->
            <hr class="border-slate-100 mb-6">

            <!-- Checklist -->
            {% if card.features != blank %}
              {% assign features_array = card.features | newline_to_br | split: '<br />' %}
              <ul class="space-y-4 mb-8">
                {% for feature in features_array %}
                  {% assign clean_feature = feature | strip | replace: '<br>', '' %}
                  {% if clean_feature != blank %}
                    <li class="flex items-start">
                      <svg class="flex-shrink-0 w-5 h-5 text-blue-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      <span class="text-sm md:text-base text-slate-600 ml-3">{{ clean_feature }}</span>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          </div>

          <!-- Card Button -->
          {% if card.button_label != blank %}
            <div class="mt-auto">
              <a 
                href="{{ card.button_link | default: '#' }}" 
                class="sf__btn w-full text-center justify-center py-3 px-4 sf__btn-large {% if card.is_featured %}{{ settings.featured_btn_style }}{% else %}{{ settings.normal_btn_style }}{% endif %}"
              >
                {{ card.button_label }}
              </a>
            </div>
          {% endif %}

        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Stocka Pricing Cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Tarifas dinámicas y competitivas"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "PRECIOS DE SERVICIO"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción corta",
      "default": "<p>Estructura de precios simple, clara y escalable. Pagas solo lo que utilizas.</p>"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Ancho del contenedor",
      "default": "container",
      "options": [
        { "value": "container", "label": "Normal" },
        { "value": "container-fluid", "label": "Ancho Completo" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de Fondo",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "columns_count",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columnas en Escritorio",
      "default": 3
    },
    {
      "type": "select",
      "id": "normal_btn_style",
      "label": "Estilo del Botón Normal",
      "default": "sf__btn-secondary",
      "options": [
        { "value": "sf__btn-primary", "label": "Primario" },
        { "value": "sf__btn-secondary", "label": "Secundario" },
        { "value": "sf__btn-white", "label": "Blanco" }
      ]
    },
    {
      "type": "select",
      "id": "featured_btn_style",
      "label": "Estilo del Botón Destacado",
      "default": "sf__btn-primary",
      "options": [
        { "value": "sf__btn-primary", "label": "Primario" },
        { "value": "sf__btn-secondary", "label": "Secundario" },
        { "value": "sf__btn-white", "label": "Blanco" }
      ]
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Clase CSS Personalizada"
    }
  ],
  "blocks": [
    {
      "type": "pricing_card",
      "name": "Tarjeta de Precio",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del Servicio",
          "default": "Almacenamiento"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo (Opcional)",
          "default": "espacio utilizado en bodega"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Precio",
          "default": "$26.500"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unidad de cobro",
          "default": "/ m3"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Características (Una por línea)",
          "default": "Valor por cada m3 de espacio utilizado al mes\nPagas el espacio que utilizas\nTus productos asegurados\nInventario online\nSin mínimos de almacenamiento"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Etiqueta del Botón",
          "default": "Contactar"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del Botón"
        },
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Destacar esta tarjeta",
          "default": false
        },
        {
          "type": "text",
          "id": "featured_badge",
          "label": "Etiqueta de destacado",
          "default": "Recomendado"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stocka Pricing Cards",
      "blocks": [
        { "type": "pricing_card", "settings": { "title": "Almacenamiento", "price": "$26.500", "unit": "/ m3" } },
        { "type": "pricing_card", "settings": { "title": "Preparación", "price": "$850", "unit": "/ pedido", "is_featured": true } },
        { "type": "pricing_card", "settings": { "title": "Despachos", "price": "$3.200", "unit": "/ pedido" } }
      ]
    }
  ]
}
{% endschema %}
