{%- comment -%}
  Stocka Official Modern Footer (OS 2.0)
  Professional B2B Logistics Layout with SVG Vector Icons (No Emojis)
{%- endcomment -%}

<style>
  .stocka-footer {
    background-color: #0f172a;
    color: #94a3b8;
    font-family: inherit;
    position: relative;
    border-top: 1px solid #1e293b;
  }
  .stocka-footer-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 2.5rem 1.5rem;
  }
  .stocka-footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }
  @media (min-width: 640px) {
    .stocka-footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .stocka-footer-grid {
      grid-template-columns: 1.3fr 1fr 1.1fr 1.1fr;
      gap: 2.5rem;
    }
  }
  .stocka-footer-title {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    letter-spacing: -0.2px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .stocka-footer-title svg {
    color: #5c24ff;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .stocka-footer-desc {
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }
  .stocka-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .stocka-footer-link {
    color: #cbd5e1;
    font-size: 0.9rem;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }
  .stocka-footer-link svg {
    width: 14px;
    height: 14px;
    color: #64748b;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .stocka-footer-link:hover {
    color: #ffffff !important;
    transform: translateX(3px);
  }
  .stocka-footer-link:hover svg {
    color: #5c24ff;
  }
  .stocka-footer-card {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(51, 65, 85, 0.7);
    border-radius: 14px;
    padding: 1.15rem;
    margin-bottom: 1rem;
    transition: all 0.2s ease;
  }
  .stocka-footer-card:hover {
    border-color: rgba(92, 36, 255, 0.4);
    background: rgba(30, 41, 59, 0.8);
  }
  .stocka-footer-card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .stocka-footer-card-header svg {
    width: 16px;
    height: 16px;
    color: #5c24ff;
    flex-shrink: 0;
  }
  .stocka-footer-card-body {
    font-size: 0.82rem;
    color: #94a3b8;
    line-height: 1.5;
  }
  .stocka-footer-card-body a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .stocka-footer-card-body a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
  .stocka-footer-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    transition: all 0.2s ease;
    text-decoration: none !important;
  }
  .stocka-footer-social-btn svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .stocka-footer-social-btn:hover {
    background: #5c24ff;
    color: #ffffff;
    border-color: #5c24ff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(92, 36, 255, 0.3);
  }
  .stocka-footer-bottom {
    border-top: 1px solid #1e293b;
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.82rem;
    color: #64748b;
  }
  @media (min-width: 768px) {
    .stocka-footer-bottom {
      flex-direction: row;
    }
  }
  .stocka-footer-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    color: #64748b;
  }
  .stocka-footer-badge-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(30, 41, 59, 0.6);
    padding: 4px 10px;
    border-radius: 8px;
    border: 1px solid #334155;
    color: #94a3b8;
  }
  .stocka-footer-badge-item svg {
    width: 14px;
    height: 14px;
    color: #10b981;
  }
</style>

<footer class="stocka-footer" data-section-id="{{ section.id }}" data-section-type="footer">
