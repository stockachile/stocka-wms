{%- comment -%}
  Stocka Features List / Icon Grid
  Flexible section displaying columns of icons+texts, or split row with image + list of checkmarks.
{%- endcomment -%}

{%- assign settings = section.settings -%}
{% assign bg_color = section.settings.background_color %}
{% assign has_bg = false %}

{% unless bg_color == "rgba(0,0,0,0)" or bg_color == blank %}
    {% assign has_bg = true %}
{% endunless %}

{% capture container %}
    {{ section.settings.container }}
    {% if has_bg == false %} section-my {% else %} section-py {% endif %}
{% endcapture %}

<section
  id="stocka-features-{{ section.id }}"
  class="relative {{ section.settings.custom_class }}"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="{{ container }} mx-auto px-4">

    <!-- Section Header -->
    {% if settings.heading != blank or settings.subheading != blank or settings.description != blank %}
      <div class="max-w-3xl mx-auto mb-10 md:mb-16 text-center">
        {% if settings.subheading != blank %}
          <p class="text-sm font-semibold tracking-wider text-blue-600 uppercase mb-2">{{ settings.subheading }}</p>
        {% endif %}
        {% if settings.heading != blank %}
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-4">{{ settings.heading }}</h2>
        {% endif %}
        {% if settings.description != blank %}
          <div class="text-slate-600 text-base md:text-lg rte prose mx-auto">{{ settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if settings.layout_mode == 'grid' %}
      <!-- Grid Layout Mode -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-{{ settings.columns_count }} gap-8">
        {% for block in section.blocks %}
          {% assign item = block.settings %}
          <div class="flex flex-col items-start p-5 bg-white rounded-xl border border-slate-50 shadow-sm" {{ block.shopify_attributes }}>
            <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-blue-50 text-blue-600 mb-4">
              {% if item.custom_svg != blank %}
                <div class="w-6 h-6 fill-current">{{ item.custom_svg }}</div>
              {% else %}
                <!-- Default Box/Checkmark SVG -->
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              {% endif %}
            </div>
            <h3 class="text-lg font-bold text-slate-800 mb-2">{{ item.title }}</h3>
            {% if item.text != blank %}
              <div class="text-sm text-slate-500 leading-relaxed">{{ item.text }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

    {% else %}
      <!-- Split Row Layout Mode (Image + List) -->
      <div class="flex flex-wrap items-center -mx-4 lg:-mx-8">
        
        <!-- Image Column -->
        <div class="w-full lg:w-1/2 px-4 lg:px-8 mb-8 lg:mb-0 {% if settings.layout_mode == 'image-right' %}lg:order-last{% endif %}">
          <div class="rounded-2xl overflow-hidden shadow-md">
            {% if settings.image != blank %}
              {% render 'responsive-image', image: settings.image, image_class: 'w-full h-auto object-cover' %}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'sf__placeholder-svg w-full h-96 object-cover bg-slate-100' }}
            {% endif %}
          </div>
        </div>

        <!-- Content/List Column -->
        <div class="w-full lg:w-1/2 px-4 lg:px-8">
          {% if settings.title_split != blank %}
            <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">{{ settings.title_split }}</h3>
          {% endif %}
          {% if settings.text_split != blank %}
            <div class="text-slate-600 mb-6 leading-relaxed">{{ settings.text_split }}</div>
          {% endif %}

          <ul class="space-y-4">
            {% for block in section.blocks %}
              {% assign item = block.settings %}
              <li class="flex items-start" {{ block.shopify_attributes }}>
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mt-0.5">
                  {% if item.custom_svg != blank %}
                    <div class="w-3.5 h-3.5 fill-current">{{ item.custom_svg }}</div>
                  {% else %}
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                  {% endif %}
                </div>
                <div class="ml-4">
                  <h4 class="text-base font-bold text-slate-800">{{ item.title }}</h4>
                  {% if item.text != blank %}
                    <div class="text-sm text-slate-500 mt-1">{{ item.text }}</div>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ul>

          {% if settings.button_label != blank %}
            <div class="mt-8">
              <a href="{{ settings.button_link | default: '#' }}" class="sf__btn {{ settings.button_style }} sf__btn-large">
                {{ settings.button_label }}
              </a>
            </div>
          {% endif %}
        </div>

      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Stocka Features List",
  "settings": [
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Modo de Diseño",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Cuadrícula de Iconos" },
        { "value": "image-left", "label": "Imagen Izquierda, Lista Derecha" },
        { "value": "image-right", "label": "Lista Izquierda, Imagen Derecha" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título Sección (Solo modo Cuadrícula)",
      "default": "Tú solo vendes, olvídate de todo lo demás"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo Sección (Solo modo Cuadrícula)",
      "default": "LOGÍSTICA SIMPLIFICADA"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción Sección (Solo modo Cuadrícula)",
      "default": "<p>Contamos con el servicio más completo del mercado, tu logística ya no será un problema.</p>"
    },
    {
      "type": "header",
      "content": "Ajustes del modo Split (Imagen + Lista)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen Lateral"
    },
    {
      "type": "text",
      "id": "title_split",
      "label": "Título Lateral",
      "default": "Tú solo vendes, olvídate de todo lo demás"
    },
    {
      "type": "richtext",
      "id": "text_split",
      "label": "Texto/Párrafo Lateral",
      "default": "<p>La logística de tu ecommerce nunca más será un problema. Ofrecemos una experiencia excelente.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Etiqueta del Botón (Opcional)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del Botón"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo del Botón",
      "default": "sf__btn-primary",
      "options": [
        { "value": "sf__btn-primary", "label": "Primario" },
        { "value": "sf__btn-secondary", "label": "Secundario" },
        { "value": "sf__btn-link", "label": "Enlace simple" }
      ]
    },
    {
      "type": "header",
      "content": "Ajustes Generales"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Ancho del contenedor",
      "default": "container",
      "options": [
        { "value": "container", "label": "Normal" },
        { "value": "container-fluid", "label": "Ancho Completo" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de Fondo",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "columns_count",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columnas en Escritorio (Modo Cuadrícula)",
      "default": 4
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Clase CSS Personalizada"
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Característica",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Inventario Online"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción / Detalles",
          "default": "Accede a tu stock en tiempo real desde nuestro WMS."
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Código SVG del Icono (Opcional)",
          "info": "Si se deja vacío se mostrará un checkmark estándar."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stocka Features List",
      "blocks": [
        { "type": "feature_item", "settings": { "title": "Almacenamos", "text": "Almacenamos tus productos en nuestros centros logísticos seguros." } },
        { "type": "feature_item", "settings": { "title": "Armamos", "text": "Hacemos el pick & pack rápido y preciso de tus pedidos." } },
        { "type": "feature_item", "settings": { "title": "Entregamos", "text": "Despachos express y cobertura nacional vía integraciones." } }
      ]
    }
  ]
}
{% endschema %}
