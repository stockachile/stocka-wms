<script>
  (function() {
    const SUPABASE_URL = 'https://ejtjfaucnxbikrwjwwdu.supabase.co';
    const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVqdGpmYXVjbnhiaWtyd2p3d2R1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk4MzExODUsImV4cCI6MjA5NTQwNzE4NX0.cnuyxOpbqr-182Q3MJFJu0prtFSvwk1RgbiVBhjYUak';

    let UF_VALUE = 41248;
    let TIERS = [
      { id: 1, min: 0, max: 25, label: "Rango 1: 0 a 25 pedidos", storage: 48900, pickpack: 1250 },
      { id: 2, min: 26, max: 100, label: "Rango 2: 26 a 100 pedidos", storage: 43500, pickpack: 1200 },
      { id: 3, min: 101, max: 200, label: "Rango 3: 101 a 200 pedidos", storage: 38500, pickpack: 1150 },
      { id: 4, min: 201, max: 500, label: "Rango 4: 201 a 500 pedidos", storage: 33500, pickpack: 1050 },
      { id: 5, min: 501, max: 1500, label: "Rango 5: 501 a 1.500 pedidos", storage: 30500, pickpack: 950 },
      { id: 6, min: 1501, max: 2500, label: "Rango 6: 1.501 a 2.500 pedidos", storage: 28500, pickpack: 900 },
      { id: 7, min: 2501, max: 3500, label: "Rango 7: 2.501 a 3.500 pedidos", storage: 26500, pickpack: 850 },
      { id: 8, min: 3501, max: 999999, label: "Rango 8: +3.500 pedidos (Enterprise+)", storage: 25500, pickpack: 800 }
    ];
    let STORAGE_DISCOUNTS = [
      { min: 10.0, max: 15.0, discount_pct: 18 },
      { min: 15.01, max: 25.0, discount_pct: 21 },
      { min: 25.01, max: 35.0, discount_pct: 24 },
      { min: 35.01, max: 60.0, discount_pct: 27 },
      { min: 60.01, max: 100.0, discount_pct: 30 },
      { min: 100.01, max: 160.0, discount_pct: 33 },
      { min: 160.01, max: 230.0, discount_pct: 35 },
      { min: 230.01, max: 300.0, discount_pct: 37 },
      { min: 300.01, max: 999999, discount_pct: 39 }
    ];
    let RULES = {
      base_included_sku: 3,
      base_included_units: 10,
      surcharge_extra_sku: 100,
      surcharge_extra_unit: 50,
      protected_ticket_base_rate: 650,
      surcharge_marketplace_collect: 100,
      catalogue_exempt_max_units: 2,
      surcharge_catalogue_over_100_sku: 100,
      surcharge_ml_full_labeling: 100,
      inbound_labeling_per_unit: 100
    };
    let FIXED_FEE = {
      exemption_min_orders: 75,
      exemption_min_volume: 1.5,
      tier1_max_orders: 50,
      tier1_max_volume: 1.0,
      tier1_fee_uf: 1.5,
      tier2_fee_uf: 0.9
    };
    let RATES = {
      same_day_rm: 3200,
      colina: 3490,
      enviame_fee: 35,
      pickup_express: 1490,
      pos_uf: 0.2,
      vitrina_uf: 0.6,
      unloading_uf_m3: 0.1,
      unloading_cap_uf: 2.0,
      bubble_linear_m: 360,
      box_s: 450,
      box_m: 990
    };
    let REGIONAL_BRACKETS = {
      '0_1kg': { label: 'Hasta 1 kg', avg_rate: 3950 },
      '1_3kg': { label: '1 a 3 kg', avg_rate: 4050 },
      '3_6kg': { label: '3 a 6 kg', avg_rate: 6450 },
      '6_9kg': { label: '6 a 9 kg', avg_rate: 6790 }
    };

    let currentOrders = 60;
    let currentVol = 2.0;
    let includeSameDay = true;
    let rmPercentage = 75;
    let includeVitrina = false;
    let includePOS = false;
    let lastSummarySnapshot = {};

    function formatCLP(val) {
      return '$' + Math.round(val).toLocaleString('es-CL');
    }

    function getNumVal(id, fallback = 0) {
      const el = document.getElementById(id);
      if (!el) return fallback;
      const v = parseFloat(el.value);
      return isNaN(v) ? fallback : Math.max(0, v);
    }

    function getIntVal(id, fallback = 0) {
      return Math.floor(getNumVal(id, fallback));
    }

    function getChecked(id, fallback = false) {
      const el = document.getElementById(id);
      return el ? !!el.checked : fallback;
    }

    function calculate() {
      let tier = TIERS.find(t => currentOrders >= t.min && currentOrders <= t.max) || TIERS[0];
      if (currentOrders > TIERS[TIERS.length - 1].min) {
        tier = TIERS[TIERS.length - 1];
      }

      // 1. Almacenamiento con escala dinámica hasta 39% OFF
      let storageDiscountPct = 0;
      for (let i = 0; i < STORAGE_DISCOUNTS.length; i++) {
        const d = STORAGE_DISCOUNTS[i];
        if (currentVol >= d.min && currentVol <= d.max) {
          storageDiscountPct = (Number(d.discount_pct) || 0) / 100;
          break;
        }
      }
      const effectiveStorageRate = tier.storage * (1 - storageDiscountPct);
      const totalStorage = currentVol * effectiveStorageRate;

      // 2. Pick & Pack + Parámetros Avanzados
      const skuPerOrder = Math.max(1, getIntVal('cot-sku-per-order', 1));
      const unitsPerOrder = Math.max(1, getIntVal('cot-units-per-order', 1));
      const isProtected = getChecked('cot-chk-protected', false);
      const hasCat100 = getChecked('cot-chk-cat100', false);
      const isMktCollect = getChecked('cot-chk-mktcollect', false);

      const basePickPack = isProtected ? RULES.protected_ticket_base_rate : tier.pickpack;
      const extraSkuCost = Math.max(0, skuPerOrder - RULES.base_included_sku) * RULES.surcharge_extra_sku;
      const extraUnitsCost = Math.max(0, unitsPerOrder - RULES.base_included_units) * RULES.surcharge_extra_unit;
      const catCost = (hasCat100 && unitsPerOrder > RULES.catalogue_exempt_max_units) ? RULES.surcharge_catalogue_over_100_sku : 0;
      const mktCost = isMktCollect ? RULES.surcharge_marketplace_collect : 0;
      const unitPickPack = basePickPack + extraSkuCost + extraUnitsCost + catCost + mktCost;
      const totalPickPack = currentOrders * unitPickPack;

      // 3. Costo Fijo Mensual (Exento >= 75 ped. o >= 1,5 m³)
      let fixedFeeExempt = false;
      let fixedFeeUF = 0;
      let fixedFeeCLP = 0;
      let fixedFeeReason = '';
      if (currentOrders >= FIXED_FEE.exemption_min_orders || currentVol >= FIXED_FEE.exemption_min_volume) {
        fixedFeeExempt = true;
        fixedFeeReason = currentOrders >= FIXED_FEE.exemption_min_orders
          ? `Exento (≥ ${FIXED_FEE.exemption_min_orders} pedidos)`
          : `Exento (≥ ${FIXED_FEE.exemption_min_volume} m³)`;
      } else if (currentOrders < FIXED_FEE.tier1_max_orders && currentVol < FIXED_FEE.tier1_max_volume) {
        fixedFeeUF = FIXED_FEE.tier1_fee_uf;
        fixedFeeCLP = Math.round(fixedFeeUF * UF_VALUE);
        fixedFeeReason = `${fixedFeeUF} UF (< ${FIXED_FEE.tier1_max_orders} ped. y < ${FIXED_FEE.tier1_max_volume} m³)`;
      } else {
        fixedFeeUF = FIXED_FEE.tier2_fee_uf;
        fixedFeeCLP = Math.round(fixedFeeUF * UF_VALUE);
        fixedFeeReason = `${fixedFeeUF} UF (< ${FIXED_FEE.exemption_min_orders} ped. y < ${FIXED_FEE.exemption_min_volume} m³)`;
      }

      // 4. Despachos RM, Regiones + Envíame, Colina y Retiros Express
      const rmOrders = includeSameDay ? Math.round(currentOrders * (rmPercentage / 100)) : 0;
      const regOrders = includeSameDay ? (currentOrders - rmOrders) : 0;
      const totalRmShipping = rmOrders * RATES.same_day_rm;

      const regWeightEl = document.getElementById('cot-reg-weight');
      const regBracketKey = regWeightEl ? regWeightEl.value : '1_3kg';
      const regBracket = REGIONAL_BRACKETS[regBracketKey] || REGIONAL_BRACKETS['1_3kg'];
      const includeRegional = getChecked('cot-chk-include-regional', true);
      const unitRegRate = regBracket.avg_rate + RATES.enviame_fee;
      const totalRegShipping = (includeSameDay && includeRegional && regOrders > 0) ? (regOrders * unitRegRate) : 0;

      const colinaOrders = getIntVal('cot-colina-orders', 0);
      const expressPickups = getIntVal('cot-express-pickups', 0);
      const costColina = colinaOrders * RATES.colina;
      const costExpress = expressPickups * RATES.pickup_express;

      // 5. Extras, Etiquetado, Descarga e Insumos
      let extraBranchUF = 0;
      if (includeVitrina) extraBranchUF += RATES.vitrina_uf;
      if (includePOS) extraBranchUF += RATES.pos_uf;
      const costBranch = Math.round(extraBranchUF * UF_VALUE);

      const unloadingM3 = getNumVal('cot-unloading-m3', 0);
      const costUnloading = unloadingM3 >= 1.0
        ? Math.round(Math.min(unloadingM3 * RATES.unloading_uf_m3, RATES.unloading_cap_uf) * UF_VALUE)
        : 0;

      const mlFullUnits = getIntVal('cot-mlfull-units', 0);
      const inboundLabelUnits = getIntVal('cot-inbound-label-units', 0);
      const costMlFull = mlFullUnits * RULES.surcharge_ml_full_labeling;
      const costInboundLabel = inboundLabelUnits * RULES.inbound_labeling_per_unit;

      const bubbleMeters = getNumVal('cot-bubble-m', 0);
      const boxS = getIntVal('cot-box-s', 0);
      const boxM = getIntVal('cot-box-m', 0);
      const costSupplies = (bubbleMeters * RATES.bubble_linear_m) + (boxS * RATES.box_s) + (boxM * RATES.box_m);

      const totalExtrasAndSpecial = costBranch + costUnloading + costMlFull + costInboundLabel + costSupplies + costColina + costExpress;

      // 6. Totales
      const totalCost = Math.round(totalStorage + totalPickPack + fixedFeeCLP + totalRmShipping + totalRegShipping + totalExtrasAndSpecial);
      const totalIVA = Math.round(totalCost * 0.19);
      const totalGross = totalCost + totalIVA;
      const totalUF = (totalCost / UF_VALUE).toFixed(2).replace('.', ',');
      const costPerOrder = currentOrders > 0 ? Math.round(totalCost / currentOrders) : 0;

      lastSummarySnapshot = {
        tier, storageDiscountPct, totalStorage, unitPickPack, totalPickPack,
        fixedFeeExempt, fixedFeeUF, fixedFeeCLP, fixedFeeReason,
        rmOrders, totalRmShipping, regOrders, includeRegional, regBracket, totalRegShipping,
        colinaOrders, expressPickups, mlFullUnits, inboundLabelUnits, unloadingM3,
        bubbleMeters, boxS, boxM, totalExtrasAndSpecial, totalCost, totalIVA, totalGross, totalUF, costPerOrder
      };

      // Render DOM
      const ufRefEl = document.getElementById('sum-uf-ref');
      if (ufRefEl) ufRefEl.textContent = formatCLP(UF_VALUE);

      const tBadge = document.getElementById('stocka-tier-badge');
      if (tBadge) tBadge.textContent = tier.label;
      const tName = document.getElementById('cot-tier-name');
      if (tName) tName.textContent = tier.label + "/mes";
      const tPick = document.getElementById('cot-tier-pickpack');
      if (tPick) tPick.textContent = formatCLP(basePickPack);
      const tStore = document.getElementById('cot-tier-storage');
      if (tStore) tStore.textContent = formatCLP(tier.storage);

      const nextTierIndex = TIERS.findIndex(t => t.id === tier.id) + 1;
      const nextTierBar = document.getElementById('cot-next-tier-bar');
      if (nextTierBar) {
        if (nextTierIndex > 0 && nextTierIndex < TIERS.length) {
          const nextTier = TIERS[nextTierIndex];
          const ordersNeeded = Math.max(1, nextTier.min - currentOrders);
          document.getElementById('cot-next-tier-text').innerHTML = `¡Agrega <strong>${ordersNeeded} pedidos</strong> más para desbloquear el Rango ${nextTier.id} y pagar <strong>${formatCLP(nextTier.pickpack)}</strong> por pedido!`;
          nextTierBar.style.display = 'flex';
        } else {
          nextTierBar.style.display = 'none';
        }
      }

      const discBadge = document.getElementById('stocka-storage-discount-badge');
      if (discBadge) {
        if (storageDiscountPct > 0) {
          discBadge.textContent = `${Math.round(storageDiscountPct * 100)}% OFF por volumen`;
          discBadge.style.display = 'inline-block';
        } else {
          discBadge.style.display = 'none';
        }
      }

      // Resaltar escalón activo de descuentos de bodegaje + mensaje
      document.querySelectorAll('#cot-discount-scale-chips .stocka-cot-disc-chip').forEach(chip => {
        const minV = parseFloat(chip.dataset.min) || 0;
        const maxV = parseFloat(chip.dataset.max) || 999999;
        chip.classList.toggle('is-active', currentVol >= minV && currentVol <= maxV);
      });
      const discStatus = document.getElementById('cot-disc-scale-status');
      if (discStatus) {
        if (storageDiscountPct > 0) {
          const savedAmount = Math.round(currentVol * tier.storage * storageDiscountPct);
          discStatus.textContent = `✓ ${Math.round(storageDiscountPct * 100)}% OFF activo · Ahorras ${formatCLP(savedAmount)}`;
          discStatus.style.color = '#059669';
        } else {
          const firstD = STORAGE_DISCOUNTS[0] || { min: 10, discount_pct: 18 };
          const needed = Math.max(0.1, firstD.min - currentVol).toFixed(1).replace('.', ',');
          discStatus.textContent = `Alcanza ${firstD.min} m³ (faltan ${needed} m³) para ${firstD.discount_pct}% OFF`;
          discStatus.style.color = '#5c24ff';
        }
      }

      // Actualizar relleno gradiente de todos los sliders
      ['cot-orders-slider', 'cot-vol-slider', 'cot-rm-slider'].forEach(sId => {
        const sEl = document.getElementById(sId);
        if (!sEl) return;
        const mn = parseFloat(sEl.min) || 0;
        const mx = parseFloat(sEl.max) || 100;
        const vl = parseFloat(sEl.value) || 0;
        const pct = Math.max(0, Math.min(100, ((vl - mn) / (mx - mn)) * 100));
        sEl.style.setProperty('--slider-pct', pct + '%');
      });

      const svDisp = document.getElementById('sum-vol-display');
      if (svDisp) svDisp.textContent = currentVol.toFixed(1);
      const ssSub = document.getElementById('sum-storage-sub');
      if (ssSub) {
        ssSub.textContent = storageDiscountPct > 0
          ? `${formatCLP(tier.storage)}/m³ (-${Math.round(storageDiscountPct * 100)}% OFF)`
          : `${formatCLP(tier.storage)}/m³`;
      }
      const ssVal = document.getElementById('sum-storage-val');
      if (ssVal) ssVal.textContent = formatCLP(totalStorage);

      const soDisp = document.getElementById('sum-orders-display');
      if (soDisp) soDisp.textContent = currentOrders;
      const spSub = document.getElementById('sum-pickpack-sub');
      if (spSub) spSub.textContent = `${formatCLP(unitPickPack)} / pedido${isProtected ? ' (Venta Protegida)' : ''}`;
      const spVal = document.getElementById('sum-pickpack-val');
      if (spVal) spVal.textContent = formatCLP(totalPickPack);

      // Costo Fijo Mensual
      const ffSub = document.getElementById('sum-fixedfee-sub');
      const ffVal = document.getElementById('sum-fixedfee-val');
      if (ffSub) ffSub.textContent = fixedFeeReason;
      if (ffVal) {
        if (fixedFeeExempt) {
          ffVal.textContent = '$0 (Exento)';
          ffVal.className = 'stocka-cot-exempt-pill';
        } else {
          ffVal.textContent = formatCLP(fixedFeeCLP);
          ffVal.className = '';
        }
      }

      const rmBadge = document.getElementById('cot-rm-pct-badge');
      if (rmBadge) rmBadge.textContent = `${rmPercentage}% RM`;
      const rmTxt = document.getElementById('cot-rm-orders-text');
      if (rmTxt) rmTxt.textContent = `${rmOrders} pedidos`;
      const regTxt = document.getElementById('cot-reg-orders-text');
      if (regTxt) regTxt.textContent = `${regOrders} pedidos`;
      const regHint = document.getElementById('cot-reg-rate-hint');
      if (regHint) {
        regHint.textContent = includeRegional
          ? `Envíame ${formatCLP(RATES.enviame_fee)} + flete ~${formatCLP(regBracket.avg_rate)}/env.`
          : `No incluido en el total (solo referencial)`;
      }

      const rowShipping = document.getElementById('sum-row-shipping');
      const sumRmOrdersCount = document.getElementById('sum-rm-orders-count');
      if (rowShipping) {
        if (includeSameDay && rmOrders > 0) {
          rowShipping.style.display = 'flex';
          if (sumRmOrdersCount) sumRmOrdersCount.textContent = rmOrders;
          document.getElementById('sum-shipping-val').textContent = formatCLP(totalRmShipping);
        } else {
          rowShipping.style.display = 'none';
        }
      }

      const rowRegional = document.getElementById('sum-row-regional');
      if (rowRegional) {
        if (totalRegShipping > 0) {
          rowRegional.style.display = 'flex';
          const cntEl = document.getElementById('sum-reg-orders-count');
          if (cntEl) cntEl.textContent = regOrders;
          const subEl = document.getElementById('sum-regional-sub');
          if (subEl) subEl.textContent = `${regBracket.label} · Envíame ${formatCLP(RATES.enviame_fee)} + flete ~${formatCLP(regBracket.avg_rate)}`;
          document.getElementById('sum-regional-val').textContent = formatCLP(totalRegShipping);
        } else {
          rowRegional.style.display = 'none';
        }
      }

      const rowExtra = document.getElementById('sum-row-extra');
      if (rowExtra) {
        if (totalExtrasAndSpecial > 0) {
          rowExtra.style.display = 'flex';
          const extraTags = [];
          if (colinaOrders > 0) extraTags.push(`${colinaOrders} Colina`);
          if (expressPickups > 0) extraTags.push(`${expressPickups} Express`);
          if (mlFullUnits > 0) extraTags.push(`${mlFullUnits} FULL`);
          if (inboundLabelUnits > 0) extraTags.push(`${inboundLabelUnits} Etiq. ing.`);
          if (costUnloading > 0) extraTags.push(`Descarga ${unloadingM3}m³`);
          if (costSupplies > 0) extraTags.push(`Insumos`);
          if (includeVitrina) extraTags.push(`Vitrina`);
          if (includePOS) extraTags.push(`POS`);
          const extraSub = document.getElementById('sum-extra-sub');
          if (extraSub) extraSub.textContent = extraTags.join(' · ') || 'Opcionales seleccionados';
          document.getElementById('sum-extra-val').textContent = formatCLP(totalExtrasAndSpecial);
        } else {
          rowExtra.style.display = 'none';
        }
      }

      const stClp = document.getElementById('sum-total-clp');
      if (stClp) stClp.textContent = formatCLP(totalCost);
      const stUf = document.getElementById('sum-total-uf');
      if (stUf) stUf.textContent = `~ ${totalUF} UF + IVA`;
      const stIva = document.getElementById('sum-total-iva');
      if (stIva) stIva.innerHTML = `+ IVA 19% (${formatCLP(totalIVA)}) = <strong>${formatCLP(totalGross)} IVA Inc.</strong>`;
      const stUnit = document.getElementById('sum-cost-per-order');
      if (stUnit) stUnit.textContent = `${formatCLP(costPerOrder)} + IVA`;

      const mobTotal = document.getElementById('cot-mobile-bar-total');
      if (mobTotal) mobTotal.textContent = formatCLP(totalCost);
      const mobMeta = document.getElementById('cot-mobile-bar-meta');
      if (mobMeta) mobMeta.textContent = `Subtotal Neto · Rango ${tier.id}`;

      window.dispatchEvent(new Event('stocka-cot-recalc'));
    }

    function syncLiveConfigAndUf() {
      // 1. Live UF from mindicador.cl (non-blocking)
      fetch('https://mindicador.cl/api/uf')
        .then(r => r.ok ? r.json() : null)
        .then(data => {
          const val = data && data.serie && data.serie[0] && data.serie[0].valor;
          if (val && !isNaN(val) && val > 30000) {
            UF_VALUE = Math.round(parseFloat(val));
            calculate();
          }
        })
        .catch(() => {});

      // 2. Live Supabase pricing_config
      fetch(SUPABASE_URL + '/rest/v1/pricing_config?config_key=eq.current_rates&select=data', {
        headers: { apikey: SUPABASE_ANON_KEY, Authorization: 'Bearer ' + SUPABASE_ANON_KEY }
      })
        .then(r => r.ok ? r.json() : null)
        .then(rows => {
          const cfg = Array.isArray(rows) && rows[0] && rows[0].data ? rows[0].data : null;
          if (!cfg) return;
          if (Array.isArray(cfg.order_ranges) && cfg.order_ranges.length > 0) {
            TIERS = cfg.order_ranges.map(r => ({
              id: r.id, min: r.min, max: r.max,
              label: `Rango ${r.id}: ${r.label}`,
              storage: r.storage_m3, pickpack: r.pick_pack_base
            }));
          }
          if (Array.isArray(cfg.storage_discounts) && cfg.storage_discounts.length > 0) {
            STORAGE_DISCOUNTS = cfg.storage_discounts;
            const chipsBox = document.getElementById('cot-discount-scale-chips');
            if (chipsBox) {
              chipsBox.innerHTML = STORAGE_DISCOUNTS.map(d => {
                const rng = d.max >= 999999 ? `+${Math.floor(d.min)} m³` : `${d.min}–${d.max} m³`;
                return `<span class="stocka-cot-disc-chip" data-min="${d.min}" data-max="${d.max}"><span>${rng}</span><strong>${d.discount_pct}%</strong></span>`;
              }).join('');
            }
          }
          if (cfg.pick_pack_rules) {
            RULES = Object.assign({}, RULES, cfg.pick_pack_rules);
          }
          if (cfg.fixed_service_fee) {
            FIXED_FEE = Object.assign({}, FIXED_FEE, cfg.fixed_service_fee);
          }
          if (cfg.shipping) {
            if (cfg.shipping.same_day_rm) RATES.same_day_rm = cfg.shipping.same_day_rm;
            if (cfg.shipping.colina) RATES.colina = cfg.shipping.colina;
            if (cfg.shipping.enviame_integration_fee) RATES.enviame_fee = cfg.shipping.enviame_integration_fee;
            if (cfg.shipping.pickup_express_base) RATES.pickup_express = cfg.shipping.pickup_express_base;
          }
          if (cfg.services) {
            if (cfg.services.pos_monthly_uf) RATES.pos_uf = cfg.services.pos_monthly_uf;
            if (cfg.services.vitrina_monthly_uf) RATES.vitrina_uf = cfg.services.vitrina_monthly_uf;
            if (cfg.services.unloading_service_uf_per_m3) RATES.unloading_uf_m3 = cfg.services.unloading_service_uf_per_m3;
            if (cfg.services.unloading_service_cap_uf) RATES.unloading_cap_uf = cfg.services.unloading_service_cap_uf;
            if (cfg.services.inbound_labeling_per_unit) RULES.inbound_labeling_per_unit = cfg.services.inbound_labeling_per_unit;
          }
          if (cfg.supplies) {
            if (cfg.supplies.bubble_wrap_roll && cfg.supplies.bubble_wrap_roll.cost_per_linear_m) {
              RATES.bubble_linear_m = cfg.supplies.bubble_wrap_roll.cost_per_linear_m;
            }
            if (cfg.supplies.box_s) RATES.box_s = cfg.supplies.box_s;
            if (cfg.supplies.box_m) RATES.box_m = cfg.supplies.box_m;
          }
          if (cfg.regional_shipping && Array.isArray(cfg.regional_shipping.weight_brackets)) {
            cfg.regional_shipping.weight_brackets.forEach(wb => {
              if (wb && wb.id && wb.avg_rate) {
                REGIONAL_BRACKETS[wb.id] = { label: wb.label || wb.id, avg_rate: wb.avg_rate };
              }
            });
          }
          calculate();
        })
        .catch(() => {});
    }

