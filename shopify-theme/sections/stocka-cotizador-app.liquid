<script>
  (function() {
    const UF_VALUE = 40867;
    const TIERS = [
      { id: 1, min: 0, max: 25, label: "Rango 1: 0 a 25 pedidos", storage: 48900, pickpack: 1250 },
      { id: 2, min: 26, max: 100, label: "Rango 2: 26 a 100 pedidos", storage: 43500, pickpack: 1200 },
      { id: 3, min: 101, max: 200, label: "Rango 3: 101 a 200 pedidos", storage: 38500, pickpack: 1150 },
      { id: 4, min: 201, max: 500, label: "Rango 4: 201 a 500 pedidos", storage: 33500, pickpack: 1050 },
      { id: 5, min: 501, max: 1500, label: "Rango 5: 501 a 1.500 pedidos", storage: 30500, pickpack: 950 },
      { id: 6, min: 1501, max: 2500, label: "Rango 6: 1.501 a 2.500 pedidos", storage: 28500, pickpack: 900 },
      { id: 7, min: 2501, max: 999999, label: "Rango 7: +2.500 pedidos (Enterprise)", storage: 26500, pickpack: 850 }
    ];

    let currentOrders = 60;
    let currentVol = 2.0;
    let includeSameDay = true;
    let rmPercentage = 75;
    let includeVitrina = false;
    let includePOS = false;

    function formatCLP(val) {
      return '$' + Math.round(val).toLocaleString('es-CL');
    }

    function calculate() {
      const tier = TIERS.find(t => currentOrders >= t.min && currentOrders <= t.max) || TIERS[0];
      
      let storageDiscountPct = 0;
      if (currentVol >= 60.0) storageDiscountPct = 0.32;
      else if (currentVol >= 35.0) storageDiscountPct = 0.27;
      else if (currentVol >= 25.0) storageDiscountPct = 0.24;
      else if (currentVol >= 15.0) storageDiscountPct = 0.21;
      else if (currentVol >= 10.0) storageDiscountPct = 0.18;

      const effectiveStorageRate = tier.storage * (1 - storageDiscountPct);
      const totalStorage = currentVol * effectiveStorageRate;
      const totalPickPack = currentOrders * tier.pickpack;
      const rmOrders = includeSameDay ? Math.round(currentOrders * (rmPercentage / 100)) : 0;
      const regOrders = currentOrders - rmOrders;
      const totalShipping = rmOrders * 3200;

      let extraUF = 0;
      if (includeVitrina) extraUF += 0.6;
      if (includePOS) extraUF += 0.2;
      const totalExtra = extraUF * UF_VALUE;

      const totalCost = totalStorage + totalPickPack + totalShipping + totalExtra;
      const totalUF = (totalCost / UF_VALUE).toFixed(2);

      const tBadge = document.getElementById('stocka-tier-badge');
      if (tBadge) tBadge.textContent = tier.label;
      const tName = document.getElementById('cot-tier-name');
      if (tName) tName.textContent = tier.label + "/mes";
      const tPick = document.getElementById('cot-tier-pickpack');
      if (tPick) tPick.textContent = formatCLP(tier.pickpack);
      const tStore = document.getElementById('cot-tier-storage');
      if (tStore) tStore.textContent = formatCLP(tier.storage);

      const nextTierIndex = TIERS.findIndex(t => t.id === tier.id) + 1;
      const nextTierBar = document.getElementById('cot-next-tier-bar');
      if (nextTierBar) {
        if (nextTierIndex < TIERS.length) {
          const nextTier = TIERS[nextTierIndex];
          const ordersNeeded = nextTier.min - currentOrders;
          document.getElementById('cot-next-tier-text').innerHTML = `¡Agrega <strong>${ordersNeeded} pedidos</strong> más para desbloquear el Rango ${nextTier.id} y pagar <strong>${formatCLP(nextTier.pickpack)}</strong> por pedido!`;
          nextTierBar.style.display = 'flex';
        } else {
          nextTierBar.style.display = 'none';
        }
      }

      const discBadge = document.getElementById('stocka-storage-discount-badge');
      if (discBadge) {
        if (storageDiscountPct > 0) {
          discBadge.textContent = `${Math.round(storageDiscountPct * 100)}% de descuento por volumen`;
          discBadge.style.display = 'inline-block';
        } else {
          discBadge.style.display = 'none';
        }
      }

      const svDisp = document.getElementById('sum-vol-display');
      if (svDisp) svDisp.textContent = currentVol.toFixed(1);
      const ssVal = document.getElementById('sum-storage-val');
      if (ssVal) ssVal.textContent = formatCLP(totalStorage);
      const soDisp = document.getElementById('sum-orders-display');
      if (soDisp) soDisp.textContent = currentOrders;
      const spVal = document.getElementById('sum-pickpack-val');
      if (spVal) spVal.textContent = formatCLP(totalPickPack);

      const rmBadge = document.getElementById('cot-rm-pct-badge');
      if (rmBadge) rmBadge.textContent = `${rmPercentage}% RM`;
      const rmTxt = document.getElementById('cot-rm-orders-text');
      if (rmTxt) rmTxt.textContent = `${rmOrders} pedidos`;
      const regTxt = document.getElementById('cot-reg-orders-text');
      if (regTxt) regTxt.textContent = `${regOrders} pedidos`;

      const rowShipping = document.getElementById('sum-row-shipping');
      const sumRmOrdersCount = document.getElementById('sum-rm-orders-count');
      if (rowShipping) {
        if (includeSameDay && rmOrders > 0) {
          rowShipping.style.display = 'flex';
          if (sumRmOrdersCount) sumRmOrdersCount.textContent = rmOrders;
          document.getElementById('sum-shipping-val').textContent = formatCLP(totalShipping);
        } else {
          rowShipping.style.display = 'none';
        }
      }

      const rowExtra = document.getElementById('sum-row-extra');
      if (rowExtra) {
        if (totalExtra > 0) {
          rowExtra.style.display = 'flex';
          document.getElementById('sum-extra-val').textContent = formatCLP(totalExtra);
        } else {
          rowExtra.style.display = 'none';
        }
      }

      const stClp = document.getElementById('sum-total-clp');
      if (stClp) stClp.textContent = formatCLP(totalCost);
      const stUf = document.getElementById('sum-total-uf');
      if (stUf) stUf.textContent = `~ ${totalUF} UF + IVA`;
    }

    function init() {
      const ordersSlider = document.getElementById('cot-orders-slider');
      const ordersNum = document.getElementById('cot-orders-num');
      const volSlider = document.getElementById('cot-vol-slider');
      const volNum = document.getElementById('cot-vol-num');

      if (!ordersSlider) return;

      ordersSlider.oninput = () => {
        currentOrders = parseInt(ordersSlider.value, 10) || 0;
        ordersNum.value = currentOrders;
        document.querySelectorAll('.stocka-cot-presets button[data-orders]').forEach(b => {
          b.classList.toggle('active', parseInt(b.dataset.orders, 10) === currentOrders);
        });
        calculate();
      };
      ordersNum.oninput = () => {
        currentOrders = Math.max(0, parseInt(ordersNum.value, 10) || 0);
        ordersSlider.value = Math.min(3000, currentOrders);
        calculate();
      };
      document.querySelectorAll('.stocka-cot-presets button[data-orders]').forEach(btn => {
        btn.onclick = () => {
          currentOrders = parseInt(btn.dataset.orders, 10);
          ordersSlider.value = currentOrders;
          ordersNum.value = currentOrders;
          document.querySelectorAll('.stocka-cot-presets button[data-orders]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          calculate();
        };
      });

      volSlider.oninput = () => {
        currentVol = parseFloat(volSlider.value) || 0.5;
        volNum.value = currentVol.toFixed(1);
        calculate();
      };
      volNum.oninput = () => {
        currentVol = Math.max(0.5, parseFloat(volNum.value) || 0.5);
        volSlider.value = Math.min(30, currentVol);
        calculate();
      };
      document.querySelectorAll('.stocka-cot-presets button[data-vol]').forEach(btn => {
        btn.onclick = () => {
          currentVol = parseFloat(btn.dataset.vol);
          volSlider.value = currentVol;
          volNum.value = currentVol.toFixed(1);
          document.querySelectorAll('.stocka-cot-presets button[data-vol]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          calculate();
        };
      });

      document.querySelectorAll('#cot-channels-group .stocka-cot-channel-item').forEach(item => {
        item.onclick = () => item.classList.toggle('active');
      });

      const rmSlider = document.getElementById('cot-rm-slider');
      const rmContainer = document.getElementById('cot-rm-slider-container');
      if (rmSlider) {
        rmSlider.oninput = () => {
          rmPercentage = parseInt(rmSlider.value, 10) || 0;
          document.querySelectorAll('.stocka-cot-presets button[data-rm]').forEach(b => {
            b.classList.toggle('active', parseInt(b.dataset.rm, 10) === rmPercentage);
          });
          calculate();
        };
        document.querySelectorAll('.stocka-cot-presets button[data-rm]').forEach(btn => {
          btn.onclick = () => {
            rmPercentage = parseInt(btn.dataset.rm, 10);
            rmSlider.value = rmPercentage;
            document.querySelectorAll('.stocka-cot-presets button[data-rm]').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            calculate();
          };
        });
      }

      const swSameDay = document.getElementById('cot-switch-sameday');
      if (swSameDay) {
        swSameDay.onclick = () => {
          includeSameDay = !includeSameDay;
          swSameDay.classList.toggle('active', includeSameDay);
          if (rmContainer) rmContainer.style.display = includeSameDay ? 'block' : 'none';
          calculate();
        };
      }

      const swVitrina = document.getElementById('cot-switch-vitrina');
      if (swVitrina) {
        swVitrina.onclick = () => {
          includeVitrina = !includeVitrina;
          swVitrina.classList.toggle('active', includeVitrina);
          calculate();
        };
      }

      const swPOS = document.getElementById('cot-switch-pos');
      if (swPOS) {
        swPOS.onclick = () => {
          includePOS = !includePOS;
          swPOS.classList.toggle('active', includePOS);
          calculate();
        };
      }

      
      // ========================================================
      // INTERACTIVE COURIER RATE SHOWCASE LOGIC
      // ========================================================
      const COURIER_DATA = {
        starken: {
          name: "Starken",
          desc: "<strong>Starken:</strong> Mayor conveniencia en tarifas para ecommerce. Entrega a domicilio o retiro en sucursales a lo largo de todo Chile.",
          transit: "⏱️ 1 a 2 días hábiles",
          bannerClass: "banner-starken",
          badgeColor: "#059669",
          badgeBg: "#ecfdf5",
          badgeBorder: "#d1fae5",
          badgeText: "Starken Express",
          rates: {
            valparaiso: "~$3.335",
            rancagua: "~$3.290",
            coquimbo: "~$3.748",
            concepcion: "~$4.174",
            puerto_montt: "~$4.223",
            antofagasta: "~$5.294"
          }
        },
        blue: {
          name: "Blue Express",
          desc: "<strong>Blue Express:</strong> Amplia red de Puntos Pick-Up y rápida cobertura domiciliaria nacional.",
          transit: "⏱️ 1 a 2 días hábiles",
          bannerClass: "banner-blue",
          badgeColor: "#0284c7",
          badgeBg: "#f0f9ff",
          badgeBorder: "#bae6fd",
          badgeText: "Blue Express",
          rates: {
            valparaiso: "~$3.490",
            rancagua: "~$3.450",
            coquimbo: "~$3.920",
            concepcion: "~$4.350",
            puerto_montt: "~$4.480",
            antofagasta: "~$5.580"
          }
        },
        chilexpress: {
          name: "Chilexpress",
          desc: "<strong>Chilexpress:</strong> Máxima prioridad, alta frecuencia y velocidad de entrega nacional día siguiente.",
          transit: "⏱️ Día Siguiente / Express",
          bannerClass: "banner-chilexpress",
          badgeColor: "#b91c1c",
          badgeBg: "#fef2f2",
          badgeBorder: "#fecaca",
          badgeText: "Chilexpress Prioritario",
          rates: {
            valparaiso: "~$3.890",
            rancagua: "~$3.850",
            coquimbo: "~$4.390",
            concepcion: "~$4.790",
            puerto_montt: "~$4.950",
            antofagasta: "~$6.190"
          }
        },
        correos: {
          name: "CorreosChile",
          desc: "<strong>CorreosChile:</strong> Máxima cobertura geográfica en zonas rurales, extremas y de difícil acceso.",
          transit: "⏱️ 2 a 3 días hábiles",
          bannerClass: "banner-correos",
          badgeColor: "#334155",
          badgeBg: "#f8fafc",
          badgeBorder: "#e2e8f0",
          badgeText: "Correos Cobertura Total",
          rates: {
            valparaiso: "~$3.650",
            rancagua: "~$3.590",
            coquimbo: "~$4.120",
            concepcion: "~$4.480",
            puerto_montt: "~$4.690",
            antofagasta: "~$5.790"
          }
