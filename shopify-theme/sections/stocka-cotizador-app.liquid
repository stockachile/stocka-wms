      // ========================================================
      // ROBUST STICKY SCROLL ENGINE FOR SUMMARY CARD
      // ========================================================
      function initStickyScroll() {
        const grid = document.querySelector('.stocka-cot-grid');
        const summaryCol = document.querySelector('.stocka-cot-summary-col');
        const summaryCard = document.querySelector('.stocka-cot-summary-card');
        const controlsCol = document.querySelector('.stocka-cot-controls-col');

        if (!grid || !summaryCard) return;

        let ticking = false;

        function updateStickyPosition() {
          ticking = false;

          // Only float on desktop viewports (>= 1024px) where columns are side-by-side
          if (window.innerWidth < 1024) {
            summaryCard.style.transform = 'none';
            return;
          }

          const headerOffset = 154; // Height of Shopify navbar + floating step nav + buffer
          const gridRect = grid.getBoundingClientRect();
          const cardHeight = summaryCard.offsetHeight;
          const totalHeight = controlsCol ? controlsCol.offsetHeight : (summaryCol ? summaryCol.offsetHeight : 0);
          const maxTranslate = Math.max(0, totalHeight - cardHeight);

          if (gridRect.top < headerOffset) {
            const targetY = headerOffset - gridRect.top;
            const clampedY = Math.min(maxTranslate, Math.max(0, targetY));
            summaryCard.style.transform = 'translateY(' + clampedY + 'px)';
          } else {
            summaryCard.style.transform = 'translateY(0px)';
          }
        }

        function onScrollOrResize() {
          if (!ticking) {
            requestAnimationFrame(updateStickyPosition);
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScrollOrResize, { passive: true });
        window.addEventListener('resize', onScrollOrResize, { passive: true });

        // Update when user interacts with sliders/options that might resize steps
        window.addEventListener('stocka-cot-recalc', onScrollOrResize);

        // Initial trigger
        updateStickyPosition();
      }

      // Floating sticky step nav bar + deterministic scroll-spy
      function initFloatingStepNav() {
        const floatSlot = document.getElementById('cot-float-nav-slot');
        const floatNav = document.getElementById('cot-float-nav');
        if (!floatSlot || !floatNav) return;

        const pills = Array.from(floatNav.querySelectorAll('.stocka-cot-nav-pill[data-cot-target]'));
        const targets = pills
          .map(p => ({ id: p.dataset.cotTarget, pill: p, el: document.getElementById(p.dataset.cotTarget) }))
          .filter(t => t.el);

        let navTicking = false;
        function measureHeaderHeight() {
          const hdr = document.querySelector('header.sf-header__desktop, header.sf-header__mobile, section.sf-header');
          if (hdr) {
            const h = hdr.getBoundingClientRect().height;
            if (h > 30 && h < 140) return Math.round(h);
          }
          return window.innerWidth <= 768 ? 64 : 76;
        }
        function setActivePill(activeId) {
          pills.forEach(p => {
            const isNow = p.dataset.cotTarget === activeId;
            const was = p.classList.contains('active');
            p.classList.toggle('active', isNow);
            if (isNow && !was && floatNav.scrollWidth > floatNav.clientWidth + 4) {
              const targetLeft = p.offsetLeft - (floatNav.clientWidth / 2) + (p.offsetWidth / 2);
              floatNav.scrollTo({ left: Math.max(0, targetLeft), behavior: 'smooth' });
            }
          });
        }
        pills.forEach(p => p.addEventListener('click', () => setActivePill(p.dataset.cotTarget)));

        function syncNav() {
          navTicking = false;
          const navTop = measureHeaderHeight() + 10;
          floatNav.style.setProperty('--stocka-nav-top', navTop + 'px');
          floatNav.classList.toggle('is-floating', floatSlot.getBoundingClientRect().top <= navTop);

          if (targets.length > 0) {
            const offsetLine = navTop + 95;
            let currentId = targets[0].id;
            for (let i = 0; i < targets.length; i++) {
              if (targets[i].el.getBoundingClientRect().top <= offsetLine) {
                currentId = targets[i].id;
              }
            }
            setActivePill(currentId);
          }
        }
        function onNavScroll() {
          if (!navTicking) {
            navTicking = true;
            requestAnimationFrame(syncNav);
          }
        }
        window.addEventListener('scroll', onNavScroll, { passive: true });
        window.addEventListener('resize', onNavScroll, { passive: true });
        syncNav();
      }

      // Auto-hide mobile bottom summary bar when real summary card is visible
      function initMobileSummaryBar() {
        const mobileBar = document.getElementById('cot-mobile-sticky-bar');
        const summaryCard = document.getElementById('cot-summary-card');
        if (mobileBar && summaryCard && 'IntersectionObserver' in window) {
          const obs = new IntersectionObserver(entries => {
            entries.forEach(entry => mobileBar.classList.toggle('is-hidden', entry.isIntersecting));
          }, { threshold: 0.15 });
          obs.observe(summaryCard);
        }
      }

      initStickyScroll();
      initFloatingStepNav();
      initMobileSummaryBar();

      calculate();
      syncLiveConfigAndUf();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
