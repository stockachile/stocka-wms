      };

      function updateCourierUI(courierKey) {
        const data = COURIER_DATA[courierKey] || COURIER_DATA.starken;
        
        // Update active tab button
        document.querySelectorAll('.stocka-courier-tab-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.courier === courierKey);
        });

        // Update banner
        const banner = document.getElementById('stocka-courier-info-banner');
        if (banner) {
          banner.className = 'stocka-courier-banner ' + data.bannerClass;
        }
        const descText = document.getElementById('stocka-courier-desc-text');
        if (descText) {
          descText.innerHTML = data.desc;
        }
        const transitTag = document.getElementById('stocka-courier-transit-tag');
        if (transitTag) {
          transitTag.textContent = data.transit;
        }

        // Update each rate card with animation
        Object.keys(data.rates).forEach(dest => {
          const priceEl = document.querySelector(`[data-dest="${dest}"]`);
          const tagEl = document.querySelector(`[data-dest-tag="${dest}"]`);
          if (priceEl) {
            priceEl.style.opacity = '0.3';
            priceEl.style.transform = 'scale(0.95)';
            setTimeout(() => {
              priceEl.textContent = data.rates[dest];
              priceEl.style.opacity = '1';
              priceEl.style.transform = 'scale(1)';
            }, 100);
          }
          if (tagEl) {
            tagEl.textContent = data.badgeText;
            tagEl.style.color = data.badgeColor;
            tagEl.style.background = data.badgeBg;
            tagEl.style.borderColor = data.badgeBorder;
          }
        });
      }

      document.querySelectorAll('.stocka-courier-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          updateCourierUI(btn.dataset.courier);
        });
      });

      const modal = document.getElementById('stocka-cot-modal');
      const openModalBtn = document.getElementById('cot-open-modal-btn');
      const closeModalBtn = document.getElementById('stocka-cot-modal-close-btn');

      if (openModalBtn && modal) {
        openModalBtn.onclick = () => {
          const sumOrders = document.getElementById('modal-sum-orders');
          const sumStorage = document.getElementById('modal-sum-storage');
          const sumTotal = document.getElementById('modal-sum-total');
          const sumTier = document.getElementById('modal-sum-tier');
          
          if (sumOrders) sumOrders.textContent = `${currentOrders.toLocaleString('es-CL')} ped/mes`;
          if (sumStorage) sumStorage.textContent = `${currentVol.toFixed(1).replace('.', ',')} m³`;
          if (sumTotal) sumTotal.textContent = document.getElementById('sum-total-clp').textContent;
          if (sumTier) {
            const tierEl = document.getElementById('cot-tier-name');
            if (tierEl) sumTier.textContent = tierEl.textContent.split(':')[0];
          }

          modal.style.display = 'flex';
        };
      }
      if (closeModalBtn && modal) {
        closeModalBtn.onclick = () => { modal.style.display = 'none'; };
      }
      if (modal) {
        modal.onclick = (e) => {
          if (e.target === modal) modal.style.display = 'none';
        };
      }

      const leadForm = document.getElementById('stocka-cot-lead-form');
      if (leadForm) {
        leadForm.onsubmit = async (e) => {
          e.preventDefault();
          const name = document.getElementById('cot-lead-name').value.trim();
          const email = document.getElementById('cot-lead-email').value.trim();
          const phone = document.getElementById('cot-lead-phone').value.trim();
          const company = document.getElementById('cot-lead-company').value.trim();
          const web = document.getElementById('cot-lead-web').value.trim();
          const notes = document.getElementById('cot-lead-notes').value.trim();
          const errorDiv = document.getElementById('cot-form-error');
          const submitBtn = document.getElementById('cot-submit-btn');
          const btnText = document.getElementById('cot-submit-btn-text');
          const spinner = document.getElementById('cot-submit-spinner');

          errorDiv.style.display = 'none';

          if (!name || !email || !phone || !company) {
            errorDiv.textContent = 'Por favor completa todos los campos requeridos (*).';
            errorDiv.style.display = 'block';
            return;
          }

          submitBtn.disabled = true;
          btnText.textContent = 'Generando cotización y enviando propuesta...';
          spinner.style.display = 'inline-block';

          const selectedChannels = Array.from(document.querySelectorAll('#cot-channels-group .stocka-cot-channel-item.active')).map(el => el.dataset.channel);

          const quoteDetailsNotes = `[COTIZADOR ONLINE 360]\n` +
            `Pedidos Mensuales: ${currentOrders}\n` +
            `Volumen Bodega: ${currentVol.toFixed(1)} m3\n` +
            `Canales: ${selectedChannels.join(', ') || 'No indicado'}\n` +
            `Same Day RM: ${includeSameDay ? `${rmPercentage}% (${Math.round(currentOrders * (rmPercentage / 100))} pedidos)` : 'No'}\n` +
            `Envíos a Regiones: ${currentOrders - (includeSameDay ? Math.round(currentOrders * (rmPercentage / 100)) : 0)} pedidos (vía couriers)\n` +
            `Vitrina / Showroom: ${includeVitrina ? 'Sí' : 'No'}\n` +
            `Punto de Venta POS: ${includePOS ? 'Sí' : 'No'}\n` +
            `Costo Estimado Mensual: ${document.getElementById('sum-total-clp').textContent} (${document.getElementById('sum-total-uf').textContent})\n` +
            `Comentarios: ${notes || 'Sin comentarios adicionales'}`;

          try {
            const res = await fetch('https://ejtjfaucnxbikrwjwwdu.supabase.co/functions/v1/submit-lead', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                contactName: name, email, phone, companyName: company, website: web,
                services: ['Fulfillment 360', 'Simulación Online'],
                monthlyVolume: `${currentOrders} pedidos/mes`,
                storageSpace: `${currentVol.toFixed(1)} m3`,
                notes: quoteDetailsNotes
              })
            });

            if (!res.ok) throw new Error('Error enviando la cotización.');

            document.getElementById('modal-form-view').style.display = 'none';
            document.getElementById('cot-success-name').textContent = name;
            document.getElementById('cot-success-email').textContent = email;
            document.getElementById('modal-success-view').style.display = 'block';

          } catch (err) {
            errorDiv.textContent = 'Ocurrió un error al enviar. Escríbenos directamente a contacto@stocka.cl';
            errorDiv.style.display = 'block';
            submitBtn.disabled = false;
            btnText.textContent = 'Confirmar y Enviar Cotización 🚀';
            spinner.style.display = 'none';
          }
        };
      }

      
      // ========================================================
      // ROBUST STICKY SCROLL ENGINE FOR SUMMARY CARD
      // ========================================================
      function initStickyScroll() {
        const grid = document.querySelector('.stocka-cot-grid');
        const summaryCol = document.querySelector('.stocka-cot-summary-col');
        const summaryCard = document.querySelector('.stocka-cot-summary-card');
        const controlsCol = document.querySelector('.stocka-cot-controls-col');

        if (!grid || !summaryCard) return;

        let ticking = false;

        function updateStickyPosition() {
          ticking = false;

          // Only float on desktop viewports (>= 1024px) where columns are side-by-side
          if (window.innerWidth < 1024) {
            summaryCard.style.transform = 'none';
            return;
          }

          const headerOffset = 100; // Height of theme navbar + buffer
          const gridRect = grid.getBoundingClientRect();
          const cardHeight = summaryCard.offsetHeight;
          const totalHeight = controlsCol ? controlsCol.offsetHeight : (summaryCol ? summaryCol.offsetHeight : 0);
          const maxTranslate = Math.max(0, totalHeight - cardHeight);

          if (gridRect.top < headerOffset) {
            const targetY = headerOffset - gridRect.top;
            const clampedY = Math.min(maxTranslate, Math.max(0, targetY));
            summaryCard.style.transform = 'translateY(' + clampedY + 'px)';
          } else {
            summaryCard.style.transform = 'translateY(0px)';
          }
        }

        function onScrollOrResize() {
          if (!ticking) {
            requestAnimationFrame(updateStickyPosition);
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScrollOrResize, { passive: true });
        window.addEventListener('resize', onScrollOrResize, { passive: true });

        // Update when user interacts with sliders/options that might resize steps
        window.addEventListener('stocka-cot-recalc', onScrollOrResize);

        // Initial trigger
        updateStickyPosition();
      }

      initStickyScroll();

      calculate();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
