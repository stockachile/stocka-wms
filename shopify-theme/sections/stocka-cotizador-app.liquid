{%- assign settings_bg_color = "#ffffff" -%}

<style>
  .stocka-cot-app-sec {
    background-color: #ffffff;
    padding: 3rem 1rem 5rem 1rem;
    font-family: inherit;
  }
  @media (min-width: 1024px) {
    .stocka-cot-app-sec {
      padding: 4.5rem 2rem 6rem 2rem;
    }
  }

  .stocka-cot-container {
    max-width: 100%;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .stocka-cot-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 1024px) {
    .stocka-cot-grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.95fr);
      gap: 2.25rem;
    }
  }

  .stocka-cot-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 24px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.04);
    position: relative;
  }
  @media (max-width: 767px) {
    .stocka-cot-card {
      padding: 1.5rem 1.25rem;
      border-radius: 18px;
    }
  }

  .stocka-cot-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .stocka-cot-step-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .stocka-cot-step-subtitle {
    font-size: 0.88rem;
    color: #64748b;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .stocka-cot-badge {
    background: rgba(92, 36, 255, 0.08);
    color: #5c24ff;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 700;
    border: 1px solid rgba(92, 36, 255, 0.15);
  }

  .stocka-cot-slider-wrap {
    margin: 1.5rem 0;
  }
  .stocka-cot-slider-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .stocka-cot-slider-label {
    font-size: 0.92rem;
    font-weight: 700;
    color: #1e293b;
  }
  .stocka-cot-value-box {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.4rem 0.85rem;
  }
  .stocka-cot-num-input {
    width: 75px;
    border: none;
    background: transparent;
    font-size: 1.15rem;
    font-weight: 800;
    color: #5c24ff;
    text-align: right;
    outline: none;
  }
  .stocka-cot-unit {
    font-size: 0.8rem;
    font-weight: 600;
    color: #64748b;
  }

  .stocka-cot-range {
    width: 100%;
    height: 8px;
    border-radius: 9999px;
    background: #e2e8f0;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
  }
  .stocka-cot-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #5c24ff;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(92, 36, 255, 0.4);
    transition: transform 0.15s ease;
  }
  .stocka-cot-range::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  .stocka-cot-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    align-items: center;
  }
  .stocka-cot-preset-btn {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.45rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .stocka-cot-preset-btn:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
  }
  .stocka-cot-preset-btn.active {
    background: #5c24ff;
    border-color: #5c24ff;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(92, 36, 255, 0.25);
  }

  .stocka-cot-tier-banner {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .stocka-cot-tier-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .stocka-cot-tier-info strong {
    display: block;
    font-size: 0.95rem;
    color: #0f172a;
  }
  .stocka-cot-tier-info span {
    font-size: 0.8rem;
    color: #64748b;
  }
  .stocka-cot-tier-rates {
    display: flex;
    gap: 1.25rem;
  }
  .stocka-cot-rate-badge {
    text-align: right;
  }
  .stocka-cot-rate-badge .lbl {
    font-size: 0.72rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
  }
  .stocka-cot-rate-badge .val {
    font-size: 1.1rem;
    font-weight: 800;
    color: #5c24ff;
  }

  .stocka-cot-next-tier {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e40af;
    border-radius: 12px;
    padding: 0.65rem 1rem;
    font-size: 0.84rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stocka-cot-channels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .stocka-cot-channel-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    color: #334155;
    transition: all 0.2s ease;
    user-select: none;
  }
  .stocka-cot-channel-item:hover {
    border-color: #cbd5e1;
  }
  .stocka-cot-channel-item.active {
    background: #f5f3ff;
    border-color: #5c24ff;
    color: #5c24ff;
  }

  .stocka-cot-switch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 14px;
    margin-bottom: 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .stocka-cot-switch-row:hover {
    border-color: #cbd5e1;
  }
  .stocka-cot-switch-row.active {
    background: #f5f3ff;
    border-color: #5c24ff;
  }
  .stocka-cot-switch-info h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.2rem 0;
  }
  .stocka-cot-switch-info p {
    font-size: 0.8rem;
    color: #64748b;
    margin: 0;
  }
  .stocka-cot-switch-price {
    font-size: 0.95rem;
    font-weight: 800;
    color: #5c24ff;
    white-space: nowrap;
  }

  .stocka-cot-summary-col {
    position: relative;
    height: 100%;
    min-height: 100%;
  }
  .stocka-cot-summary-card {
    background: #0f172a;
    color: #ffffff;
    border-radius: 28px;
    padding: 2.25rem 2rem;
    position: relative;
    z-index: 25;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.35);
    will-change: transform; transition: transform 0.05s linear;
  }
  @media (max-width: 1023px) {
    .stocka-cot-summary-card {
      position: static;
      transform: none !important;
      padding: 1.75rem 1.25rem;
      border-radius: 20px;
    }
  }
  @media (max-width: 767px) {
    .stocka-cot-summary-card {
      padding: 1.75rem 1.25rem;
      border-radius: 20px;
      position: static;
    }
  }

  .stocka-cot-sum-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .stocka-cot-sum-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .stocka-cot-sum-desc {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .stocka-cot-breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.88rem;
    padding: 0.6rem 0;
    color: #cbd5e1;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .stocka-cot-breakdown-row strong {
    color: #ffffff;
    font-weight: 700;
  }

  .stocka-cot-total-box {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: 1.5rem;
    margin: 1.75rem 0 1.5rem 0;
    text-align: center;
  }
  .stocka-cot-total-lbl {
    font-size: 0.8rem;
    font-weight: 700;
    color: #38bdf8;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.35rem;
  }
  .stocka-cot-total-clp {
    font-size: 2.2rem;
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
  }
  .stocka-cot-total-uf {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-top: 0.35rem;
  }

  .stocka-cot-btn-cta {
    background: linear-gradient(135deg, #5c24ff 0%, #a855f7 100%);
    color: #ffffff !important;
    font-weight: 800;
    font-size: 1.05rem;
    padding: 1.1rem 1.75rem;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    transition: all 0.25s ease;
    box-shadow: 0 10px 25px -5px rgba(92, 36, 255, 0.5);
    text-decoration: none !important;
  }
  .stocka-cot-btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px rgba(92, 36, 255, 0.6);
    background: linear-gradient(135deg, #6d3bff 0%, #b865ff 100%);
  }

  /* ========================================================
     MODAL POPUP STYLES (SaaS High-Conversion Design)
     ======================================================== */
  .stocka-cot-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    animation: stockaModalFadeIn 0.25s ease-out forwards;
  }
  @keyframes stockaModalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes stockaModalSlideUp {
    from { opacity: 0; transform: translateY(24px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .stocka-cot-modal-card {
    background: #ffffff;
    border-radius: 24px;
    padding: 2.25rem 2rem;
    max-width: 620px;
    width: 100%;
    position: relative;
    max-height: 92vh;
    overflow-y: auto;
    box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.35), 0 0 0 1px rgba(226, 232, 240, 0.8);
    animation: stockaModalSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @media (max-width: 767px) {
    .stocka-cot-modal-card {
      padding: 1.5rem 1.25rem;
      border-radius: 20px;
    }
  }
  .stocka-cot-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    transition: all 0.2s ease;
    z-index: 10;
    padding: 0;
  }
  .stocka-cot-modal-close:hover {
    background: #e2e8f0;
    color: #0f172a;
    transform: rotate(90deg);
  }
  .stocka-cot-modal-close svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 2.25;
    fill: none;
  }

  /* Header Badge & Typography */
  .stocka-modal-header {
    text-align: center;
    margin-bottom: 1.25rem;
  }
  .stocka-modal-icon-badge {
    width: 54px;
    height: 54px;
    margin: 0 auto 0.75rem auto;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(92, 36, 255, 0.12) 0%, rgba(129, 140, 248, 0.18) 100%);
    border: 1.5px solid rgba(92, 36, 255, 0.25);
    color: #5c24ff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 16px -4px rgba(92, 36, 255, 0.15);
  }
  .stocka-modal-icon-badge svg {
    width: 28px;
    height: 28px;
    stroke: currentColor;
    stroke-width: 1.9;
    fill: none;
  }
  .stocka-modal-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0 0 0.35rem 0;
    line-height: 1.25;
  }
  .stocka-modal-subtitle {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0 auto;
    max-width: 480px;
    line-height: 1.5;
  }

  /* Live Simulation Summary Box */
  .stocka-modal-summary-box {
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 0.85rem 1rem;
    margin-bottom: 1.35rem;
  }
  .stocka-modal-summary-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.55rem;
    margin-bottom: 0.55rem;
    border-bottom: 1px dashed #cbd5e1;
  }
  .stocka-modal-summary-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #5c24ff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stocka-modal-summary-badge svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }
  .stocka-modal-summary-tier {
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }
  .stocka-modal-summary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.25fr;
    gap: 0.5rem;
    text-align: center;
  }
  .stocka-modal-sum-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .stocka-modal-sum-label {
    font-size: 0.68rem;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .stocka-modal-sum-val {
    font-size: 0.92rem;
    font-weight: 800;
    color: #0f172a;
  }
  .stocka-modal-sum-val.highlight {
    color: #5c24ff;
  }

  /* Form Grid & Inputs */
  .stocka-modal-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }
  @media (max-width: 580px) {
    .stocka-modal-grid-2 {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
  .stocka-modal-field {
    margin-bottom: 0.85rem;
  }
  .stocka-modal-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.82rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.35rem;
  }
  .stocka-modal-label span.req {
    color: #ef4444;
  }
  .stocka-modal-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .stocka-modal-input-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: #94a3b8;
    pointer-events: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .stocka-modal-input-icon svg {
    width: 18px;
    height: 18px;
    display: block;
    stroke: currentColor;
    stroke-width: 1.9;
    fill: none;
  }
  .stocka-modal-input {
    width: 100% !important;
    padding: 0.75rem 0.9rem 0.75rem 2.85rem !important;
    font-size: 0.88rem !important;
    line-height: 1.4 !important;
    height: auto !important;
    color: #0f172a !important;
    background: #f8fafc !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 12px !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    font-family: inherit !important;
    box-sizing: border-box !important;
  }
  .stocka-modal-input:hover {
    border-color: #cbd5e1 !important;
    background: #ffffff !important;
  }
  .stocka-modal-input:focus {
    background: #ffffff !important;
    border-color: #5c24ff !important;
    outline: none !important;
    box-shadow: 0 0 0 4px rgba(92, 36, 255, 0.12) !important;
  }
  .stocka-modal-input-wrap:focus-within .stocka-modal-input-icon {
    color: #5c24ff;
  }
  .stocka-modal-input::placeholder {
    color: #94a3b8 !important;
    font-size: 0.85rem !important;
    opacity: 1 !important;
  }

  .stocka-modal-input-wrap.textarea-wrap {
    align-items: stretch;
  }
  .stocka-modal-input-wrap.textarea-wrap .stocka-modal-input-icon {
    top: 0.9rem;
    transform: none;
  }
  .stocka-modal-textarea {
    width: 100% !important;
    padding: 0.75rem 0.9rem 0.75rem 2.85rem !important;
    font-size: 0.88rem !important;
    line-height: 1.4 !important;
    color: #0f172a !important;
    background: #f8fafc !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 12px !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    font-family: inherit !important;
    resize: vertical !important;
    min-height: 60px !important;
    box-sizing: border-box !important;
  }
  .stocka-modal-textarea:hover {
    border-color: #cbd5e1 !important;
    background: #ffffff !important;
  }
  .stocka-modal-textarea:focus {
    background: #ffffff !important;
    border-color: #5c24ff !important;
    outline: none !important;
    box-shadow: 0 0 0 4px rgba(92, 36, 255, 0.12) !important;
  }
  .stocka-modal-textarea::placeholder {
    color: #94a3b8 !important;
    font-size: 0.85rem !important;
    opacity: 1 !important;
  }

  /* Submit Button */
  .stocka-modal-btn-submit {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #5c24ff 0%, #4338ca 100%);
    color: #ffffff !important;
    border: none;
    border-radius: 14px;
    padding: 0.95rem 1.75rem;
    font-size: 0.98rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 25px -5px rgba(92, 36, 255, 0.4);
    margin-top: 0.5rem;
    text-decoration: none !important;
  }
  .stocka-modal-btn-submit:hover {
    background: linear-gradient(135deg, #6d3aff 0%, #4f46e5 100%);
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -4px rgba(92, 36, 255, 0.5);
  }
  .stocka-modal-btn-submit:active {
    transform: translateY(0);
  }
  .stocka-modal-btn-submit:disabled {
    opacity: 0.75;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }
  .stocka-modal-btn-submit svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 2.2;
    fill: none;
  }

  /* Trust Strip */
  .stocka-modal-trust-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }
  .stocka-modal-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
  }
  .stocka-modal-trust-item svg {
    width: 14px;
    height: 14px;
    stroke: #10b981;
    stroke-width: 2.25;
    fill: none;
