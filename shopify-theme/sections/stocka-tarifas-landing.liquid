<script>
  (function() {
    const SUPABASE_URL = 'https://ejtjfaucnxbikrwjwwdu.supabase.co';
    const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVqdGpmYXVjbnhiaWtyd2p3d2R1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk4MzExODUsImV4cCI6MjA5NTQwNzE4NX0.cnuyxOpbqr-182Q3MJFJu0prtFSvwk1RgbiVBhjYUak';

    let WMS_TIERS = [
      { id: 1, min: 0, max: 25, label: "Rango 1: 0 a 25 pedidos", storage: 48900, pickpack: 1250, ordersLabel: "0 a 25 ped/mes" },
      { id: 2, min: 26, max: 100, label: "Rango 2: 26 a 100 pedidos", storage: 43500, pickpack: 1200, ordersLabel: "26 a 100 ped/mes" },
      { id: 3, min: 101, max: 200, label: "Rango 3: 101 a 200 pedidos", storage: 38500, pickpack: 1150, ordersLabel: "101 a 200 ped/mes" },
      { id: 4, min: 201, max: 500, label: "Rango 4: 201 a 500 pedidos", storage: 33500, pickpack: 1050, ordersLabel: "201 a 500 ped/mes" },
      { id: 5, min: 501, max: 1500, label: "Rango 5: 501 a 1.500 pedidos", storage: 30500, pickpack: 950, ordersLabel: "501 a 1.500 ped/mes" },
      { id: 6, min: 1501, max: 2500, label: "Rango 6: 1.501 a 2.500 pedidos", storage: 28500, pickpack: 900, ordersLabel: "1.501 a 2.500 ped/mes" },
      { id: 7, min: 2501, max: 3500, label: "Rango 7: 2.501 a 3.500 pedidos", storage: 26500, pickpack: 850, ordersLabel: "2.501 a 3.500 ped/mes" },
      { id: 8, min: 3501, max: 999999, label: "Rango 8: +3.500 pedidos (Enterprise+)", storage: 25500, pickpack: 800, ordersLabel: "+3.500 ped/mes" }
    ];
    let sameDayRate = 3200;

    function formatCLP(val) {
      return '$' + Math.round(val).toLocaleString('es-CL');
    }

    function initTarifasSection() {
      const rangeInput = document.getElementById('tf-orders-range');
      const activeBadge = document.getElementById('tf-tier-active-badge');
      const countText = document.getElementById('tf-orders-count-text');
      const storagePrice = document.getElementById('tf-card-storage-price');
      const storageSub = document.getElementById('tf-card-storage-sub');
      const pickpackPrice = document.getElementById('tf-card-pickpack-price');
      const pickpackSub = document.getElementById('tf-card-pickpack-sub');
      const shippingPrice = document.getElementById('tf-card-shipping-price');
      const storageHint = document.getElementById('tf-storage-tier-hint');
      const tramoBtns = document.querySelectorAll('.stocka-tf-tramo-btn');
      const tableBody = document.getElementById('tf-table-body');
      const toggleTableBtn = document.getElementById('tf-toggle-table-btn');
      const tableContainer = document.getElementById('tf-full-table-container');
      const chevron = document.getElementById('tf-table-chevron');

      function renderTable() {
        if (!tableBody) return;
        tableBody.innerHTML = WMS_TIERS.map(t => `
          <tr class="stocka-tf-table-row" data-tier="${t.id}" style="border-bottom: 1px solid #e2e8f0; transition: background 0.15s ease;">
            <td style="padding: 0.75rem 0.85rem; font-weight: 700;">Rango ${t.id}</td>
            <td style="padding: 0.75rem 0.85rem;">${t.ordersLabel}</td>
            <td style="padding: 0.75rem 0.85rem; font-weight: 700; color: #5c24ff;">${formatCLP(t.pickpack)}</td>
            <td style="padding: 0.75rem 0.85rem; font-weight: 700;">${formatCLP(t.storage)}</td>
            <td style="padding: 0.75rem 0.85rem;">${formatCLP(sameDayRate)} + IVA</td>
          </tr>
        `).join('');
      }

      function updateTierDisplay(orders) {
        let tier = WMS_TIERS.find(t => orders >= t.min && orders <= t.max) || WMS_TIERS[0];
        if (orders > WMS_TIERS[WMS_TIERS.length - 1].min) {
          tier = WMS_TIERS[WMS_TIERS.length - 1];
        }

        if (activeBadge) activeBadge.textContent = tier.label;
        if (countText) countText.textContent = `${orders.toLocaleString('es-CL')} pedidos / mes`;

        if (storagePrice) storagePrice.textContent = formatCLP(tier.storage);
        if (storageSub) storageSub.textContent = `Tarifa para ${tier.ordersLabel}`;

        if (pickpackPrice) pickpackPrice.textContent = formatCLP(tier.pickpack);
        if (pickpackSub) pickpackSub.textContent = `Tarifa para ${tier.ordersLabel}`;

        if (shippingPrice) shippingPrice.textContent = formatCLP(sameDayRate);

        // Update Live Unit Cost Banner
        const unitCostVal = document.getElementById('tf-unit-cost-val');
        const unitCostSub = document.getElementById('tf-unit-cost-sub');
        if (unitCostVal) {
          let estimatedVol = 1.0;
          if (orders > 3500) estimatedVol = 35.0;
          else if (orders > 2500) estimatedVol = 25.0;
          else if (orders > 1500) estimatedVol = 15.0;
          else if (orders > 500) estimatedVol = 8.0;
          else if (orders > 200) estimatedVol = 3.5;
          else if (orders > 100) estimatedVol = 2.0;

          const effectiveOrders = Math.max(1, orders);
          const storageShare = (estimatedVol * tier.storage) / effectiveOrders;
          const totalUnitFulfillment = tier.pickpack + storageShare;

          unitCostVal.textContent = formatCLP(totalUnitFulfillment);
          if (unitCostSub) {
            unitCostSub.textContent = `(Pick & Pack ${formatCLP(tier.pickpack)} + Custodia estimada ~${formatCLP(storageShare)})`;
          }
        }

        tramoBtns.forEach(btn => {
          btn.classList.toggle('active', parseInt(btn.dataset.tier, 10) === tier.id);
        });

        document.querySelectorAll('.stocka-tf-table-row').forEach(row => {
          row.classList.toggle('active', parseInt(row.dataset.tier, 10) === tier.id);
        });
      }

      renderTable();

      function updateSliderVisual() {
        if (!rangeInput) return;
        const min = parseFloat(rangeInput.min) || 0;
        const max = parseFloat(rangeInput.max) || 4000;
        const val = parseFloat(rangeInput.value) || 0;
        const pct = Math.max(0, Math.min(100, ((val - min) / (max - min)) * 100));
        rangeInput.style.setProperty('--slider-pct', pct + '%');
      }

      if (rangeInput) {
        rangeInput.addEventListener('input', () => {
          const orders = parseInt(rangeInput.value, 10) || 0;
          updateSliderVisual();
          updateTierDisplay(orders);
        });
      }

      tramoBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const orders = parseInt(btn.dataset.orders, 10);
          if (rangeInput) {
            rangeInput.value = orders;
            updateSliderVisual();
          }
          updateTierDisplay(orders);
        });
      });

      if (toggleTableBtn && tableContainer) {
        toggleTableBtn.addEventListener('click', () => {
          const isHidden = tableContainer.style.display === 'none';
          tableContainer.style.display = isHidden ? 'block' : 'none';
          if (chevron) chevron.style.transform = isHidden ? 'rotate(180deg)' : 'none';
        });
      }

      // Expand / Collapse all transparent conditions
      const btnToggleAllCond = document.getElementById('tf-btn-toggle-all-cond');
      if (btnToggleAllCond) {
        btnToggleAllCond.addEventListener('click', () => {
          const items = Array.from(document.querySelectorAll('#stocka-condiciones-anchor .stocka-tf-cond-card'));
          const allOpen = items.length > 0 && items.every(d => d.open);
          items.forEach(d => { d.open = !allOpen; });
          btnToggleAllCond.innerHTML = !allOpen
            ? '<span>Contraer todo</span><span>▲</span>'
            : '<span>Expandir todo</span><span>▼</span>';
        });
      }

      // Floating sticky section nav pill bar + deterministic scroll-spy
      const floatSlot = document.getElementById('tf-float-nav-slot');
      const floatNav = document.getElementById('tf-float-nav');
      const navPills = Array.from(document.querySelectorAll('#tf-float-nav .stocka-tf-nav-pill[data-tf-target]'));
      const navSections = navPills
        .map(pill => ({ id: pill.dataset.tfTarget, pill, el: document.getElementById(pill.dataset.tfTarget) }))
        .filter(item => item.el);

      if (floatSlot && floatNav) {
        let navTicking = false;
        function measureHeaderHeight() {
          const hdr = document.querySelector('header.sf-header__desktop, header.sf-header__mobile, section.sf-header');
          if (hdr) {
            const h = hdr.getBoundingClientRect().height;
            if (h > 30 && h < 140) return Math.round(h);
          }
          return window.innerWidth <= 768 ? 64 : 76;
        }
        function setActiveTfPill(activeId) {
          navPills.forEach(p => {
            const isNow = p.dataset.tfTarget === activeId;
            const was = p.classList.contains('active');
            p.classList.toggle('active', isNow);
            if (isNow && !was && floatNav.scrollWidth > floatNav.clientWidth + 4) {
              const targetLeft = p.offsetLeft - (floatNav.clientWidth / 2) + (p.offsetWidth / 2);
              floatNav.scrollTo({ left: Math.max(0, targetLeft), behavior: 'smooth' });
            }
          });
        }
        navPills.forEach(p => {
          p.addEventListener('click', () => setActiveTfPill(p.dataset.tfTarget));
        });
        function syncFloatingNav() {
          navTicking = false;
          const hdrH = measureHeaderHeight();
          const navTop = hdrH + 10;
          floatNav.style.setProperty('--stocka-nav-top', navTop + 'px');
          const slotTop = floatSlot.getBoundingClientRect().top;
          floatNav.classList.toggle('is-floating', slotTop <= navTop);

          if (navSections.length > 0) {
            const offsetLine = navTop + 90;
            let currentId = navSections[0].id;
            for (let i = 0; i < navSections.length; i++) {
              if (navSections[i].el.getBoundingClientRect().top <= offsetLine) {
                currentId = navSections[i].id;
              }
            }
            setActiveTfPill(currentId);
          }
        }
        function onNavScroll() {
          if (!navTicking) {
            navTicking = true;
            requestAnimationFrame(syncFloatingNav);
          }
        }
        window.addEventListener('scroll', onNavScroll, { passive: true });
        window.addEventListener('resize', onNavScroll, { passive: true });
        syncFloatingNav();
      }

      // Initialize with default Enterprise+ (lowest rates)
      updateSliderVisual();
      updateTierDisplay(3600);

      // Sync live rates & presentations from Supabase WMS pricing_config
      fetch(SUPABASE_URL + '/rest/v1/pricing_config?config_key=eq.current_rates&select=data', {
        headers: { apikey: SUPABASE_ANON_KEY, Authorization: 'Bearer ' + SUPABASE_ANON_KEY }
      })
        .then(r => r.ok ? r.json() : null)
        .then(rows => {
          const cfg = Array.isArray(rows) && rows[0] && rows[0].data ? rows[0].data : null;
          if (!cfg) return;
          if (Array.isArray(cfg.order_ranges) && cfg.order_ranges.length > 0) {
            WMS_TIERS = cfg.order_ranges.map(r => ({
              id: r.id,
              min: r.min,
              max: r.max,
              label: `Rango ${r.id}: ${r.label}`,
              storage: r.storage_m3,
              pickpack: r.pick_pack_base,
              ordersLabel: r.label
            }));
          }
          if (cfg.shipping && cfg.shipping.same_day_rm) {
            sameDayRate = cfg.shipping.same_day_rm;
          }
          if (Array.isArray(cfg.storage_discounts) && cfg.storage_discounts.length > 0 && storageHint) {
            const maxPct = Math.max(...cfg.storage_discounts.map(d => Number(d.discount_pct) || 0));
            if (maxPct > 0) storageHint.textContent = `Además hasta ${maxPct}% OFF adicional desde 10 m³`;
          }
          if (cfg.presentations) {
            const linkFul = document.getElementById('tf-pres-fulfillment-link');
            const linkDesp = document.getElementById('tf-pres-despachos-link');
            if (linkFul && cfg.presentations.fulfillment_url) linkFul.href = cfg.presentations.fulfillment_url;
            if (linkDesp && cfg.presentations.despachos_rm_url) linkDesp.href = cfg.presentations.despachos_rm_url;
          }
          renderTable();
          updateTierDisplay(parseInt(rangeInput ? rangeInput.value : 3600, 10) || 3600);
        })
        .catch(() => {});
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTarifasSection);
    } else {
      initTarifasSection();
    }
  })();
</script>

