<script>
  (function() {
    const WMS_TIERS = [
      { id: 1, min: 0, max: 100, label: "Rango 1: 0 a 100 pedidos", storage: 43500, pickpack: 1200, ordersLabel: "0 a 100 ped/mes" },
      { id: 2, min: 101, max: 250, label: "Rango 2: 101 a 250 pedidos", storage: 38500, pickpack: 1100, ordersLabel: "101 a 250 ped/mes" },
      { id: 3, min: 251, max: 350, label: "Rango 3: 251 a 350 pedidos", storage: 35500, pickpack: 1050, ordersLabel: "251 a 350 ped/mes" },
      { id: 4, min: 351, max: 500, label: "Rango 4: 351 a 500 pedidos", storage: 33500, pickpack: 1000, ordersLabel: "351 a 500 ped/mes" },
      { id: 5, min: 501, max: 1500, label: "Rango 5: 501 a 1.500 pedidos", storage: 30500, pickpack: 950, ordersLabel: "501 a 1.500 ped/mes" },
      { id: 6, min: 1501, max: 2500, label: "Rango 6: 1.501 a 2.500 pedidos", storage: 28500, pickpack: 900, ordersLabel: "1.501 a 2.500 ped/mes" },
      { id: 7, min: 2501, max: 999999, label: "Rango 7: +2.500 pedidos (Enterprise)", storage: 26500, pickpack: 850, ordersLabel: "+2.500 ped/mes" }
    ];

    function formatCLP(val) {
      return '$' + Math.round(val).toLocaleString('es-CL');
    }

    function initTarifasSection() {
      const rangeInput = document.getElementById('tf-orders-range');
      const activeBadge = document.getElementById('tf-tier-active-badge');
      const countText = document.getElementById('tf-orders-count-text');
      const storagePrice = document.getElementById('tf-card-storage-price');
      const storageSub = document.getElementById('tf-card-storage-sub');
      const pickpackPrice = document.getElementById('tf-card-pickpack-price');
      const pickpackSub = document.getElementById('tf-card-pickpack-sub');
      const tramoBtns = document.querySelectorAll('.stocka-tf-tramo-btn');
      const tableBody = document.getElementById('tf-table-body');
      const toggleTableBtn = document.getElementById('tf-toggle-table-btn');
      const tableContainer = document.getElementById('tf-full-table-container');
      const chevron = document.getElementById('tf-table-chevron');

      // Populate table rows
      if (tableBody) {
        tableBody.innerHTML = WMS_TIERS.map(t => `
          <tr class="stocka-tf-table-row" data-tier="${t.id}" style="border-bottom: 1px solid #e2e8f0; transition: background 0.15s ease;">
            <td style="padding: 0.75rem 0.85rem; font-weight: 700;">Rango ${t.id}</td>
            <td style="padding: 0.75rem 0.85rem;">${t.ordersLabel}</td>
            <td style="padding: 0.75rem 0.85rem; font-weight: 700; color: #5c24ff;">${formatCLP(t.pickpack)}</td>
            <td style="padding: 0.75rem 0.85rem; font-weight: 700;">${formatCLP(t.storage)}</td>
            <td style="padding: 0.75rem 0.85rem;">$3.200 + IVA</td>
          </tr>
        `).join('');
      }

      function updateTierDisplay(orders) {
        const tier = WMS_TIERS.find(t => orders >= t.min && orders <= t.max) || WMS_TIERS[0];

        if (activeBadge) activeBadge.textContent = tier.label;
        if (countText) countText.textContent = `${orders.toLocaleString('es-CL')} pedidos / mes`;

        if (storagePrice) storagePrice.textContent = formatCLP(tier.storage);
        if (storageSub) storageSub.textContent = `Tarifa para ${tier.ordersLabel}`;

        if (pickpackPrice) pickpackPrice.textContent = formatCLP(tier.pickpack);
        if (pickpackSub) pickpackSub.textContent = `Tarifa para ${tier.ordersLabel}`;

        // Update Live Unit Cost Banner (Idea 2)
        const unitCostVal = document.getElementById('tf-unit-cost-val');
        const unitCostSub = document.getElementById('tf-unit-cost-sub');
        if (unitCostVal) {
          let estimatedVol = 1.0;
          if (orders > 2500) estimatedVol = 25.0;
          else if (orders > 1500) estimatedVol = 15.0;
          else if (orders > 500) estimatedVol = 8.0;
          else if (orders > 250) estimatedVol = 3.5;
          else if (orders > 100) estimatedVol = 2.0;

          const effectiveOrders = Math.max(1, orders);
          const storageShare = (estimatedVol * tier.storage) / effectiveOrders;
          const totalUnitFulfillment = tier.pickpack + storageShare;

          unitCostVal.textContent = formatCLP(totalUnitFulfillment);
          if (unitCostSub) {
            unitCostSub.textContent = `(Pick & Pack ${formatCLP(tier.pickpack)} + Custodia estimada ~${formatCLP(storageShare)})`;
          }
        }

        tramoBtns.forEach(btn => {
          btn.classList.toggle('active', parseInt(btn.dataset.tier, 10) === tier.id);
        });

        // Highlight table row
        document.querySelectorAll('.stocka-tf-table-row').forEach(row => {
          row.classList.toggle('active', parseInt(row.dataset.tier, 10) === tier.id);
        });
      }

      if (rangeInput) {
        rangeInput.addEventListener('input', () => {
          const orders = parseInt(rangeInput.value, 10) || 0;
          updateTierDisplay(orders);
        });
      }

      tramoBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const orders = parseInt(btn.dataset.orders, 10);
          if (rangeInput) rangeInput.value = orders;
          updateTierDisplay(orders);
        });
      });

      if (toggleTableBtn && tableContainer) {
        toggleTableBtn.addEventListener('click', () => {
          const isHidden = tableContainer.style.display === 'none';
          tableContainer.style.display = isHidden ? 'block' : 'none';
          if (chevron) chevron.style.transform = isHidden ? 'rotate(180deg)' : 'none';
        });
      }

      // Initialize with default Enterprise (lowest rates)
      updateTierDisplay(3000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTarifasSection);
    } else {
      initTarifasSection();
    }
  })();
</script>

