    color: #0f172a;
    background: #f8fafc;
    padding-bottom: 5rem;
  }
  .stocka-mf-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  @media (min-width: 1024px) {
    .stocka-mf-container {
      padding: 0 2rem;
    }
  }

  /* Hero Section */
  .stocka-mf-hero {
    padding: 4.5rem 0 3.5rem 0;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, rgba(92, 36, 255, 0.08) 0%, rgba(248, 250, 252, 0) 75%);
    border-bottom: 1px solid #f1f5f9;
  }
  .stocka-mf-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.1rem;
    border-radius: 9999px;
    background: #f1f0fe;
    border: 1.5px solid #e0dcfe;
    color: #5c24ff;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
