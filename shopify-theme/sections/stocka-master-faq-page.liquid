    transition: all 0.2s ease;
    white-space: nowrap;
    font-family: inherit;
  }
  .stocka-mf-cat-btn:hover {
    border-color: #cbd5e1;
    color: #0f172a;
  }
  .stocka-mf-cat-btn.active {
    background: #5c24ff;
    color: #ffffff;
    border-color: #5c24ff;
    box-shadow: 0 4px 12px rgba(92, 36, 255, 0.3);
