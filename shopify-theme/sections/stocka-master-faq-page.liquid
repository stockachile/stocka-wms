<script>
  (function() {
    function initMasterFaq() {
      const items = document.querySelectorAll('#stocka-mf-accordion .stocka-mf-item');
      const catButtons = document.querySelectorAll('#stocka-mf-cats .stocka-mf-cat-btn');
      const searchInput = document.getElementById('stocka-mf-search');
      const noResultsBox = document.getElementById('stocka-mf-no-results');

      let activeCategory = 'all';
      let searchQuery = '';

      // Accordion click toggle
      items.forEach(item => {
        const qBtn = item.querySelector('.stocka-mf-q');
        if (qBtn) {
          qBtn.addEventListener('click', () => {
            const wasActive = item.classList.contains('active');
            // Toggle clicked item
            if (wasActive) {
              item.classList.remove('active');
            } else {
              item.classList.add('active');
            }
          });
        }
      });

      // Category filter buttons
      catButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          catButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeCategory = btn.dataset.cat;
          filterFaqs();
        });
      });

      // Live search input
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.toLowerCase().trim();
          filterFaqs();
        });
      }

      function filterFaqs() {
        let visibleCount = 0;

        items.forEach(item => {
          const itemCats = (item.dataset.cat || '').split(' ');
          const qText = item.querySelector('.stocka-mf-q')?.textContent.toLowerCase() || '';
          const aText = item.querySelector('.stocka-mf-a')?.textContent.toLowerCase() || '';

          const matchesCategory = activeCategory === 'all' || itemCats.includes(activeCategory);
          const matchesSearch = !searchQuery || qText.includes(searchQuery) || aText.includes(searchQuery);

          if (matchesCategory && matchesSearch) {
            item.style.display = 'block';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (noResultsBox) {
          noResultsBox.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMasterFaq);
    } else {
      initMasterFaq();
    }
  })();
</script>

