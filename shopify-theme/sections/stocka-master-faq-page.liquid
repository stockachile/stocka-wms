    border: 1.5px solid #e2e8f0;
    border-radius: 18px;
    overflow: hidden;
    transition: all 0.2s ease;
  }
  .stocka-mf-item:hover {
    border-color: #cbd5e1;
  }
  .stocka-mf-item.active {
    border-color: #5c24ff;
    box-shadow: 0 8px 25px -5px rgba(92, 36, 255, 0.08);
  }

  .stocka-mf-q {
    width: 100%;
    padding: 1.25rem 1.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    text-align: left;
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
    font-family: inherit;
    transition: color 0.2s ease;
  }
  @media (max-width: 640px) {
    .stocka-mf-q {
      padding: 1.1rem 1.25rem;
      font-size: 0.96rem;
    }
  }
  .stocka-mf-item.active .stocka-mf-q {
    color: #5c24ff;
  }

  .stocka-mf-q-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .stocka-mf-cat-tag {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 6px;
    background: #f1f5f9;
    color: #64748b;
    letter-spacing: 0.5px;
    flex-shrink: 0;
  }

  .stocka-mf-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f1f5f9;
    color: #5c24ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 800;
    flex-shrink: 0;
    transition: transform 0.25s ease, background 0.2s ease, color 0.2s ease;
  }
  .stocka-mf-item.active .stocka-mf-icon {
    transform: rotate(45deg);
    background: #5c24ff;
    color: #ffffff;
  }

  .stocka-mf-a {
    padding: 0 1.5rem 1.4rem 1.5rem;
    font-size: 0.93rem;
    color: #475569;
    line-height: 1.65;
    display: none;
    animation: mfFade 0.25s ease;
  }
  @media (max-width: 640px) {
    .stocka-mf-a {
      padding: 0 1.25rem 1.25rem 1.25rem;
      font-size: 0.88rem;
    }
  }
  .stocka-mf-item.active .stocka-mf-a {
    display: block;
  }
  @keyframes mfFade {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* No Results Message */
  .stocka-mf-no-results {
    text-align: center;
    padding: 3.5rem 1.5rem;
    background: #ffffff;
    border: 1.5px dashed #cbd5e1;
    border-radius: 20px;
    display: none;
  }

  /* Bottom Help Cards */
  .stocka-mf-bottom-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
  }
  @media (min-width: 768px) {
    .stocka-mf-bottom-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .stocka-mf-bottom-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 20px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
  }
  .stocka-mf-bottom-card:hover {
    transform: translateY(-3px);
    border-color: #5c24ff;
    box-shadow: 0 12px 30px -8px rgba(15, 23, 42, 0.08);
  }
</style>

