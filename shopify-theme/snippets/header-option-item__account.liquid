{%- comment -%}
  Stocka Header Actions (Search Link + Duo CTA Buttons: Cotizar Online + Acceso WMS)
  Clean, professional styling without emojis.
{%- endcomment -%}
<div class="sf-header-actions-duo inline-flex items-center gap-2 ml-2">
  <!-- Botón de Búsqueda Rápida -->
  <a 
    href="/search" 
    class="inline-flex items-center justify-center text-slate-600 hover:text-[#5c24ff] transition-colors p-2 rounded-full hover:bg-slate-100"
    title="Buscar en Stocka"
    aria-label="Buscar"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
  </a>

  <!-- Botón Principal de Conversión -->
  <a 
    href="/pages/tarifas#stocka-cotizador-anchor" 
    class="sf-header-btn-quote inline-flex items-center justify-center text-white font-bold rounded-full whitespace-nowrap shadow-sm transition-all"
    style="background: #5c24ff; color: #ffffff !important; font-weight: 700; border-radius: 9999px; padding: 7px 18px; font-size: 13px; line-height: 1.2; box-shadow: 0 4px 12px rgba(92, 36, 255, 0.25); text-decoration: none !important;"
  >
    <span>Cotizar Online</span>
    <svg style="margin-left: 6px;" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
  </a>

  <!-- Botón Secundario para Clientes Existentes -->
  <a 
    href="https://wms.stocka.cl/" 
    target="_blank"
    rel="noopener"
    class="sf-header-btn-wms inline-flex items-center justify-center text-white font-bold rounded-full whitespace-nowrap transition-all"
    style="background-color: #0f172a; color: #ffffff !important; font-weight: 700; border-radius: 9999px; padding: 7px 16px; font-size: 12.5px; line-height: 1.2; text-decoration: none !important;"
  >
    <svg style="margin-right: 6px; opacity: 0.85;" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
    <span>Acceso WMS</span>
  </a>
</div>
