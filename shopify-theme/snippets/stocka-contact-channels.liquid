{%- assign cc_bg_color = "#f8fafc" -%}

<style>
  .stocka-cc-section {
    background-color: {{ cc_bg_color }};
    padding: 4rem 1rem;
  }
  @media (min-width: 1024px) {
    .stocka-cc-section {
      padding: 5rem 2rem;
    }
  }

  .stocka-cc-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .stocka-cc-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3.5rem auto;
  }
  .stocka-cc-header-badge {
    display: inline-block;
    background: rgba(92, 36, 255, 0.08);
    color: #5c24ff;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .stocka-cc-title {
    font-size: 2rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  @media (min-width: 768px) {
    .stocka-cc-title {
      font-size: 2.5rem;
    }
  }
  .stocka-cc-desc {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.6;
  }

  .stocka-cc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .stocka-cc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .stocka-cc-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stocka-cc-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 20px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none !important;
    position: relative;
    overflow: hidden;
  }
  .stocka-cc-card:hover {
    border-color: #5c24ff;
    transform: translateY(-5px);
    box-shadow: 0 20px 35px -10px rgba(92, 36, 255, 0.15);
  }

  .stocka-cc-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    transition: transform 0.3s ease;
  }
  .stocka-cc-card:hover .stocka-cc-icon-wrap {
    transform: scale(1.1) rotate(4deg);
  }

  .stocka-cc-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }
  .stocka-cc-card-desc {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .stocka-cc-card-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: #5c24ff;
    transition: gap 0.2s ease;
  }
  .stocka-cc-card:hover .stocka-cc-card-action {
    gap: 0.65rem;
  }
</style>

<section class="stocka-cc-section">
  <div class="stocka-cc-container">
    
    <div class="stocka-cc-header">
      <div class="stocka-cc-header-badge">CANALES DIRECTOS</div>
      <h2 class="stocka-cc-title">¿Prefieres atención personalizada?</h2>
      <p class="stocka-cc-desc">
        Comunícate directamente con nuestro equipo de logística y ventas para resolver tus dudas operativas.
      </p>
    </div>

    <div class="stocka-cc-grid">
      
      <!-- 1. WhatsApp -->
      <a href="https://wa.me/56939247487?text=Hola!%20Me%20gustar%C3%ADa%20cotizar%20los%20servicios%20de%20fulfillment%20de%20Stocka.cl" target="_blank" class="stocka-cc-card">
        <div>
          <div class="stocka-cc-icon-wrap" style="background: #ecfdf5; color: #10b981;">
            <svg viewBox="0 0 24 24" style="width: 26px; height: 26px; fill: currentColor;"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          </div>
          <h3 class="stocka-cc-card-title">WhatsApp Directo</h3>
          <p class="stocka-cc-card-desc">
            Chatea en tiempo real con un asesor comercial para resolver dudas operativas o cotizaciones inmediatas.
          </p>
        </div>
        <div class="stocka-cc-card-action" style="color: #10b981;">
          <span>+56 9 3924 7487</span> ➔
        </div>
      </a>

      <!-- 2. Google Meet -->
      <a href="#stocka-meeting-section" class="stocka-cc-card">
        <div>
          <div class="stocka-cc-icon-wrap" style="background: #f5f3ff; color: #5c24ff;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 26px; height: 26px;"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
          </div>
          <h3 class="stocka-cc-card-title">Reunión Virtual</h3>
          <p class="stocka-cc-card-desc">
            Agenda una videollamada 1 a 1 de 20 a 30 minutos con Felipe Trujillo para evaluar tu operación.
          </p>
        </div>
        <div class="stocka-cc-card-action">
          <span>Elegir horario en calendario</span> ➔
        </div>
      </a>

      <!-- 3. Correo Electrónico -->
      <a href="mailto:contacto@stocka.cl?subject=Consulta%20Servicios%20Fulfillment%20Stocka.cl" class="stocka-cc-card">
        <div>
          <div class="stocka-cc-icon-wrap" style="background: #eff6ff; color: #2563eb;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 26px; height: 26px;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
