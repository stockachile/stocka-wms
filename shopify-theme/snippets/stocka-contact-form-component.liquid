{%- comment -%}
  Stocka Modern Contact Lead Form Component
  Matches the official Contact Page form with Supabase & Brevo integration.
{%- endcomment -%}

<style>
  .stocka-embed-lead-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1.5px solid #e2e8f0;
    box-shadow: 0 15px 35px -10px rgba(15, 23, 42, 0.08);
    padding: 2.25rem 2rem;
    position: relative;
    text-align: left;
    color: #0f172a;
    font-family: inherit;
    max-width: 900px;
    margin: 0 auto;
  }
  @media (max-width: 767px) {
    .stocka-embed-lead-card {
      padding: 1.5rem 1.25rem;
      border-radius: 18px;
    }
  }
  .stocka-embed-input {
    width: 100%;
    padding: 0.85rem 1.1rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    outline: none;
    transition: all 0.2s ease;
    font-size: 0.95rem;
    color: #0f172a;
    background-color: #f8fafc;
    font-family: inherit;
    box-sizing: border-box;
  }
  .stocka-embed-input:focus {
    background-color: #ffffff;
    border-color: #5c24ff;
    box-shadow: 0 0 0 4px rgba(92, 36, 255, 0.12);
  }
  .stocka-embed-label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e293b;
  }
  .stocka-embed-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .stocka-embed-service-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 0.95rem;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    font-size: 0.88rem;
    font-weight: 600;
    color: #334155;
  }
  .stocka-embed-service-pill:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
  }
  .stocka-embed-service-pill.active {
    background: #f5f3ff;
    border-color: #5c24ff;
    color: #5c24ff;
    box-shadow: 0 2px 8px rgba(92, 36, 255, 0.1);
  }
  .stocka-embed-pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.95rem;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    color: #475569;
    transition: all 0.2s ease;
    user-select: none;
  }
  .stocka-embed-pill-btn:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
  }
  .stocka-embed-pill-btn.active {
    background: #5c24ff;
    border-color: #5c24ff;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(92, 36, 255, 0.25);
  }
  .stocka-embed-btn-submit {
    background: linear-gradient(135deg, #5c24ff 0%, #4314c7 100%);
    color: #ffffff !important;
    font-weight: 700;
    font-size: 1.05rem;
    padding: 1.1rem 2.5rem;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    transition: all 0.25s ease;
    box-shadow: 0 10px 25px -5px rgba(92, 36, 255, 0.4);
    width: 100%;
    box-sizing: border-box;
  }
  .stocka-embed-btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px rgba(92, 36, 255, 0.5);
    background: linear-gradient(135deg, #6d3bff 0%, #4d18e0 100%);
  }
  .stocka-embed-btn-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }
  .stocka-embed-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .stocka-embed-grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }
  .stocka-embed-grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .stocka-embed-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @keyframes spin-stocka-embed {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .stocka-embed-spinner {
    width: 20px;
    height: 20px;
    border: 2.5px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin-stocka-embed 0.8s linear infinite;
  }

  /* ========================================================
     PREMIUM SAAS FORM INPUT STYLES
     ======================================================== */
  .stocka-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .stocka-input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: #94a3b8;
    pointer-events: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .stocka-input-icon svg {
    width: 18px;
    height: 18px;
  }
  .stocka-input-wrapper:focus-within .stocka-input-icon {
    color: #5c24ff;
  }
  .stocka-input.with-icon {
    padding-left: 42px;
  }
  .stocka-textarea-wrapper {
    position: relative;
    width: 100%;
  }
  .stocka-textarea-icon {
    position: absolute;
    left: 14px;
    top: 14px;
    width: 18px;
    height: 18px;
    color: #94a3b8;
    pointer-events: none;
    transition: color 0.2s ease;
  }
  .stocka-textarea-wrapper:focus-within .stocka-textarea-icon {
    color: #5c24ff;
  }
  .stocka-textarea.with-icon {
    padding-left: 42px;
    padding-top: 12px;
  }
  .stocka-step-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.98rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.85rem;
    font-family: inherit;
  }
  .stocka-step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: linear-gradient(135deg, #5c24ff 0%, #4338ca 100%);
    color: #ffffff;
    border-radius: 7px;
    font-size: 0.78rem;
    font-weight: 800;
  }
  .stocka-input {
    width: 100%;
    padding: 0.85rem 1.1rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    outline: none;
    transition: all 0.2s ease;
    font-size: 0.95rem;
    color: #0f172a;
    background-color: #f8fafc;
    font-family: inherit;
    box-sizing: border-box;
  }
  .stocka-input:hover {
    border-color: #cbd5e1;
    background-color: #ffffff;
  }
  .stocka-input:focus {
    background-color: #ffffff;
    border-color: #5c24ff;
    box-shadow: 0 0 0 4px rgba(92, 36, 255, 0.12);
  }

</style>

<div class="stocka-embed-lead-card">
  
  <!-- Form Container -->
