          <span>Envíos Todo Chile</span>
        </div>
        <div class="stocka-embed-service-pill" data-value="Logística Inversa">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px; flex-shrink: 0;"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
          <span>Logística Inversa</span>
        </div>
        <div class="stocka-embed-service-pill" data-value="Vitrinas en Sucursal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px; flex-shrink: 0;"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <span>Vitrinas en Sucursal</span>
        </div>
      </div>
    </div>

    <!-- 2 & 3. Estimación Operativa -->
    <div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem; margin-bottom: 1.75rem; padding: 1.25rem; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 16px;">
      
      <div>
        <label class="stocka-embed-label">2. Cantidad de ventas mensuales (pedidos) <span style="color: #ef4444;">*</span></label>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem;" id="home-volume-group">
          <div class="stocka-embed-pill-btn active" data-value="0 - 100 pedidos">0 - 100</div>
          <div class="stocka-embed-pill-btn" data-value="100 - 500 pedidos">100 - 500</div>
          <div class="stocka-embed-pill-btn" data-value="500 - 1.000 pedidos">500 - 1.000</div>
          <div class="stocka-embed-pill-btn" data-value="Más de 1.000 pedidos">1.000+</div>
        </div>
      </div>

      <div>
        <label class="stocka-embed-label">3. Espacio estimado de almacenamiento</label>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem;" id="home-storage-group">
          <div class="stocka-embed-pill-btn active" data-value="No lo sé aún">No lo sé aún</div>
          <div class="stocka-embed-pill-btn" data-value="Menos de 1 m3">&lt; 1 m³</div>
          <div class="stocka-embed-pill-btn" data-value="1 - 4 m3">1 - 4 m³</div>
          <div class="stocka-embed-pill-btn" data-value="5 - 10 m3">5 - 10 m³</div>
          <div class="stocka-embed-pill-btn" data-value="Más de 10 m3">10+ m³</div>
        </div>
      </div>

    </div>

    <!-- 4. Datos de Contacto -->
    <div style="margin-bottom: 1.5rem; margin-top: 1.75rem;">
      <div class="stocka-step-badge">
        <span class="stocka-step-num">4</span>
        <span>Tus datos de contacto y de tu tienda</span>
      </div>
      
