            </div>
            <input type="tel" id="home-lead-phone" class="stocka-input with-icon" placeholder="+56 9 8765 4321" required>
          </div>
        </div>
        <div>
          <label for="home-lead-company" class="stocka-embed-label">Nombre de tu Tienda <span style="color: #ef4444;">*</span></label>
          <div class="stocka-input-wrapper">
            <div class="stocka-input-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            </div>
            <input type="text" id="home-lead-company" class="stocka-input with-icon" placeholder="Ej: Stocka Store" required>
