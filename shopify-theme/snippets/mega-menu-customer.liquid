{%- comment -%}
  Acceso WMS Button and Switchers for mobile navigation drawer.
{%- endcomment -%}
<div class="mega-menu-customer mt-8 p-4 block xl:hidden">
    <a href="https://wms.stocka.cl/" class="w-full text-center inline-flex items-center justify-center bg-black text-white hover:bg-opacity-85 transition-all font-bold rounded-full whitespace-nowrap" style="background-color: #000000; color: #ffffff; font-weight: 700; border-radius: 9999px; padding: 12px 24px; font-size: 14px; line-height: 1; margin-bottom: 2rem;">
        Acceso WMS
    </a>

    {% if section.settings.show_language_switcher or section.settings.show_currency_switcher %}
    <div class="flex mt-4">
        {% if section.settings.show_language_switcher %}
          {% render 'language-switcher', box_size: 'block xl:hidden py-3.5', pos: 'top' %}
        {% endif %}
        {% if section.settings.show_currency_switcher %}
          {% render 'currency-switcher', box_size: 'block xl:hidden py-3.5', pos: 'top' %}
        {% endif %}
    </div>
    {% endif %}
</div>
