{%- if template.name == 'page' and page.handle == 'tarifas' or template.name == 'page' and page.handle == 'contacto' or template.name == 'page' and page.handle == 'soporte' or template.name == 'page' and page.handle == 'support' or request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué incluye el servicio de Fulfillment de Stocka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Stocka se encarga de todo el proceso operativo: recibimos tu mercadería, la almacenamos en nuestras bodegas de La Reina, Recoleta y Ñuñoa, sincronizamos tu tienda online (Shopify, Mercado Libre, WooCommerce), preparamos cada paquete (Pick & Pack) y lo despachamos el mismo día en Santiago o a regiones vía couriers integrados."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo se calculan las tarifas de Fulfillment en Stocka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestras tarifas son 100% transparentes y dinámicas según volumen: el armado (Pick & Pack) va desde $850 por pedido en tramo Enterprise, el almacenamiento desde $26.500 por m³ al mes, y los despachos Same Day en Santiago a tarifa plana de $3.200 + IVA."
      }
    },
    {
      "@type": "Question",
      "name": "¿Stocka es compatible con Mercado Libre Flex y Shopify?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, contamos con sincronización automática para procesar y despachar pedidos Flex el mismo día cumpliendo con las métricas de reputación verde de Mercado Libre, además de integración directa con Shopify, Falabella, Ripley y más."
      }
    },
    {
      "@type": "Question",
      "name": "¿Dónde está ubicada la bodega y punto de retiros de Stocka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestra oficina y casa matriz está ubicada en Av. Campos de Deportes 405, Ñuñoa (punto de retiro presencial), y contamos con centros de distribución de mayor capacidad en La Reina y Recoleta."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuáles son los tiempos de entrega para envíos a regiones?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trabajamos con Starken, Blue Express, Chilexpress y CorreosChile con tiempos de tránsito promedio de 24 a 48 horas hábiles en ciudades principales de la zona central y sur, y tarifas preferenciales por volumen corporativo."
      }
    }
  ]
}
