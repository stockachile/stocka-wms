{%- if template.name == 'page' and page.handle == 'tarifas' or template.name == 'page' and page.handle == 'preguntas-frecuentes' or template.name == 'page' and page.handle == 'faqs' or request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué incluye el servicio de Fulfillment 360 de Stocka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Stocka se encarga de todo el flujo operativo: recepción de stock, almacenamiento en custodia segura en La Reina, Recoleta y Ñuñoa con CCTV 24/7, sincronización de tiendas online, armado de pedidos (Pick & Pack) y despachos Same Day en Santiago o a regiones vía couriers integrados."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo se calculan las tarifas de Fulfillment en Stocka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestras tarifas son 100% transparentes y dinámicas: Pick & Pack desde $850 por paquete en tramo Enterprise, almacenamiento por volumen dinámico on demand desde $26.500 por m³ al mes y despachos Same Day en Santiago a tarifa plana de $3.200 + IVA."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuáles son los horarios de corte para despachos Same Day en Santiago?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El horario de corte es a las 12:00 hrs. Las compras ingresadas antes de ese horario se entregan de lunes a sábado entre las 12:00 y las 21:00 hrs en 36 comunas de la Región Metropolitana."
      }
    },
    {
      "@type": "Question",
      "name": "¿Dónde están ubicadas las bodegas y punto de retiro de Stocka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestra oficina y casa matriz está ubicada en Av. Campos de Deportes 405, Ñuñoa (con punto de retiro presencial gratis para clientes), y contamos con centros de distribución de mayor capacidad estratégica en La Reina y Recoleta."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto demora el proceso de onboarding para empezar a operar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El onboarding es ultra rápido y guiado paso a paso: en solo horas tu cuenta e integraciones con Shopify, Mercado Libre o WooCommerce pueden estar 100% listas y configuradas para despachar."
      }
    }
  ]
}
</script>
{%- endif -%}
