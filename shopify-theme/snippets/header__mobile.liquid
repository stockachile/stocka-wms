{% assign show_cart_icon = section.settings.show_cart_icon %}

<header
    class="flex lg:hidden sf-header__mobile container-fluid items-center justify-between"
    data-screen="sf-header__mobile"
    data-transparent="{{ transparent_on_top }}"
    style="background: rgba(255, 255, 255, 0.95) !important; backdrop-filter: blur(12px) !important; -webkit-backdrop-filter: blur(12px) !important; border-bottom: 1px solid rgba(226, 232, 240, 0.8) !important; padding-top: 10px; padding-bottom: 10px;"
>
    {% render 'header-option-item__hamburger-button', box_size: 'flex w-1/4 items-center justify-start' %}
    
    <div class="flex-1 flex items-center justify-center">
      {% render 'header-logo-mobile', header_settings: section.settings, box_size: 'w-auto' %}
    </div>
    
    <div class="w-1/4 flex items-center justify-end sf-header__mobile-right">
        <!-- Fast Cotizar Button -->
        <a 
          href="/pages/tarifas#stocka-cotizador-anchor" 
          class="inline-flex items-center justify-center font-bold text-white shadow-sm whitespace-nowrap"
          style="background: linear-gradient(135deg, #5c24ff 0%, #4338ca 100%); color: #ffffff !important; border-radius: 9999px; padding: 7px 14px; font-size: 12px; line-height: 1.2; text-decoration: none !important;"
        >
          Cotizar 🚀
        </a>
    </div>
</header>
