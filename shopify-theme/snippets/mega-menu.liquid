<style>
  .stocka-mb-drawer-root {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  .stocka-mb-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    background: #0f172a;
    border-bottom: 1px solid #1e293b;
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .stocka-mb-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .stocka-mb-logo-img {
    height: 26px;
    width: auto;
    display: block;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.3));
  }
  .stocka-mb-brand-tag {
    font-size: 0.65rem;
    font-weight: 700;
    color: #c4b5fd;
    background: rgba(139, 92, 246, 0.2);
    border: 1px solid rgba(139, 92, 246, 0.3);
    padding: 2px 8px;
    border-radius: 6px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .stocka-mb-close-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .stocka-mb-close-btn:hover, .stocka-mb-close-btn:active {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Quick Actions Cards */
  .stocka-mb-actions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    padding: 1rem 1.25rem 0.5rem 1.25rem;
  }
  .stocka-mb-action-card {
    border-radius: 12px;
    padding: 0.85rem 0.95rem;
    text-decoration: none !important;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 86px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .stocka-mb-action-card:active {
    transform: scale(0.98);
  }
  .stocka-mb-card-wms {
    background: #0f172a;
    color: #ffffff !important;
    border: 1px solid #1e293b;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
  }
  .stocka-mb-card-cotizador {
    background: #5c24ff;
    color: #ffffff !important;
    border: 1px solid #4a15e6;
    box-shadow: 0 4px 12px rgba(92, 36, 255, 0.25);
  }
  .stocka-mb-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }
  .stocka-mb-card-icon-wrap {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }
  .stocka-mb-card-badge {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .stocka-mb-card-badge-wms {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
  }
  .stocka-mb-card-badge-cotizador {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }
  .stocka-mb-card-title {
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .stocka-mb-card-sub {
    font-size: 0.7rem;
    opacity: 0.8;
    margin-top: 2px;
  }

  /* Navigation Links List */
  .stocka-mb-nav-section {
    padding: 0.75rem 0.5rem 0.5rem 0.5rem;
  }
  .stocka-mb-nav-title {
    padding: 0.5rem 0.85rem 0.35rem 0.85rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #94a3b8;
  }
  .stocka-mb-item {
    border-radius: 10px;
    margin-bottom: 2px;
    transition: background 0.15s ease;
  }
  .stocka-mb-item:hover, .stocka-mb-item:active {
    background: #f8fafc;
  }
  .stocka-mb-anchor {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.85rem;
    text-decoration: none !important;
    color: #1e293b;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .stocka-mb-anchor-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .stocka-mb-item-icon-box {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #f1f5f9;
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }
  .stocka-mb-item:hover .stocka-mb-item-icon-box {
    background: #e0e7ff;
    color: #5c24ff;
  }
  .stocka-mb-item-text {
    display: flex;
    flex-direction: column;
  }
  .stocka-mb-item-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: #0f172a;
    line-height: 1.25;
  }
  .stocka-mb-item-sub {
    font-size: 0.72rem;
    color: #64748b;
    font-weight: 400;
    margin-top: 1px;
  }
  .stocka-mb-item-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  /* Contact & Support Section */
  .stocka-mb-contact-block {
    margin: 1rem 1.25rem 0.75rem 1.25rem;
    padding: 1.15rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .stocka-mb-contact-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #475569;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .stocka-mb-btn-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #10b981;
    color: #ffffff !important;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none !important;
    transition: background 0.15s ease;
  }
  .stocka-mb-btn-wa:hover {
    background: #059669;
  }
  .stocka-mb-btn-meet {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #ffffff;
    color: #5c24ff !important;
    border: 1.5px solid #5c24ff;
    padding: 0.7rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none !important;
    transition: background 0.15s ease;
  }
  .stocka-mb-btn-meet:hover {
    background: #f5f3ff;
  }

  /* Drawer Footer Status */
  .stocka-mb-footer {
    padding: 1rem 1.25rem 2rem 1.25rem;
    text-align: center;
    border-top: 1px solid #f1f5f9;
    background: #ffffff;
  }
  .stocka-mb-live-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #059669;
    background: #ecfdf5;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    border: 1px solid #d1fae5;
    margin-bottom: 0.5rem;
  }
  .stocka-mb-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: mbPulse 2s infinite;
  }
  @keyframes mbPulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 5px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .stocka-mb-footer-text {
    font-size: 0.72rem;
    color: #94a3b8;
    line-height: 1.45;
  }
</style>

