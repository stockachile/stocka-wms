{% assign menu = mobile_menu %}
{% if mobile_menu == blank %}
  {% assign menu = main_menu %}
{% endif %}

<style>
  .stocka-mb-drawer-root {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  
  .stocka-mb-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    background: #0f172a;
    border-bottom: 1px solid #1e293b;
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .stocka-mb-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .stocka-mb-logo-img {
    height: 26px;
    width: auto;
    display: block;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.3));
  }
  .stocka-mb-brand-tag {
    font-size: 0.65rem;
    font-weight: 700;
    color: #c4b5fd;
    background: rgba(139, 92, 246, 0.2);
    border: 1px solid rgba(139, 92, 246, 0.3);
    padding: 2px 8px;
    border-radius: 6px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .stocka-mb-close-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .stocka-mb-close-btn:hover, .stocka-mb-close-btn:active {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Quick Actions Cards */
  .stocka-mb-actions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    padding: 1rem 1.25rem 0.5rem 1.25rem;
  }
  .stocka-mb-action-card {
    border-radius: 12px;
    padding: 0.85rem 0.95rem;
    text-decoration: none !important;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 86px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .stocka-mb-action-card:active {
    transform: scale(0.98);
  }
  .stocka-mb-card-wms {
    background: #0f172a;
    color: #ffffff !important;
    border: 1px solid #1e293b;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
  }
  .stocka-mb-card-cotizador {
    background: #5c24ff;
    color: #ffffff !important;
    border: 1px solid #4a15e6;
    box-shadow: 0 4px 12px rgba(92, 36, 255, 0.25);
  }
  .stocka-mb-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }
  .stocka-mb-card-icon-wrap {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }
  .stocka-mb-card-badge {
    font-size: 0.62rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .stocka-mb-card-badge-wms {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
  }
  .stocka-mb-card-badge-cotizador {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }
  .stocka-mb-card-title {
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .stocka-mb-card-sub {
    font-size: 0.7rem;
    opacity: 0.8;
    margin-top: 2px;
  }

  /* Navigation Links List */
  .stocka-mb-nav-section {
    padding: 0.75rem 0.5rem 0.5rem 0.5rem;
  }
  .stocka-mb-nav-title {
    padding: 0.5rem 0.85rem 0.35rem 0.85rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #94a3b8;
  }
  .stocka-mb-item {
    border-radius: 10px;
    margin-bottom: 2px;
    transition: background 0.15s ease;
  }
  .stocka-mb-item:hover, .stocka-mb-item:active {
    background: #f8fafc;
  }
  .stocka-mb-anchor {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.85rem;
    text-decoration: none !important;
    color: #1e293b;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .stocka-mb-anchor-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .stocka-mb-item-icon-box {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #f1f5f9;
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }
  .stocka-mb-item:hover .stocka-mb-item-icon-box {
    background: #e0e7ff;
    color: #5c24ff;
  }
  .stocka-mb-item-text {
    display: flex;
    flex-direction: column;
  }
  .stocka-mb-item-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: #0f172a;
    line-height: 1.25;
  }
  .stocka-mb-item-sub {
    font-size: 0.72rem;
    color: #64748b;
    font-weight: 400;
    margin-top: 1px;
  }
  .stocka-mb-item-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  /* Contact & Support Section */
  .stocka-mb-contact-block {
    margin: 1rem 1.25rem 0.75rem 1.25rem;
    padding: 1.15rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .stocka-mb-contact-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #475569;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .stocka-mb-btn-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #10b981;
    color: #ffffff !important;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none !important;
    transition: background 0.15s ease;
  }
  .stocka-mb-btn-wa:hover {
    background: #059669;
  }
  .stocka-mb-btn-meet {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #ffffff;
    color: #5c24ff !important;
    border: 1.5px solid #5c24ff;
    padding: 0.7rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none !important;
    transition: background 0.15s ease;
  }
  .stocka-mb-btn-meet:hover {
    background: #f5f3ff;
  }

  /* Drawer Footer Status */
  .stocka-mb-footer {
    padding: 1rem 1.25rem 2rem 1.25rem;
    text-align: center;
    border-top: 1px solid #f1f5f9;
    background: #ffffff;
  }
  .stocka-mb-live-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #059669;
    background: #ecfdf5;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    border: 1px solid #d1fae5;
    margin-bottom: 0.5rem;
  }
  .stocka-mb-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: mbPulse 2s infinite;
  }
  @keyframes mbPulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 5px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .stocka-mb-footer-text {
    font-size: 0.72rem;
    color: #94a3b8;
    line-height: 1.45;
  }
</style>

<div
    style="--tw-bg-opacity: 0;"
    class="sf-menu-wrapper sf-menu-wrapper-mobile touch-none hidden fixed z-[80] inset-0 transition-colors duration-300 bg-black"
>
    <div class="sf-menu__content stocka-mb-drawer-root overscroll-contain transition-transform -translate-x-full duration-300 md:w-[400px] w-[88vw] max-w-[400px] z-50 bg-white text-black overflow-x-hidden h-full overflow-y-scroll flex flex-col justify-between">
        
        <div>
            <!-- Header Superior del Drawer -->
            <div class="stocka-mb-topbar">
                <div class="stocka-mb-brand">
                    <img src="https://cdn.shopify.com/s/files/1/0625/6141/9483/files/Stocka_1300_x_500_px_519_x_200_px_5.png?v=1779650350" alt="Stocka" class="stocka-mb-logo-img">
                    <span class="stocka-mb-brand-tag">360°</span>
                </div>
                <button type="button" class="stocka-mb-close-btn" onclick="document.querySelector('.sf-menu-wrapper-mobile').click();" aria-label="Cerrar menú">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <!-- Accesos Rápidos Destacados (WMS + Cotizador) -->
            <div class="stocka-mb-actions-grid">
                <a href="https://wms.stocka.cl/" target="_blank" class="stocka-mb-action-card stocka-mb-card-wms">
                    <div>
                        <div class="stocka-mb-card-header">
                            <div class="stocka-mb-card-icon-wrap">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                            </div>
                            <span class="stocka-mb-card-badge stocka-mb-card-badge-wms">Portal</span>
                        </div>
                        <div class="stocka-mb-card-title">Acceso WMS</div>
                    </div>
                    <div class="stocka-mb-card-sub">Ingresar al sistema &rarr;</div>
                </a>

                <a href="/pages/cotizaserviciofulfillment" class="stocka-mb-action-card stocka-mb-card-cotizador">
                    <div>
                        <div class="stocka-mb-card-header">
                            <div class="stocka-mb-card-icon-wrap">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
                            </div>
                            <span class="stocka-mb-card-badge stocka-mb-card-badge-cotizador">En Vivo</span>
                        </div>
                        <div class="stocka-mb-card-title">Cotizador</div>
                    </div>
                    <div class="stocka-mb-card-sub">Simular tarifas online &rarr;</div>
                </a>
            </div>

            <!-- Navegación Principal -->
            <div class="stocka-mb-nav-section">
                <div class="stocka-mb-nav-title">Navegación</div>
                
                <div class="w-full sf-menu-links">
                  {% for link in linklists[menu].links %}
                    {% assign mb_link_url = link.url %}
                    {% if mb_link_url contains 'freshdesk' or link.title == 'Soporte' or link.title == 'Ayuda' %}
                      {% assign mb_link_url = '/pages/soporte' %}
                    {% endif %}
                    {% assign link_title_lower = link.title | downcase %}
                    {% assign link_url_lower = link.url | downcase %}

                    {% assign item_type = "default" %}
                    {% assign item_badge = "" %}
                    {% assign item_sub = "" %}

                    {% if link_title_lower contains 'fulfillment' or link_url_lower contains 'fulfillment' %}
                      {% assign item_type = "fulfillment" %}
                      {% assign item_sub = "Bodegaje, Pick & Pack e Inventario" %}
                      {% assign item_badge = "360°" %}
                    {% elsif link_title_lower contains 'cotiz' or link_url_lower contains 'cotiz' or link_title_lower contains 'calcul' %}
                      {% assign item_type = "calculator" %}
                      {% assign item_sub = "Calcula tus costos en tiempo real" %}
                      {% assign item_badge = "Simulador" %}
                    {% elsif link_title_lower contains 'despacho' or link_title_lower contains 'envio' or link_title_lower contains 'same' %}
                      {% assign item_type = "shipping" %}
                      {% assign item_sub = "Entregas Same Day y Todo Chile" %}
                      {% assign item_badge = "Same Day" %}
                    {% elsif link_title_lower contains 'contacto' or link_url_lower contains 'contact' %}
                      {% assign item_type = "contact" %}
                      {% assign item_sub = "Asesoría comercial 1 a 1" %}
                      {% assign item_badge = "Directo" %}
                    {% elsif link_title_lower contains 'nosotros' or link_title_lower contains 'empresa' %}
                      {% assign item_type = "company" %}
                      {% assign item_sub = "Conoce nuestro equipo y propuesta" %}
                    {% elsif link_title_lower contains 'soporte' or link_title_lower contains 'ayuda' or link_url_lower contains 'freshdesk' or link_url_lower contains 'soporte' or link_url_lower contains 'support' %}
                      {% assign item_type = "support" %}
                      {% assign item_sub = "Seguimiento y centro de ayuda" %}
                      {% assign item_badge = "Portal" %}
                    {% elsif link_title_lower contains 'blog' or link_title_lower contains 'noticia' %}
                      {% assign item_type = "blog" %}
                      {% assign item_sub = "Novedades y guías ecommerce" %}
                    {% endif %}

                    {% if link.links != blank %}
                        <li class="list-none sf-link stocka-mb-item flex items-center" data-url="{{ link.url }}">
                            <a href="{{ mb_link_url }}" class="w-full stocka-mb-anchor relative">
                                <div class="stocka-mb-anchor-left">
                                    <div class="stocka-mb-item-icon-box">
                                        {% if item_type == "fulfillment" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                                        {% elsif item_type == "calculator" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
                                        {% elsif item_type == "shipping" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                                        {% elsif item_type == "contact" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                        {% elsif item_type == "company" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><path d="M8 6h.01"></path><path d="M16 6h.01"></path><path d="M12 6h.01"></path><path d="M12 10h.01"></path><path d="M12 14h.01"></path><path d="M16 10h.01"></path><path d="M16 14h.01"></path><path d="M8 10h.01"></path><path d="M8 14h.01"></path></svg>
                                        {% elsif item_type == "support" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                                        {% elsif item_type == "blog" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                                        {% else %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                                        {% endif %}
                                    </div>
                                    <div class="stocka-mb-item-text">
                                        <span class="stocka-mb-item-title">{{ link.title }}</span>
                                        {% if item_sub != "" %}<span class="stocka-mb-item-sub">{{ item_sub }}</span>{% endif %}
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 0.4rem;">
                                    {% if item_badge != "" %}
                                      <span class="stocka-mb-item-badge" style="background: #f3f0ff; color: #5c24ff;">{{ item_badge }}</span>
                                    {% endif %}
                                    <span class="sf__toggle-submenu-mb flex items-center justify-center text-slate-400">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                    </span>
                                </div>
                            </a>
                            <div class="sf-sub-links hidden absolute inset-y-0 bg-white flex-col left-full w-full">
                                <div class="h-full overflow-y-scroll overscroll-contain">
                                    <button class="back p-4 font-medium flex items-center text-slate-700">
                                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                                      <span class="ml-3 font-semibold text-sm">Volver</span>
                                    </button>
                                    <ul class="pb-4">
                                      {% render 'mega-menu-link' for link.links as link %}
                                    </ul>
                                </div>
                            </div>
                        </li>
                    {% else %}
                        <li class="list-none stocka-mb-item">
                            <a href="{{ mb_link_url }}" class="stocka-mb-anchor">
                                <div class="stocka-mb-anchor-left">
                                    <div class="stocka-mb-item-icon-box">
                                        {% if item_type == "fulfillment" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                                        {% elsif item_type == "calculator" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
                                        {% elsif item_type == "shipping" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                                        {% elsif item_type == "contact" %}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                        {% elsif item_type == "company" %}
