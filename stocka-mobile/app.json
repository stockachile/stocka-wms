{
  "expo": {
    "name": "Stocka WMS",
    "slug": "stocka-wms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0b0f19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.stocka.wms.client",
      "infoPlist": {
        "NSCameraUsageDescription": "Stocka WMS necesita acceso a la cámara para escanear códigos de barra de productos y adjuntar fotografías en reportes de incidencias."
      }
    },
    "android": {
      "package": "cl.stocka.wms.client",
      "adaptiveIcon": {
        "backgroundColor": "#0b0f19",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
